//! Generated by Ruscal from `real_division.pas`. Do not edit by hand.
//! Pascal: `program RealDivision;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Real division by zero stops with runtime error 200, as in TP (Rust's
// would give infinity). A divisor that's a constant other than 0 needs no
// check.

const TWO: f64 = 2.0;

/// The main program: the `begin ... end.` block of `RealDivision`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut x: f64 = 0.0;
    let mut y: f64 = 0.0;
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    x = 3.0;
    y = 2.0;
    i = 7;
    j = 0;
    // `nonzero(y)` stops with runtime error 200 if `y` is 0, as Turbo Pascal's
    // `/` does (Rust's would give infinity).
    pwriteln!(
        wd(x / nonzero(y), 0, 2),
        " ",
        wd(x / 2.0, 0, 2),
        " ",
        wd(x / TWO, 0, 2),
        " ",
        wd(f64::from(i) / 2.0, 0, 2),
        " ",
        wd(-x / f64::from(-4), 0, 2)
    );
    y = 0.0;
    pwriteln!(wd(x / nonzero(y), 0, 2));
    pwriteln!("not reached");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
