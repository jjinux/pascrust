//! Generated by Ruscal from `goto_labels_fields.pas`. Do not edit by hand.
//! Pascal: `program GotoLabelsAndFields;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Two labels on one statement (`L1: L2:`), a labeled `begin ... end`
// that jumps back to itself (a main loop), and a procedural field called
// with arguments inside its object's method.

/// Pascal: `procedure(x: Integer)`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type TProc = ProcVar<fn(i16)>;

/// Pascal: `object Show: TProc; n: Integer; procedure Run; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCounter {
    show: TProc,
    n: i16,
}

/// Pascal: `procedure Print(x: Integer);`
fn print(x: i16) {
    pwriteln!("show ", x);
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl TCounter {
    /// Pascal: `procedure TCounter.Run;`
    fn run_(&mut self) {
        self.show.get()(self.n + 1);
    }
}

/// The main program: the `begin ... end.` block of `GotoLabelsAndFields`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut n: i16 = 0;
    let mut c: TCounter = TCounter::default();
    n = 0;
    // `goto L2` jumps forward: Rust can't jump, but it can leave a block
    // early, so the statements it skips are in the block `'l2`, and the
    // jump is `break 'l2`.
    'l2: {
        if n == 0 {
            break 'l2;
        }
        pwriteln!("skipped");
    }
    // `goto L1` jumps back: the statements from the label on are a loop,
    // and the jump is `continue 'l1`. Otherwise the loop runs once.
    'l1: loop {
        pwriteln!("here ", n);
        n += 1;
        if n < 2 {
            continue 'l1;
        }
        break 'l1;
    }
    n = 0;
    'main_: loop {
        n += 1;
        pwriteln!(n);
        if n == 3 {
            c.show = TProc::of(print, "Print");
            c.n = 41;
            c.run_();
            halt(0);
        }
        continue 'main_;
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
