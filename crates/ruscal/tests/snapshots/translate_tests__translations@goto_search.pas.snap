//! Generated by Ruscal from `goto_search.pas`. Do not edit by hand.
//! Pascal: `program GotoSearch;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Look for a number in a grid, leaving both loops at once with a goto
// forward, and go back to try a smaller one with a goto back.
const SIZE: i16 = 4;

/// The main program: the `begin ... end.` block of `GotoSearch`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut grid: PArray<PArray<i16, 1, { SIZE as usize }>, 1, { SIZE as usize }> = PArray::default();
    let mut row: i16 = 0;
    let mut col: i16 = 0;
    let mut target: i16 = 0;
    let mut tries: i16 = 0;
    // `row` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for row_value in 1..=SIZE {
        row = row_value;
        for col_value in 1..=SIZE {
            col = col_value;
            grid[row][col] = row * 10 + col;
        }
    }
    target = 64;
    tries = 0;
    // `goto Found` jumps forward: Rust can't jump, but it can leave a block
    // early, so the statements it skips are in the block `'found`, and the
    // jump is `break 'found`.
    'found: {
        // `goto Again` jumps back: the statements from the label on are a loop,
        // and the jump is `continue 'again`. Otherwise the loop runs once.
        'again: loop {
            tries += 1;
            for row_value in 1..=SIZE {
                row = row_value;
                for col_value in 1..=SIZE {
                    col = col_value;
                    if grid[row][col] == target {
                        break 'found;
                    }
                }
            }
            pwriteln!(target, " is not in the grid");
            target -= 10;
            if tries < 3 {
                continue 'again;
            }
            break 'again;
        }
        pwriteln!("gave up");
        return;
    }
    pwriteln!("found ", target, " at ", row, ",", col, " after ", tries, " tries");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
