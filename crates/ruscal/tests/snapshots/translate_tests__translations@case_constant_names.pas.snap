//! Generated by Ruscal from `case_constant_names.pas`. Do not edit by hand.
//! Pascal: `program Case1;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A case label that names a constant keeps the name (ESC =>), so the
// Rust says where the value comes from; a Byte compared with Integer
// constants is widened for it. Expected output by hand: Free Pascal
// rejects the repeated label K, which TP allows (the first one wins).

const K: i16 = 5;
const L: i16 = 9;
const ESC: u8 = b'\x1b';
const ENTER: u8 = b'\r';
const BIG: i16 = 1000;
const LAST: Day = Day::Sun;

/// Pascal: `(Mon, Tue, Wed, Thu, Fri, Sat, Sun)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Day {
    #[default]
    Mon,
    Tue,
    Wed,
    Thu,
    Fri,
    Sat,
    Sun,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Day {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Day {
    const VALUES: &'static [Self] = &[Day::Mon, Day::Tue, Day::Wed, Day::Thu, Day::Fri, Day::Sat, Day::Sun];
}

/// The main program: the `begin ... end.` block of `Case1`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut b: u8 = 0;
    let mut c: u8 = 0;
    let mut d: Day = Day::Mon;
    let mut n: i32 = 0;
    i = 9;
    b = 5;
    c = b'\x1b';
    d = Day::Sun;
    n = 1000;
    match i {
        1 => {
            pwriteln!("one");
        }
        K => {
            pwriteln!("K");
        }
        6..=L => {
            pwriteln!("6..L");
        }
        value if value == K + 10 => {
            pwriteln!("K + 10");
        }
        _ => {}
    }
    match i16::from(b) {
        K => {
            pwriteln!("b K");
        }
        7..=L => {
            pwriteln!("b 7..L");
        }
        _ => {}
    }
    match c {
        ESC => {
            pwriteln!("Esc");
        }
        ENTER | b'a'..=b'z' => {
            pwriteln!("Enter or letter");
        }
        _ => {}
    }
    match d {
        Day::Mon | Day::Tue | Day::Wed | Day::Thu | Day::Fri => {
            pwriteln!("weekday");
        }
        Day::Sun => {
            pwriteln!("last");
        }
        _ => {}
    }
    match n {
        value if value == i32::from(BIG) => {
            pwriteln!("Big");
        }
        value if value == i32::from(K) => {
            pwriteln!("n K");
        }
        _ => {}
    }
    match i {
        1..=L => {
            pwriteln!("1..L");
        }
        // 5 appeared before; the first one wins.
        _ => {}
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
