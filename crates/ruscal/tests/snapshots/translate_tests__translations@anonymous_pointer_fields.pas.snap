/// The main program: the `begin ... end.` block of `AnonymousPointerFields`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: Slots = Slots::default();
    let mut e: Either = Either::default();
    let mut p: Ptr<Node> = Ptr::nil();
    s[1] = Ptr::alloc();
    s[1].get_mut().value = 7;
    s[1].get_mut().next = Ptr::alloc();
    s[1].get().next.get_mut().value = 8;
    s[1].get().next.get_mut().next = Ptr::nil();
