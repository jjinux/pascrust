//! Generated by Ruscal from `goto_loop_exits.pas`. Do not edit by hand.
//! Pascal: `program GotoLoopExits;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Break and Continue inside the statements a goto skips or repeats, for
// a for, while or repeat loop around them: the loop gets a label.

/// The main program: the `begin ... end.` block of `GotoLoopExits`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    let mut found: i16 = 0;
    found = 0;
    // A plain `break` can't leave a labeled block, so this loop has a label,
    // and its `Break` and `Continue` inside the goto block below use it.
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    'for_loop: for i_value in 1..=5 {
        i = i_value;
        // `goto Next` jumps forward: Rust can't jump, but it can leave a block
        // early, so the statements it skips are in the block `'next`, and the
        // jump is `break 'next`.
        'next: {
            if i == 2 {
                break 'next;
            }
            if i == 4 {
                break 'for_loop;
            }
            found += i;
        }
    }
    pwriteln!("for ", found, " ", i);
    i = 0;
    'while_loop: while i < 10 {
        i += 1;
        'next2: {
            if i % 2 != 0 {
                break 'next2;
            }
            if i == 6 {
                continue 'while_loop;
            }
            pwriteln!("even ", i);
            if i == 8 {
                break 'while_loop;
            }
        }
    }
    j = 0;
    // Pascal `repeat ... until`: the body always runs at least once.
    'repeat_loop: loop {
        j += 1;
        // `goto Again` jumps back: the statements from the label on are a loop,
        // and the jump is `continue 'again`. Otherwise the loop runs once.
        'again: loop {
            if j == 3 {
                break 'repeat_loop;
            }
            if j < 2 {
                j += 1;
                continue 'again;
            }
            break 'again;
        }
        if j > 10 {
            break;
        }
    }
    pwriteln!("repeat ", j);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
