// ===== src/main.rs =====
//! Generated by Ruscal from `rust_shared.pas`. Do not edit by hand.
//! Pascal: `program RustShared;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

// Each Pascal unit becomes a Rust module.
mod link_a;
mod link_b;

// The Rust files the program links with `{$L file.rs}`: its `external`
// routines are there.
mod shared;

#[allow(unused_imports)]
use crate::link_a::*;
#[allow(unused_imports)]
use crate::link_b::*;
use ruscal_runtime::prelude::*;

// Two units that link the same Rust file (shared.rs): it's one module.
// Output written by hand: Free Pascal can't link Rust.

/// The main program: the `begin ... end.` block of `RustShared`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    pwriteln!(shared::name_a(), " ", shared::name_b());
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}

// ===== src/link_a.rs =====
//! Generated by Ruscal from `linka.pas`. Do not edit by hand.
//! Pascal: `unit LinkA;`

#[allow(unused_imports)]
use crate::link_b::*;
#[allow(unused_imports)]
use crate::shared;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A unit whose routine is in shared.rs, which LinkA and LinkB both link.
// Used by rust_shared.pas.

// Pascal: `function NameA: Integer;`
// Written in Rust, in `shared.rs`: `pub fn name_a() -> i16`

// ===== src/link_b.rs =====
//! Generated by Ruscal from `linkb.pas`. Do not edit by hand.
//! Pascal: `unit LinkB;`

#[allow(unused_imports)]
use crate::link_a::*;
#[allow(unused_imports)]
use crate::shared;
#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// A unit whose routine is in shared.rs, which LinkA and LinkB both link.
// Used by rust_shared.pas.

// Pascal: `function NameB: Integer;`
// Written in Rust, in `shared.rs`: `pub fn name_b() -> i16`

// ===== src/shared.rs =====
//! Linked by both linka.pas and linkb.pas: one file, one module.

pub fn name_a() -> i16 {
    1
}

pub fn name_b() -> i16 {
    2
}
