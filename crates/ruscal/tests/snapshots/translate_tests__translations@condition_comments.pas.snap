//! Generated by Ruscal from `condition_comments.pas`. Do not edit by hand.
//! Pascal: `program ConditionComments;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

/// Pascal: `function Show(k: Integer): Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn show(calls: &mut i16, k: i16) -> i16 {
    let mut result: i16 = 0;
    *calls += 1;
    result = k;
    result
}

/// The main program: the `begin ... end.` block of `ConditionComments`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // A loop condition whose translation needs a teaching comment (the first
    // `shl` of the program) and temporaries: the comment goes before the loop,
    // not inside the condition's block. Output from fpc -Mtp.
    let mut n: i16 = 0;
    let mut calls: i16 = 0;
    n = 3;
    calls = 0;
    // `checked_shl`/`checked_shr`: shifting by the integer's width or more gives
    // 0, as in Turbo Pascal, where Rust's `<<` and `>>` would panic.
    while n > 0 && show(&mut calls, n).checked_shl(n as u32).unwrap_or(0) > 0 {
        n -= 1;
    }
    pwriteln!(n, " ", calls);
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        n += 1;
        if show(&mut calls, n) << 2 > 8 {
            break;
        }
    }
    pwriteln!(n, " ", calls);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
