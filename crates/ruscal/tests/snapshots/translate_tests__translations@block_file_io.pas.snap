//! Generated by Ruscal from `block_file_io.pas`. Do not edit by hand.
//! Pascal: `program BlockFileIO;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `BlockFileIO`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // Untyped files with I/O checks off: a short BlockRead without a Result count is
    // error 100 in IOResult, not a stop; and Eof counts in records, so a
    // part of a record at the end is at the end. Output from fpc -Mtp.
    let mut f: PBlockFile = PBlockFile::default();
    let mut buf: PArray<u8, 1, 400> = PArray::default();
    let mut got: u16 = 0;
    let mut n: i16 = 0;
    f.assign("block_file_io.bin");
    f.rewrite_records(1);
    f.block_write(&buf.to_bytes(), 300);
    f.close();
    f.reset_records(1);
    // `{$I-}`: an I/O error in `io_unchecked` sets `IOResult` instead of
    // stopping the program.
    io_unchecked(|| f.block_read(&mut buf, 350));
    n = io_result();
    pwriteln!("short read: ", n);
    f.close();
    f.reset();
    got = f.block_read_count(&mut buf, 2) as u16;
    pwriteln!("got ", got, " pos ", f.file_pos(), " size ", f.file_size(), " eof ", f.eof());
    f.close();
    f.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
