//! Generated by Ruscal from `goto_main_exit.pas`. Do not edit by hand.
//! Pascal: `program GotoMainExit;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A labeled main loop with a goto out of it: the block the goto leaves
// goes around the loop, so leaving it leaves the loop too.

/// The main program: the `begin ... end.` block of `GotoMainExit`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut n: i16 = 0;
    n = 0;
    // `goto Finish` jumps forward: Rust can't jump, but it can leave a block
    // early, so the statements it skips are in the block `'finish`, and the
    // jump is `break 'finish`.
    'finish: {
        // `goto Main` jumps back: the statements from the label on are a loop,
        // and the jump is `continue 'main_`. Otherwise the loop runs once.
        'main_: loop {
            n += 1;
            if n >= 3 {
                break 'finish;
            }
            continue 'main_;
        }
    }
    pwriteln!("n=", n);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
