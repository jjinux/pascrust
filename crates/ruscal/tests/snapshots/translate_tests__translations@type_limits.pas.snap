//! Generated by Ruscal from `type_limits.pas`. Do not edit by hand.
//! Pascal: `program TypeLimits;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// High and Low of a type are names in the Rust, where its type is known:
// i16::MAX for High(Integer), N for High(Index) with Index = 1..N.

const N: i16 = 10;
const TOP: i16 = i16::MAX;
const FIRST: u8 = b'a';
const LAST: u8 = b'z';

/// Pascal: `(Mon, Tue, Wed, Thu, Fri, Sat, Sun)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Day {
    #[default]
    Mon,
    Tue,
    Wed,
    Thu,
    Fri,
    Sat,
    Sun,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Day {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Day {
    const VALUES: &'static [Self] = &[Day::Mon, Day::Tue, Day::Wed, Day::Thu, Day::Fri, Day::Sat, Day::Sun];
}

/// The main program: the `begin ... end.` block of `TypeLimits`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut l: i32 = 0;
    let mut b: u8 = 0;
    let mut c: u8 = 0;
    let mut s: i8 = 0;
    let mut x: i8 = 0;
    i = i16::MAX;
    l = i32::from(i16::MAX);
    w_ = u16::MAX;
    l = i32::MIN;
    b = u8::MAX;
    c = u8::MAX;
    s = i8::MIN;
    x = N as i8;
    i = 1;
    if i < i16::MAX {
        pwriteln!(i, " ", l, " ", w_, " ", i16::from(b), " ", i16::from(c), " ", s, " ", x);
    }
    pwriteln!(32767, " ", 32767 + 1, " ", 10);
    // A Char or enum subrange has its own bounds.
    pwriteln!(b'a', b'z', " ", Day::Fri as i16, " ", TOP);
    // `x` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for x_value in 1..=N as i8 {
        x = x_value;
        pwrite!(x);
    }
    pwriteln!();
    match i {
        i16::MIN => {
            pwriteln!("low");
        }
        i16::MAX => {
            pwriteln!("high");
        }
        _ => {
            pwriteln!("in between");
        }
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
