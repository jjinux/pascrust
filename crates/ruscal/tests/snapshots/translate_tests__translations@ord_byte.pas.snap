//! Generated by Ruscal from `ord_byte.pas`. Do not edit by hand.
//! Pascal: `program OrdByte;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Ord of a Char or a Byte, used as a Byte, is the same byte (b = c),
// with overflow checks too.

/// The main program: the `begin ... end.` block of `OrdByte`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut b: u8 = 0;
    let mut b2: u8 = 0;
    let mut c: u8 = 0;
    let mut i: i16 = 0;
    c = b'C';
    b2 = 7;
    b = c;
    pwriteln!(i16::from(b));
    b = b'A';
    pwriteln!(i16::from(b));
    b = b2;
    i = i16::from(c);
    // `{$Q+}`: `checked_add` and the like give `None` when the result doesn't fit,
    // and `overflow` stops with runtime error 215, as in Turbo Pascal.
    b = b.checked_add(b'A').unwrap_or_else(overflow);
    b = b.checked_add(c).unwrap_or_else(overflow);
    pwriteln!(i16::from(b), " ", i);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
