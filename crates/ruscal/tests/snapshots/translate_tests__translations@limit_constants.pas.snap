//! Generated by Ruscal from `limit_constants.pas`. Do not edit by hand.
//! Pascal: `program LimitConstants;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

const TOP_B: u8 = u8::MAX;
const TOP_W: u16 = u16::MAX;
const LOW_S: i8 = i8::MIN;
const TOP_C: u8 = u8::MAX;
const TOP_LET: u8 = b'z';
const LOW_LET: u8 = b'a';

// A constant that is a type's limit has that type: High(Word) is a Word,
// High(Letter) of a Char subrange a Char.
// Pascal: `Letter = 'a'..'z'`

/// The main program: the `begin ... end.` block of `LimitConstants`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut c: u8 = 0;
    let mut w_: u16 = 0;
    pwriteln!(i16::from(TOP_B), " ", TOP_W, " ", LOW_S, " ", i16::from(TOP_C));
    pwriteln!(TOP_LET, LOW_LET);
    c = TOP_LET;
    if c == TOP_LET {
        pwriteln!("last letter ", c);
    }
    w_ = TOP_W;
    pwriteln!(w_, " ", i16::from(TOP_B) + 1, " ", i16::from(LOW_S) - 1);
    // `c` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for c_value in LOW_LET..=TOP_LET {
        c = c_value;
        pwrite!(c);
    }
    pwriteln!();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
