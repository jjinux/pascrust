//! Generated by Ruscal from `goto_dead_code.pas`. Do not edit by hand.
//! Pascal: `program GotoDeadCode;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

#[allow(unused_imports)]
use ruscal_runtime::prelude::*;

// Statements after a goto or Exit never run (old debugging code, say):
// the Rust keeps them, commented out, since Rust warns about code it
// can't reach. A goto among them needs no block.

/// Pascal: `procedure Early;`
fn early() {
    pwriteln!("early");
    return;
    // Never runs, in the Pascal either:
    // pwriteln!("never");
}

/// The main program: the `begin ... end.` block of `GotoDeadCode`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let s: PString = PString::new();
    let mut n: i16 = 0;
    n = 1;
    // `goto Done` jumps forward: Rust can't jump, but it can leave a block
    // early, so the statements it skips are in the block `'done`, and the
    // jump is `break 'done`.
    'done: {
        break 'done;
        // Never runs, in the Pascal either:
        // s = pstr("debug");
        // pwriteln!("debug ", s, " still debugging");
        // break 'done;
    }
    early();
    pwriteln!("end ", n);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
