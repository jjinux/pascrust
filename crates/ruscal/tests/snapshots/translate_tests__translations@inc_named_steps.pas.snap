//! Generated by Ruscal from `inc_named_steps.pas`. Do not edit by hand.
//! Pascal: `program IncNamedSteps;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// An Inc or Dec step that names a constant keeps the name; a step that
// doesn't fit the target is cut down with `as`, which keeps the low bits
// as TP does (300 is 44 in a Byte).

const K: i16 = 5;
const BIG: i16 = 300;
const NEG: i16 = -3;
const HUGE: i32 = 40000;

/// The main program: the `begin ... end.` block of `IncNamedSteps`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut b: u8 = 0;
    let mut i: i16 = 0;
    let mut c: u8 = 0;
    b = 10;
    i = 10;
    c = b'a';
    // `BIG as u8` keeps the low bits: 300 is 44 in Byte arithmetic, as in Turbo Pascal.
    b += BIG as u8;
    // `NEG as u8` keeps the low bits: -3 is 253 in Byte arithmetic, as in Turbo Pascal.
    b -= NEG as u8;
    b += K as u8;
    i -= NEG;
    // `HUGE as i16` keeps the low bits: 40000 is -25536 in Integer arithmetic, as in Turbo Pascal.
    i += HUGE as i16;
    c += K as u8;
    pwriteln!(i16::from(b), " ", i, " ", c);
    b = 10;
    i = 10;
    // `{$Q+}`: a step whose type holds values the target's can't is added in a wider type;
    // `try_from` fails, and `overflow` stops with runtime error 215, when the result doesn't fit.
    b = u8::try_from(i32::from(b) - i32::from(NEG)).unwrap_or_else(|_| overflow());
    // `BIG as u8` keeps the low bits: 300 is 44 in Byte arithmetic, as in Turbo Pascal.
    // `{$Q+}`: `checked_add` and the like give `None` when the result doesn't fit,
    // and `overflow` stops with runtime error 215, as in Turbo Pascal.
    b = b.checked_add(BIG as u8).unwrap_or_else(overflow);
    i = i.checked_sub(NEG).unwrap_or_else(overflow);
    b = u8::try_from(i32::from(b) + i32::from(NEG)).unwrap_or_else(|_| overflow());
    b = b.checked_add(K as u8).unwrap_or_else(overflow);
    pwriteln!(i16::from(b), " ", i);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
