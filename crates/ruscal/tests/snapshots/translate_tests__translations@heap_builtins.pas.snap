//! Generated by Ruscal from `heap_builtins.pas`. Do not edit by hand.
//! Pascal: `program HeapBuiltins;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// Standard routines that change a heap record while reading it: a value
// read from the record is worked out first, and Val's two targets in one
// record borrow it once.

/// Pascal: `^TRec`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PRec = Ptr<TRec>;

/// Pascal: `TRec = record ... end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    name: PString,
    w: i16,
    buf: PArray<u8, 0, 3>,
    v: i16,
    code: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(TRec { name: string 10, w, buf, v, code });

/// The main program: the `begin ... end.` block of `HeapBuiltins`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: PRec = Ptr::nil();
    let mut s: PString = PString::new();
    p = Ptr::alloc();
    p.get_mut().name = pstr("12");
    p.get_mut().w = 1;
    let name = p.get().name;
    p.get_mut().name.insert(name, 1);
    pwriteln!(p.get().name);
    let w_ = p.get().w;
    p.get_mut().name.delete(w_, 1);
    pwriteln!(p.get().name);
    p.get_mut().w = 2;
    let w_ = p.get().w;
    fill_bytes(&mut bytes_from(&mut *p.get_mut(), 13), w_, 65);
    pwriteln!(i16::from(p.get().buf[0]), " ", i16::from(p.get().buf[1]), " ", i16::from(p.get().buf[2]));
    p.get_mut().v = 1;
    let w_ = p.get().w;
    // The source's bytes are copied out first: reading the heap record
    // while `move_bytes` changes it would borrow it twice.
    let source = bytes_after(&(*p.get()).to_bytes(), 16).to_vec();
    move_bytes(&source, &mut bytes_from(&mut *p.get_mut(), 13), w_);
    pwriteln!(i16::from(p.get().buf[0]), " ", i16::from(p.get().buf[1]));
    s = pstr("12");
    p.with_mut(|t_rec| val(s, &mut t_rec.v, &mut t_rec.code));
    pwriteln!(p.get().v, " ", p.get().code);
    p.get_mut().name = pstr("34");
    let text = p.get().name;
    p.with_mut(|t_rec| val(text, &mut t_rec.v, &mut t_rec.code));
    pwriteln!(p.get().v, " ", p.get().code);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
