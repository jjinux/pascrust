//! Generated by Ruscal from `for_pointer_bounds.pas`. Do not edit by hand.
//! Pascal: `program ForPointerBounds;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// A for loop's bounds that read through a pointer, with a body that
// changes the record the pointer points to. Pascal works out the bounds
// once, before the loop.
/// Pascal: `record Count: Integer; Items: array[1..5] of Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TList {
    count: i16,
    items: PArray<i16, 1, 5>,
}

/// Pascal: `^TList`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PList = Ptr<TList>;

/// The main program: the `begin ... end.` block of `ForPointerBounds`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: PList = Ptr::nil();
    p = Ptr::alloc();
    p.get_mut().count = 3;
    // Worked out before the loop: a `for` range reading through a pointer
    // would keep it borrowed for the whole loop.
    let count = p.get().count;
    for i in 1..=count {
        p.get_mut().items[i] = i * 2;
        p.get_mut().count = 1;
    }
    pwriteln!(p.get().items[3], " ", p.get().count);
    let first = p.get().items.low() as i16;
    let last = p.get().items.high() as i16;
    for i in first..=last {
        p.get_mut().items[i] = i;
    }
    pwriteln!(p.get().items[5]);
    p.get_mut().count = 4;
    let count = p.get().count;
    for i in (1..=count).rev() {
        p.get_mut().items[i] += 10;
    }
    pwriteln!(p.get().items[1], " ", p.get().items[4], " ", p.get().items[5]);
    p.dispose();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
