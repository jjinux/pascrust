//! Generated by Ruscal from `set_constant_patterns.pas`. Do not edit by hand.
//! Pascal: `program SetPat;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use ruscal_runtime::prelude::*;

// x in [...] with constant elements is a match pattern, and a constant
// expression of literals in it (Succ(Mon)) is written as its value; one
// that names a constant (K + 1) keeps the name, in a set built on the
// spot.

const K: i16 = 5;
const FIRST: u8 = b'a';
const WEEKEND: Day = Day::Sat;

/// Pascal: `(Mon, Tue, Wed, Thu, Fri, Sat, Sun)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Day {
    #[default]
    Mon,
    Tue,
    Wed,
    Thu,
    Fri,
    Sat,
    Sun,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Day {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Day {
    const VALUES: &'static [Self] = &[Day::Mon, Day::Tue, Day::Wed, Day::Thu, Day::Fri, Day::Sat, Day::Sun];
}

/// The main program: the `begin ... end.` block of `SetPat`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut b: u8 = 0;
    let mut c: u8 = 0;
    let mut d: Day = Day::Mon;
    i = 7;
    b = 6;
    c = b'c';
    d = Day::Sun;
    pwriteln!(
        pset![set of i16; K + 1..=K * 2].contains(i),
        " ",
        pset![set of i16; K, K + 1].contains(b),
        " ",
        pset![set of i16; -K..=-1, 2 * K].contains(i)
    );
    pwriteln!(
        pset![set of u8; FIRST..=FIRST + 1 + 1].contains(c),
        " ",
        pset![set of u8; (i16::from(FIRST) + 1) as u8].contains(c)
    );
    pwriteln!(matches!(d, Day::Tue | Day::Sat | Day::Sun), " ", matches!(d, Day::Sat));
    pwriteln!(pset![set of i16; K..=2 * K].contains(b), " ", matches!(i, K));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    ruscal_runtime::run(pascal_main);
}
