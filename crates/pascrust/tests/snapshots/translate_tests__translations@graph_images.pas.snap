//! Generated by PascRust from `graph_images.pas`. Do not edit by hand.
//! Pascal: `program GraphImages;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// GetImage, PutImage with its five modes, and ImageSize, with the image
// in TP's own buffer layout: two Words (width - 1, height - 1), then each
// row as bit planes 3 down to 0 (and 2 bytes more that ImageSize counts
// but GetImage leaves alone). The buffer comes
// from GetMem, a static array, or a file. Self-checking: Free Pascal's
// Graph unit needs a real screen (and keeps images its own way), so this
// .out is built from the checks, by hand.

/// Pascal: `record width, height: Word; end`
#[derive(Clone, Copy, Debug, Default)]
struct Header {
    width: u16,
    height: u16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Header { width, height });

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `GraphImages`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    let mut p: AnyPtr = AnyPtr::nil();
    let mut size: u16 = 0;
    let mut buf: PArray<u8, 1, 86> = PArray::default();
    let mut head: Header = Header::default();
    let mut f: PBlockFile = PBlockFile::default();
    checks = 0;
    failures = 0;
    driver = i16::from(DETECT);
    init_graph(&mut driver, &mut mode, "");
    check(
        &mut checks,
        &mut failures,
        image_size(0, 0, 15, 15) == 134,
        pstr("ImageSize: 6 + 16 rows of 4 planes of 2 bytes"),
    );
    check(&mut checks, &mut failures, image_size(0, 0, 9, 9) == 86, pstr("ImageSize rounds a row up to 8 pixels"));
    check(
        &mut checks,
        &mut failures,
        graph_result() == i16::from(GR_OK) && image_size(0, 0, 639, 479) == 0,
        pstr("ImageSize of 64K or more is 0"),
    );
    check(&mut checks, &mut failures, graph_result() == i16::from(GR_ERROR), pstr("with GraphResult grError"));
    check(&mut checks, &mut failures, graph_result() == i16::from(GR_OK), pstr("reading GraphResult resets it"));
    put_pixel(0, 0, LIGHT_BLUE);
    put_pixel(9, 9, BROWN);
    size = image_size(0, 0, 9, 9);
    p = AnyPtr::alloc(size);
    get_image(0, 0, 9, 9, &mut p.bytes());
    move_bytes(&p.bytes().to_bytes(), &mut head, 4);
    check(&mut checks, &mut failures, head.width == 9 && head.height == 9, pstr("the header: width - 1, height - 1"));
    put_image(100, 50, &p.bytes().to_bytes(), NORMAL_PUT);
    check(
        &mut checks,
        &mut failures,
        get_pixel(100, 50) == u16::from(LIGHT_BLUE) && get_pixel(109, 59) == u16::from(BROWN),
        pstr("PutImage NormalPut"),
    );
    put_image(100, 50, &p.bytes().to_bytes(), XOR_PUT);
    check(
        &mut checks,
        &mut failures,
        get_pixel(100, 50) == u16::from(BLACK) && get_pixel(109, 59) == u16::from(BLACK),
        pstr("XORPut twice erases"),
    );
    put_pixel(100, 50, RED);
    put_image(100, 50, &p.bytes().to_bytes(), OR_PUT);
    check(
        &mut checks,
        &mut failures,
        i32::from(get_pixel(100, 50)) == i32::from(i16::from(RED) | i16::from(LIGHT_BLUE)),
        pstr("OrPut"),
    );
    put_image(100, 50, &p.bytes().to_bytes(), AND_PUT);
    check(
        &mut checks,
        &mut failures,
        i32::from(get_pixel(100, 50)) == i32::from((i16::from(RED) | i16::from(LIGHT_BLUE)) & i16::from(LIGHT_BLUE)),
        pstr("AndPut"),
    );
    put_image(100, 50, &p.bytes().to_bytes(), NOT_PUT);
    check(
        &mut checks,
        &mut failures,
        i32::from(get_pixel(100, 50)) == i32::from(15 - i16::from(LIGHT_BLUE))
            && get_pixel(101, 50) == u16::from(WHITE),
        pstr("NotPut"),
    );
    // The planes: LightBlue is 1001, so pixel 0 is in planes 3 and 0.
    get_image(0, 0, 9, 9, &mut buf);
    check(
        &mut checks,
        &mut failures,
        i16::from(buf[5]) == 128 && i16::from(buf[7]) == 0 && i16::from(buf[9]) == 0 && i16::from(buf[11]) == 128,
        pstr("row 0: planes 3 down to 0"),
    );
    // Brown is 0110: the last row, planes 2 and 1, pixel 9 is bit 6 of byte 2.
    check(
        &mut checks,
        &mut failures,
        i16::from(buf[77]) == 0 && i16::from(buf[80]) == 64 && i16::from(buf[82]) == 64 && i16::from(buf[84]) == 0,
        pstr("the last row"),
    );
    // A sprite saved to a file and drawn from it.
    f.assign("sprite.img");
    f.rewrite_records(1);
    f.block_write(&p.bytes().to_bytes(), size);
    f.close();
    buf = PArray::default();
    f.reset_records(1);
    f.block_read(&mut buf, f.file_size());
    f.close();
    f.erase();
    clear_device();
    put_image(200, 100, &buf.to_bytes(), NORMAL_PUT);
    check(
        &mut checks,
        &mut failures,
        get_pixel(200, 100) == u16::from(LIGHT_BLUE) && get_pixel(209, 109) == u16::from(BROWN),
        pstr("an image from a file"),
    );
    // The viewport moves the image, and clips it if it's set to.
    set_view_port(300, 300, 302, 302, CLIP_ON);
    put_image(0, 0, &buf.to_bytes(), NORMAL_PUT);
    set_view_port(0, 0, get_max_x(), get_max_y(), CLIP_ON);
    check(
        &mut checks,
        &mut failures,
        get_pixel(300, 300) == u16::from(LIGHT_BLUE) && get_pixel(309, 309) == u16::from(BLACK),
        pstr("PutImage clips to the viewport"),
    );
    set_view_port(400, 400, 402, 402, CLIP_OFF);
    put_image(0, 0, &buf.to_bytes(), NORMAL_PUT);
    set_view_port(0, 0, get_max_x(), get_max_y(), CLIP_ON);
    check(&mut checks, &mut failures, get_pixel(409, 409) == u16::from(BROWN), pstr("but not with ClipOff"));
    p.free();
    close_graph();
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
