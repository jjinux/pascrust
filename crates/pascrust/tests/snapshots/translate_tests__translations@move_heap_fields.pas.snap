/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PRec = Ptr<TRec>;

/// Pascal: `record w: Word; b: array[0..1] of Byte; l: LongInt; end`
#[derive(Clone, Copy, Debug, Default)]
struct TRec {
    w: u16,
