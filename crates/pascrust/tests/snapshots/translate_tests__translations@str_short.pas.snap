//! Generated by PascRust from `str_short.pas`. Do not edit by hand.
//! Pascal: `program StrShort;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Str into a string[n] cuts the text to fit, as an assignment does.
// Output from fpc -Mtp except lines 1 and 3: Free Pascal cuts an integer
// before padding it ('  1'), and keeps all of a Real's '  3.25' even in a
// string[4]; PascRust formats the whole field, then keeps its start.

/// The main program: the `begin ... end.` block of `StrShort`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: PString = PString::new();
    let mut r: PString = PString::new();
    s = pas_str(w(1234, 5)).truncated(3);
    pwriteln!("[", s, "] ", s.length());
    s = pas_str(w(7, 2)).truncated(3);
    pwriteln!("[", s, "] ", s.length());
    r = pas_str(wd(3.25, 6, 2)).truncated(4);
    pwriteln!("[", r, "] ", r.length());
    r = pas_str(-98765).truncated(4);
    pwriteln!("[", r, "]");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
