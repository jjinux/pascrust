//! Generated by PascRust from `interrupt_vectors.pas`. Do not edit by hand.
//! Pascal: `program InterruptVectors;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// GetIntVec and SetIntVec, faked: a vector holds what a program puts in it
// (here @Tick, an interrupt procedure), and gives back DOS's handler, so
// saving and restoring a vector works, but PascRust has no interrupts and
// never calls a handler. Written by hand: Free Pascal on this machine has
// no interrupt vectors.

/// Pascal: `procedure Tick;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn tick(ticks: &mut i16) {
    *ticks += 1;
}

/// Pascal: `procedure KeyHandler(Flags, CS, IP, AX, BX, CX, DX, SI, DI, DS, ES, BP: Word);`
fn key_handler(
    flags: u16,
    cs: u16,
    ip: u16,
    ax: u16,
    bx: u16,
    cx: u16,
    dx: u16,
    si: u16,
    di: u16,
    ds: u16,
    es: u16,
    bp: u16,
) {
    pwriteln!("never");
}

/// The main program: the `begin ... end.` block of `InterruptVectors`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut old: AnyPtr = AnyPtr::nil();
    let mut cur: AnyPtr = AnyPtr::nil();
    let mut other: AnyPtr = AnyPtr::nil();
    let mut ticks: i16 = 0;
    ticks = 0;
    get_int_vec(28, &mut old);
    get_int_vec(9, &mut other);
    pwriteln!(!old.is_nil(), " ", old != other);
    set_int_vec(28, AnyPtr::code("Tick"));
    set_int_vec(9, AnyPtr::code("KeyHandler"));
    get_int_vec(28, &mut cur);
    pwriteln!(cur == AnyPtr::code("Tick"), " ", cur != old, " ", cur != AnyPtr::code("KeyHandler"));
    set_int_vec(28, old.clone());
    get_int_vec(28, &mut cur);
    pwriteln!(cur == old, " ", ticks);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
