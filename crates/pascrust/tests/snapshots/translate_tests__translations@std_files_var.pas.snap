//! Generated by PascRust from `std_files_var.pas`. Do not edit by hand.
//! Pascal: `program StdFilesVar;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Output, Input and the printer's Lst passed where a var Text parameter is
// expected: a common way to write a report once and send it anywhere.
// Self-checking. (Free Pascal's Lst is a real printer device, so this .out
// is built from the checks, by hand.)

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// Pascal: `procedure Report(var dest: Text; total: Integer);`
fn report(dest: &mut PText, total: i16) {
    fwriteln!(dest, "Total: ", total);
}

/// Pascal: `procedure ReadNumber(var src: Text; var value: Integer);`
fn read_number(src: &mut PText, value: &mut i16) {
    freadln!(src, value);
}

/// The main program: the `begin ... end.` block of `StdFilesVar`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut f: PText = PText::default();
    let mut line: PString = PString::new();
    let mut n: i16 = 0;
    checks = 0;
    failures = 0;
    report(&mut PText::console(), 1);
    report(&mut PText::printer(), 2);
    Lst.flush();
    f.assign("printer.txt");
    f.reset();
    freadln!(f, &mut line);
    f.close();
    check(&mut checks, &mut failures, line == "Total: 2", pstr("Report(Lst) printed"));
    read_number(&mut PText::console(), &mut n);
    check(&mut checks, &mut failures, n == 42, pstr("ReadNumber(Input)"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
