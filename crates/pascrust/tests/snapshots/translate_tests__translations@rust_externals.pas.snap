// ===== src/main.rs =====
//! Generated by PascRust from `rust_externals.pas`. Do not edit by hand.
//! Pascal: `program RustExternals;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod rust_link;

// The Rust files the program links with `{$L file.rs}`: its `external`
// routines are there.
mod rust_externals;
mod rustlink;

#[allow(unused_imports)]
use crate::rust_link::*;
use pascrust_runtime::prelude::*;

// Calling Rust from Turbo Pascal: `external` routines are Rust functions
// in the file named by the $L directive before them (as TP linked .OBJ
// files), here rust_externals.rs, and a unit's in rustlink.rs. Output
// written by hand: Free Pascal can't link Rust.

// Pascal: `procedure DoubleIt(var N: Integer);`
// Written in Rust, in `rust_externals.rs`: `pub fn double_it(n: &mut i16)`

// Pascal: `function IsClose(A, B: Real): Boolean;`
// Written in Rust, in `rust_externals.rs`: `pub fn is_close(a: f64, b: f64) -> bool`

// Pascal: `procedure Greet(const Name: string);`
// Written in Rust, in `rust_externals.rs`: `pub fn greet(name: PString)`

/// The main program: the `begin ... end.` block of `RustExternals`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut n: i16 = 0;
    n = 21;
    rust_externals::double_it(&mut n);
    pwriteln!(n);
    pwriteln!(rust_externals::is_close(0.1 + 0.2, 0.3), " ", rust_externals::is_close(1.0, 2.0));
    rust_externals::greet(pstr("Pascal"));
    pwriteln!(rustlink::gcd(84, 36), " ", rustlink::gcd(-12, 18));
    pwriteln!(rustlink::reversed(pstr("stressed")));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/rust_link.rs =====
//! Generated by PascRust from `rustlink.pas`. Do not edit by hand.
//! Pascal: `unit RustLink;`

#[allow(unused_imports)]
use crate::rust_externals;
#[allow(unused_imports)]
use crate::rustlink;
#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

// A unit whose routines are written in Rust (rustlink.rs), linked with
// $L as TP linked an .OBJ file. Used by rust_externals.pas.

// Pascal: `function Gcd(A, B: LongInt): LongInt;`
// Written in Rust, in `rustlink.rs`: `pub fn gcd(a: i32, b: i32) -> i32`

// Pascal: `function Reversed(const S: string): string;`
// Written in Rust, in `rustlink.rs`: `pub fn reversed(s: PString) -> PString`

// ===== src/rust_externals.rs =====
//! The Rust half of rust_externals.pas.

use pascrust_runtime::prelude::*;

/// A var parameter is a `&mut`.
pub fn double_it(n: &mut i16) {
    *n *= 2;
}

/// A Real is an f64; a Boolean a bool.
pub fn is_close(a: f64, b: f64) -> bool {
    (a - b).abs() < 1e-9
}

/// Output through the runtime, like Pascal's own Write.
pub fn greet(name: PString) {
    pwriteln!("hello, ", name, " (from Rust)");
}

// ===== src/rustlink.rs =====
//! The Rust half of rustlink.pas: its `external` routines.

use pascrust_runtime::prelude::*;

/// The greatest common divisor, by Euclid's algorithm.
pub fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a.abs() } else { gcd(b, a % b) }
}

/// The string backwards.
pub fn reversed(s: PString) -> PString {
    let mut bytes = s.as_bytes().to_vec();
    bytes.reverse();
    PString::from(bytes.as_slice())
}
