//! Generated by PascRust from `pchar_parens.pas`. Do not edit by hand.
//! Pascal: `program PCharParens;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// `(P + 1)^` and `(P + 1)[i]`, read and assigned: a selector after a
// parenthesized PChar expression (the TP 7 Language Guide's `P[I]` is
// `(P + I)^`). Output from fpc -Mtp.

/// The main program: the `begin ... end.` block of `PCharParens`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: PChar = PChar::nil();
    let mut c: u8 = 0;
    p = str_new(&PChar::literal("abc"));
    c = p.plus(1).get(0);
    pwriteln!(c, p.plus(1).get(1));
    p.plus(1).set(0, b'X');
    p.plus(1).set(1, b'Y');
    pwriteln!(p);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
