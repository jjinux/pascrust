//! Generated by pascrust from `pointers.pas`. Do not edit by hand.
//! Pascal: `program Pointers;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Pointers and the heap: a linked list, and the binary search tree
// algorithm from examples/database/bstunit.pas.
/// Pascal: `^Node`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type NodePtr = Ptr<Node>;

/// Pascal: `record value: integer; next: NodePtr; end`
#[derive(Clone, Debug, Default)]
struct Node {
    value: i16,
    next: NodePtr,
}

/// Pascal: `^Key`
type KeyPtr = Ptr<Key>;

/// Pascal: `record id: longint; before, after: KeyPtr; end`
#[derive(Clone, Debug, Default)]
struct Key {
    id: i32,
    before: KeyPtr,
    after: KeyPtr,
}

/// Pascal: `procedure Push(var list: NodePtr; v: integer);`
fn push(list: &mut NodePtr, v: i16) {
    let mut n: NodePtr = Ptr::nil();
    n = Ptr::alloc();
    n.get_mut().value = v;
    n.get_mut().next = list.clone();
    *list = n.clone();
}

/// Pascal: `function Sum(list: NodePtr): integer;`
fn sum(mut list: NodePtr) -> i16 {
    let mut result: i16 = 0;
    let mut total: i16 = 0;
    total = 0;
    while !list.is_nil() {
        total += list.get().value;
        let next = list.get().next.clone();
        list = next;
    }
    result = total;
    result
}

/// Pascal: `procedure Insert(var root: KeyPtr; id: longint; var successful: boolean);`
fn insert(root: &mut KeyPtr, id: i32, successful: &mut bool) {
    if root.is_nil() {
        *root = Ptr::alloc();
        root.get_mut().id = id;
        root.get_mut().before = Ptr::nil();
        root.get_mut().after = Ptr::nil();
    } else if id < root.get().id {
        insert(&mut root.get_mut().before, id, successful);
    } else if id > root.get().id {
        insert(&mut root.get_mut().after, id, successful);
    } else {
        *successful = false;
    }
}

/// Pascal: `procedure Delete(var root: KeyPtr; item: Key; var successful: boolean);`
fn delete(root: &mut KeyPtr, item: Key, successful: &mut bool) {
    let mut temp: KeyPtr = Ptr::nil();
    if root.is_nil() {
        *successful = false;
    } else if item.id < root.get().id {
        delete(&mut root.get_mut().before, item.clone(), successful);
    } else if item.id > root.get().id {
        delete(&mut root.get_mut().after, item.clone(), successful);
    } else if root.get().before.is_nil() {
        temp = root.get().after.clone();
        root.dispose();
        *root = temp.clone();
    } else if root.get().after.is_nil() {
        temp = root.get().before.clone();
        root.dispose();
        *root = temp.clone();
    } else {
        temp = root.get().after.clone();
        while !temp.get().before.is_nil() {
            let before = temp.get().before.clone();
            temp = before;
        }
        let value = temp.get().clone();
        *root.get_mut() = value;
        let item_arg = temp.get().clone();
        delete(&mut root.get_mut().after, item_arg, successful);
    }
}

/// Pascal: `procedure Traverse(root: KeyPtr);`
fn traverse(root: KeyPtr) {
    if !root.is_nil() {
        let root_arg = root.get().before.clone();
        traverse(root_arg);
        pwrite!(root.get().id, " ");
        let root_arg = root.get().after.clone();
        traverse(root_arg);
    }
}

/// The main program: the `begin ... end.` block of `Pointers`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut head: NodePtr = Ptr::nil();
    let mut p: NodePtr = Ptr::nil();
    let mut root: KeyPtr = Ptr::nil();
    let mut ok: bool = false;
    let mut k: Key = Key::default();
    head = Ptr::nil();
    for i in 1_i16..=5 {
        push(&mut head, i * i);
    }
    pwriteln!("sum = ", sum(head.clone()));
    p = head.clone();
    let next = p.get().next.clone();
    p = next;
    pwriteln!("second = ", p.get().value);
    root = Ptr::nil();
    ok = true;
    insert(&mut root, 50, &mut ok);
    insert(&mut root, 30, &mut ok);
    insert(&mut root, 70, &mut ok);
    insert(&mut root, 20, &mut ok);
    insert(&mut root, 40, &mut ok);
    insert(&mut root, 60, &mut ok);
    insert(&mut root, 80, &mut ok);
    insert(&mut root, 30, &mut ok);
    pwriteln!("duplicate accepted: ", ok);
    traverse(root.clone());
    pwriteln!();
    k.id = 50;
    ok = true;
    delete(&mut root, k.clone(), &mut ok);
    k.id = 20;
    delete(&mut root, k.clone(), &mut ok);
    traverse(root.clone());
    pwriteln!();
    pwriteln!("root is now ", root.get().id, ", deleted ok: ", ok);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
