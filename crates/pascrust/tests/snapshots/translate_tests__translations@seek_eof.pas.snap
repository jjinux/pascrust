//! Pascal: `program SeekEofTest;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `SeekEofTest`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // SeekEof and SeekEoln skip blanks first, so a loop reading numbers stops
    // cleanly at trailing blanks and empty lines.
    let mut n: i16 = 0;
    let mut sum: i16 = 0;
    let mut count: i16 = 0;
    sum = 0;
    count = 0;
    while !seek_eof() {
        while !seek_eoln() {
            pread!(&mut n);
            sum += n;
            count += 1;
        }
        preadln!();
        pwriteln!("line done, ", count, " numbers so far");
