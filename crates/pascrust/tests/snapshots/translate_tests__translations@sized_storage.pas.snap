//! Generated by PascRust from `sized_storage.pas`. Do not edit by hand.
//! Pascal: `program SizedStorage;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Strings and small sets keep their TP sizes outside a record's direct
// fields too: a file of string[10] (11 bytes a record), a file of an
// array of string[5], an array of string[4] and an array of small sets as
// untyped bytes and through Move, and a record field that's an array of
// small sets in a file. Output from fpc -Mtp.
/// Pascal: `array[1..2] of string[5]`
type Arr = PArray<PString, 1, 2>;

/// Pascal: `(Red, Green, Blue)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Color {
    #[default]
    Red,
    Green,
    Blue,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Color {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Color {
    const VALUES: &'static [Self] = &[Color::Red, Color::Green, Color::Blue];
}

/// Pascal: `array[0..255] of Byte`
type TBytes = PArray<u8, 0, 256>;

/// Pascal: `array[1..3] of string[4]`
type NameArr = PArray<PString, 1, 3>;

/// Pascal: `array[1..2] of set of Color`
type SetArr = PArray<PSet<Color>, 1, 2>;

/// Pascal: `record Marks: SetArr; end`
#[derive(Clone, Copy, Debug, Default)]
struct Flags {
    marks: SetArr,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Flags { marks: set 1 });

/// Pascal: `procedure Dump(var Data; Size: Word);`
fn dump(data: &mut dyn ByteView, size: u16) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let data = Bytes::of(data);
    for i in 0..=(size - 1) as i16 {
        pwrite!(i16::from(data[i]), " ");
    }
    pwriteln!();
}

/// The main program: the `begin ... end.` block of `SizedStorage`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PFile<PString> = PFile::sized(10);
    let mut g: PFile<Arr> = PFile::sized(5);
    let mut a: Arr = Arr::default();
    let mut s: PString = PString::new();
    let mut b: PFile<u8> = PFile::default();
    let mut names: NameArr = NameArr::default();
    let mut sets: SetArr = SetArr::default();
    let mut buf: PArray<u8, 1, 15> = PArray::default();
    let mut fl: PFile<Flags> = PFile::default();
    let mut fr: Flags = Flags::default();
    f.assign("fs.dat");
    f.rewrite();
    s = pstr("hello");
    f.write(&s);
    s = pstr("world");
    f.write(&s);
    f.close();
    b.assign("fs.dat");
    b.reset();
    pwriteln!("bytes ", b.file_size());
    b.close();
    f.reset();
    f.seek(1);
    f.read(&mut s);
    f.close();
    pwriteln!(s);
    a[1] = pstr("ab");
    a[2] = pstr("cde");
    g.assign("fa.dat");
    g.rewrite();
    g.write(&a);
    g.close();
    b.assign("fa.dat");
    b.reset();
    pwriteln!("arr bytes ", b.file_size(), " sizeof ", 12);
    b.close();
    names[1] = pstr("ab");
    names[2] = pstr("c");
    names[3] = pstr("defg");
    dump(&mut sized_bytes(&mut names, 4), 15);
    dump(&mut bytes_from(&mut sized_bytes(&mut names, 4), 5), 10);
    move_bytes(&sized_view_bytes(&names, 4), &mut buf, 15);
    for i in 1_i16..=15 {
        pwrite!(i16::from(buf[i]), " ");
    }
    pwriteln!();
    sets[1] = pset![Color::Red];
    sets[2] = pset![Color::Blue];
    dump(&mut sized_bytes(&mut sets, 1), 2);
    fr.marks = sets;
    fl.assign("fl.dat");
    fl.rewrite();
    fl.write(&fr);
    fl.close();
    b.assign("fl.dat");
    b.reset();
    pwriteln!("flags bytes ", b.file_size());
    b.close();
    fl.reset();
    fl.read(&mut fr);
    fl.close();
    pwriteln!(fr.marks[2].contains(Color::Blue), " ", fr.marks[2].contains(Color::Red));
    f.erase();
    g.erase();
    fl.erase();
