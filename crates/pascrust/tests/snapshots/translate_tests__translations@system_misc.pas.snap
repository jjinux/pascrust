//! Generated by pascrust from `system_misc.pas`. Do not edit by hand.
//! Pascal: `program SystemMisc;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `^Node`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PNode = Ptr<Node>;

/// Pascal: `record value: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Node {
    value: i16,
}

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if !ok {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `SystemMisc`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut dir: PString = PString::new();
    let mut short: PString = PString::new();
    let heap: PNode = Ptr::nil();
    let mut p: PNode = Ptr::nil();
    let mut f: PText = PText::default();
    let buf: PArray<u8, 1, 1024> = PArray::default();
    checks = 0;
    failures = 0;
    dir = get_dir(0);
    check(&mut checks, &mut failures, dir == "C:\\", pstr("GetDir at the start"));
    mk_dir("gd_tmp");
    ch_dir("gd_tmp");
    dir = get_dir(0);
    check(&mut checks, &mut failures, dir == "C:\\GD_TMP", pstr("GetDir after ChDir"));
    short = get_dir(0).truncated(4);
    check(&mut checks, &mut failures, short == "C:\\G", pstr("GetDir into a string[4]"));
    ch_dir("..");
    rm_dir("gd_tmp");
    dir = get_dir(1);
    check(&mut checks, &mut failures, dir == "A:\\", pstr("GetDir of drive A:"));
    check(&mut checks, &mut failures, mem_avail() > 100000, pstr("MemAvail"));
    check(&mut checks, &mut failures, max_avail() > 0 && max_avail() <= mem_avail(), pstr("MaxAvail"));
    check(&mut checks, &mut failures, 3 == 3, pstr("Test8087"));
    // Mark(heap) does nothing: records are freed when nothing points to them.
    p = Ptr::alloc();
    p.get_mut().value = 1;
    // Release(heap) does nothing: records are freed when nothing points to them.
    let ok = p.get().value == 1;
    check(&mut checks, &mut failures, ok, pstr("Release frees nothing"));
    f.assign("misc.tmp");
    // SetTextBuf(f, ...) does nothing: files are buffered already.
    f.rewrite();
    fwriteln!(f, "hi");
    f.close();
    f.erase();
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
