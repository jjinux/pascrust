//! Generated by pascrust from `crt_vars.pas`. Do not edit by hand.
//! Pascal: `program CrtVars;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `CrtVars`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut f: PText = PText::default();
    let mut n: i16 = 0;
    checks = 0;
    failures = 0;
    check(&mut checks, &mut failures, last_mode() == u16::from(CO80), pstr("LastMode starts as CO80"));
    text_mode(BW80);
    check(&mut checks, &mut failures, last_mode() == u16::from(BW80), pstr("TextMode sets LastMode"));
    set_last_mode(u16::from(CO80));
    text_mode(last_mode());
    check(&mut checks, &mut failures, last_mode() == u16::from(CO80), pstr("TextMode(LastMode)"));
    text_color(YELLOW);
    text_background(BLUE);
    check(
        &mut checks,
        &mut failures,
        i16::from(text_attr()) == i16::from(YELLOW) + i16::from(BLUE) * 16,
        pstr("TextAttr from TextColor and TextBackground"),
    );
    set_text_attr((i16::from(WHITE) + i16::from(RED) * 16) as u8);
    check(&mut checks, &mut failures, i16::from(text_attr()) == 79, pstr("TextAttr :="));
    norm_video();
    check(
        &mut checks,
        &mut failures,
        i16::from(text_attr()) == i16::from(LIGHT_GRAY),
        pstr("NormVideo resets TextAttr"),
    );
    check(&mut checks, &mut failures, check_break(), pstr("CheckBreak starts True"));
    set_check_break(false);
    check(&mut checks, &mut failures, !check_break(), pstr("CheckBreak :="));
    set_direct_video(false);
    set_check_snow(false);
    check(&mut checks, &mut failures, !direct_video() && !check_snow(), pstr("DirectVideo and CheckSnow can be set"));
    assign_crt(&mut f);
    f.rewrite();
    fwriteln!(f, "written through AssignCrt");
    f.close();
    f.reset();
    freadln!(f, &mut n);
    f.close();
    check(&mut checks, &mut failures, n == 42, pstr("read through AssignCrt"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
