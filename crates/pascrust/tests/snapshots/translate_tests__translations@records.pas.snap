    let mut people: PArray<Person, 1, 3> = PArray::default();
    let mut p: Person = Person::default();
    let mut q: Person = Person::default();
    let mut origin: Point = Point::default();
    p.name = pstr("Alexander the Great").truncated(10);
    p.age = 32;
    pwriteln!(p.name, " ", p.name.length());
    q = p;
    q.age = 1;
    birthday(&mut p);
    pwriteln!(describe(p), " ", describe(q));
    for i in 1_i16..=3 {
