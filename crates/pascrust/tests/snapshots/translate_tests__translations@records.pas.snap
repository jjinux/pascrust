/// Pascal: `procedure Birthday(var who: Person);`
fn birthday(who: &mut Person) {
    who.age += 1;
}

/// Pascal: `function Describe(who: Person): string;`
fn describe(who: Person) -> PString {
    let mut result: PString = PString::new();
    let mut s: PString = PString::new();
    s = pas_str(who.age);
    result = who.name + " (" + s + ")";
