//! Generated by PascRust from `short_circuit.pas`. Do not edit by hand.
//! Pascal: `program ShortCircuit;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// The right side of and/or runs only when it has to, even when it reads
// through a pointer into a function's argument: (p <> nil) and
// Show(p^.value) mustn't read p^ when p is nil. Output from fpc -Mtp.
/// Pascal: `^Node`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PNode = Ptr<Node>;

/// Pascal: `record value: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Node {
    value: i16,
}

/// Pascal: `function Show(x: Integer): Integer;`
fn show(x: i16) -> i16 {
    let mut result: i16 = 0;
    pwriteln!("Show ", x);
    result = x;
    result
}

/// The main program: the `begin ... end.` block of `ShortCircuit`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: PNode = Ptr::nil();
    p = Ptr::nil();
    if !p.is_nil() && {
        let x = p.get().value;
        show(x) > 0
    } {
        pwriteln!("yes");
    } else {
        pwriteln!("no");
    }
    if p.is_nil() || {
        let x = p.get().value;
        show(x) > 0
    } {
        pwriteln!("nil or positive");
    }
    p = Ptr::alloc();
    p.get_mut().value = 4;
    if !p.is_nil() && {
        let x = p.get().value;
        show(x) > 0
    } {
        pwriteln!("yes");
    }
    while !p.is_nil() && {
        let x = p.get().value;
        show(x) > 0
    } {
        p.get_mut().value -= 2;
    }
    pwriteln!("done");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
