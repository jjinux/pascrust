//! Generated by PascRust from `const_folding.pas`. Do not edit by hand.
//! Pascal: `program ConstFolding;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

const LAST: Day = Day::Sun;
const BEFORE_LAST: Day = Day::Sat;
const SWAP_NEG: i16 = -1;
const SWAP255: i32 = 65280;
const SWAP_WORD: i16 = 255;
const HI_NEG: i16 = 255;
const LO_NEG: i16 = 255;
const LEN: i16 = 4;
const ODD_NEG: bool = true;
const SWAP_TWICE: i32 = 65280;
const HIGH_WORD: i32 = 65280;
const SWAP_NAMED: i16 = 255;

// TP 7's constant functions, worked out when the program is translated,
// agree with the same calls at run time; Swap works in the type Free
// Pascal chooses; and enum ranges in set tests.
// Self-checking. (Free Pascal can't evaluate some of these constants, so
// this .out is built from the checks, by hand.)
/// Pascal: `(Mon, Tue, Wed, Thu, Fri, Sat, Sun)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Day {
    #[default]
    Mon,
    Tue,
    Wed,
    Thu,
    Fri,
    Sat,
    Sun,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Day {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Day {
    const VALUES: &'static [Self] = &[Day::Mon, Day::Tue, Day::Wed, Day::Thu, Day::Fri, Day::Sat, Day::Sun];
}

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `ConstFolding`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut b: u8 = 0;
    let mut sh: i8 = 0;
    let mut l: i32 = 0;
    let mut d: Day = Day::Mon;
    checks = 0;
    failures = 0;
    i = -1;
    check(&mut checks, &mut failures, SWAP_NEG == i.swap_bytes(), pstr("Swap(-1) folded as at run time"));
    w_ = 255;
    check(
        &mut checks,
        &mut failures,
        SWAP255 == i32::from(w_.swap_bytes()),
        pstr("Swap(255) works on a Word, as in Free Pascal"),
    );
    i = 255;
    check(&mut checks, &mut failures, i.swap_bytes() == -256, pstr("Swap of an Integer variable stays an Integer"));
    b = 1;
    sh = -1;
    check(
        &mut checks,
        &mut failures,
        u16::from(b).swap_bytes() == 256 && i16::from(sh).swap_bytes() == -1,
        pstr("a Byte swaps as a Word, a ShortInt as an Integer"),
    );
    l = 305419896;
    check(&mut checks, &mut failures, l.rotate_left(16) == 1450709556, pstr("Swap of a LongInt trades its halves"));
    check(&mut checks, &mut failures, SWAP_WORD == 255, pstr("Swap($FF00) is a Word"));
    check(&mut checks, &mut failures, SWAP_TWICE == 65280 && 65280_u16 == 65280, pstr("Swap of a Word stays a Word"));
    check(&mut checks, &mut failures, SWAP_NAMED == 255 && 255_u16 == 255, pstr("Swap of a named Word constant"));
    i = -5;
    check(&mut checks, &mut failures, -(-i) == -5, pstr("a negated negation"));
    i = -256;
    check(&mut checks, &mut failures, HI_NEG == i16::from((i >> 8) as u8), pstr("Hi(-256)"));
    i = -1;
    check(&mut checks, &mut failures, LO_NEG == i16::from(i as u8), pstr("Lo(-1)"));
    check(
        &mut checks,
        &mut failures,
        i16::from(255_u8) == 255 && i16::from(0_u8) == 0,
        pstr("Hi and Lo of negative literals"),
    );
    check(&mut checks, &mut failures, LEN == 4, pstr("Length of a string constant"));
    check(&mut checks, &mut failures, ODD_NEG, pstr("Odd(-3)"));
    check(&mut checks, &mut failures, BEFORE_LAST == Day::Sat, pstr("Pred of an enum constant"));
    d = Day::Sun;
    check(&mut checks, &mut failures, matches!(d, Day::Sat | Day::Sun), pstr("an enum range in a set test"));
    check(&mut checks, &mut failures, !matches!(Day::Wed, Day::Sat | Day::Sun), pstr("and one ending in a constant"));
    check(&mut checks, &mut failures, matches!(true, false | true), pstr("a Boolean range"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
