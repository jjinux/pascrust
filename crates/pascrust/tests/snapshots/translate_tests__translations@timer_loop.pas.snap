//! Generated by PascRust from `timer_loop.pas`. Do not edit by hand.
//! Pascal: `program TimerLoop;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// The way to get a steady tick without a timer interrupt (see
// docs/timer_interrupts.md): a main loop that does a tick's work, then
// waits out the rest of the tick with Delay, measuring time with GetTime.
// The ticks counted don't depend on how fast the machine is.

const TICK_MS: i16 = 55; // the PC timer's 18.2 ticks a second

// Milliseconds since midnight.
/// Pascal: `function NowMs: LongInt;`
fn now_ms() -> i32 {
    let mut result: i32 = 0;
    let mut h: u16 = 0;
    let mut m: u16 = 0;
    let mut s: u16 = 0;
    let mut s100: u16 = 0;
    get_time(&mut h, &mut m, &mut s, &mut s100);
    result = ((i32::from(h) * 60 + i32::from(m)) * 60 + i32::from(s)) * 1000 + i32::from(s100 * 10);
    result
}

// What the interrupt handler did.
/// Pascal: `procedure Tick;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn tick(ticks: &mut i32) {
    *ticks += 1;
}

/// The main program: the `begin ... end.` block of `TimerLoop`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut ticks: i32 = 0;
    let mut last_tick: i32 = 0;
    let mut elapsed: i32 = 0;
    ticks = 0;
    last_tick = now_ms();
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        tick(&mut ticks);
        // ... the rest of the frame's work goes here ...
        elapsed = now_ms() - last_tick;
        if elapsed >= 0 && elapsed < i32::from(TICK_MS) {
            delay(i32::from(TICK_MS) - elapsed);
        }
        last_tick += i32::from(TICK_MS);
        if ticks == 10 {
            break;
        }
    }
    pwriteln!(ticks, " ticks");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
