//! Generated by pascrust from `shift_right.pas`. Do not edit by hand.
//! Pascal: `program ShiftRight;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `ShiftRight`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut l: i32 = 0;
    let mut s: i8 = 0;
    let mut w_: u16 = 0;
    i = -300;
    l = -300;
    s = -3;
    w_ = 65236;
    pwriteln!(
        ((i as u16) >> 4) as i16,
        " ",
        ((l as u32) >> 4) as i32,
        " ",
        ((i16::from(s) as u16) >> 1) as i16,
        " ",
        ((-300_i16 as u16) >> 4) as i16
    );
    pwriteln!(((300_i16 as u16) >> 4) as i16, " ", w_ >> 4);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
