//! Generated by PascRust from `hidden_captures.pas`. Do not edit by hand.
//! Pascal: `program HiddenCaptures;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Note;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn note(count: &mut i16) {
    *count += 1;
}

/// Pascal: `procedure Hidden;`
///
/// Uses globals, which are passed in as parameters.
fn hidden(global_count: &mut i16) {
    let mut count: i16 = 0;
    count = 100;
    hidden_deeper(global_count, &mut count);
    pwriteln!("hidden count ", count);
}

/// Pascal: `procedure Deeper;`
///
/// Nested inside `Hidden` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn hidden_deeper(global_count: &mut i16, count: &mut i16) {
    note(global_count);
    *count += 1;
}

/// The main program: the `begin ... end.` block of `HiddenCaptures`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // A nested procedure that needs two variables with the same name: its
    // parent's local `count`, and the global `count` it hides, which a routine
    // it calls uses. Each gets its own parameter. Output from fpc -Mtp.
    let mut count: i16 = 0;
    count = 0;
    hidden(&mut count);
    pwriteln!("count ", count);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
