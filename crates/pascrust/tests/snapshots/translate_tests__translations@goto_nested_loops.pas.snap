// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// A goto out of a goto loop nested in another; a labeled final Exit; a
// repeat body that always leaves; while True. No unreachable code and no
// loop that never ends.

/// Pascal: `function F(N: Integer): Integer;`
fn f(n: i16) -> i16 {
    let mut result: i16 = 0;
    result = n;
    // `goto Fin` jumps forward: Rust can't jump, but it can leave a block
    // early, so the statements it skips are in the block `'fin`, and the
    // jump is `break 'fin`.
    'fin: {
        if n > 5 {
            break 'fin;
        }
        result = n * 2;
    }
    return result;
}

/// Pascal: `procedure P;`
fn p() {
    pwriteln!("p");
    // all done
}

/// The main program: the `begin ... end.` block of `GotoNestedLoops`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    let mut k: i16 = 0;
    i = 0;
    'finish: {
        // `goto Main` jumps back: the statements from the label on are a loop,
        // and the jump is `continue 'main_`. Otherwise the loop runs once.
        'main_: loop {
            i += 1;
            j = 0;
            'inner: loop {
                j += 1;
                if i == 2 && j == 2 {
                    break 'finish;
                }
                if j < 3 {
                    continue 'inner;
                }
                break 'inner;
            }
            pwriteln!("i=", i, " j=", j);
            continue 'main_;
        }
    }
    pwriteln!("done ", i, " ", j);
    k = 0;
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        k += 1;
        break;
    }
    loop {
        k += 1;
        if k > 3 {
            break;
        }
    }
    pwriteln!(f(3), " ", f(7), " ", k);
