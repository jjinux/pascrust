//! Generated by PascRust from `set_sizes.pas`. Do not edit by hand.
//! Pascal: `program SetSizes;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `record n: Byte; b: Bits; l: Letters; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    n: u8,
    b: PSet<i8>,
    l: PSet<u8>,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Rec { n, b: set 1, l: set 4 from 12 });

/// Pascal: `array[0..255] of Byte`
type TBytes = PArray<u8, 0, 256>;

// A set takes the bytes TP gave it, from its lowest value's byte to its
// highest's: set of 0..7 is 1 byte, set of 'a'..'z' 4 (bytes 12 to 15 of
// the whole bitmap), in SizeOf, untyped arguments, arrays and files.
// Output from fpc -Mtp, except the file's bytes: Free Pascal pads the
// record (9 130 0 0 4 0 0 2), where TP doesn't.
// Pascal: `Bits = set of 0..7`

/// Pascal: `procedure Dump(var data; n: Integer);`
fn dump(data: &mut dyn ByteView, n: i16) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let data = Bytes::of(data);
    for i in 0..=n - 1 {
        pwrite!(i16::from(data[i]), " ");
    }
    pwriteln!();
}

/// The main program: the `begin ... end.` block of `SetSizes`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: Rec = Rec::default();
    let mut r2: Rec = Rec::default();
    let mut arr: PArray<PSet<i8>, 1, 2> = PArray::default();
    let mut f: PFile<Rec> = PFile::default();
    let mut g: PFile<u8> = PFile::default();
    let mut x: u8 = 0;
    pwriteln!(1, " ", 4, " ", 2);
    r.n = 9;
    r.b = pset![1, 7];
    r.l = pset![b'b', b'y'];
    dump(&mut bytes_from(&mut r, 1), 1);
    dump(&mut bytes_from(&mut r, 2), 4);
    arr[1] = pset![0, 1];
    arr[2] = pset![7];
    dump(&mut sized_bytes(&mut arr, 1), 2);
    f.assign("set_sizes.dat");
    f.rewrite();
    f.write(&r);
    f.close();
    g.assign("set_sizes.dat");
    g.reset();
    while !g.eof() {
        g.read(&mut x);
        pwrite!(i16::from(x), " ");
    }
    pwriteln!();
    g.close();
    f.reset();
    f.read(&mut r2);
    f.close();
    f.erase();
    pwriteln!(r2.b.contains(7), " ", r2.b.contains(2), " ", r2.l.contains(b'y'), " ", r2.l.contains(b'c'));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
