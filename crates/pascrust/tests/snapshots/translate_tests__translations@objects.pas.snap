//! Generated by PascRust from `objects.pas`. Do not edit by hand.
//! Pascal: `program Objects;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Turbo Pascal 5.5 objects: fields, methods, inheritance.
const MAX_SIZE: i16 = 5;

/// Pascal: `Queue = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct Queue {
    items: PArray<i16, 1, 5>,
    count: i16,
}

/// Pascal: `NamedQueue = object(Queue) ... end`
#[derive(Clone, Copy, Debug, Default)]
struct NamedQueue {
    /// The inherited part: `NamedQueue` descends from `Queue`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: Queue,
    name: PString,
}

/// Pascal: `procedure Fill(var target: Queue; n: integer);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn fill(log: &mut i16, target: &mut Queue, n: i16) {
    for k in 1..=n {
        target.add(log, k * 10);
    }
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl Queue {
    /// Pascal: `procedure Queue.Create;`
    fn create(&mut self) {
        self.count = 0;
    }

    /// Pascal: `procedure Queue.Add(item: integer);`
    ///
    /// Uses globals, which are passed in as parameters.
    fn add(&mut self, log: &mut i16, item: i16) {
        if !self.full() {
            self.count += 1;
            self.items[self.count] = item;
            *log += 1;
        }
    }

    /// Pascal: `function Queue.Full: boolean;`
    fn full(&mut self) -> bool {
        let mut result: bool = false;
        result = self.count == MAX_SIZE;
        result
    }

    /// Pascal: `function Queue.Total: integer;`
    fn total(&mut self) -> i16 {
        let mut result: i16 = 0;
        let mut sum: i16 = 0;
        sum = 0;
        queue_total_add_all(self, &mut sum);
        result = sum;
        result
    }
}

/// Pascal: `procedure AddAll;`
///
/// Nested inside `Queue.Total` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn queue_total_add_all(this: &Queue, sum: &mut i16) {
    // A procedure nested inside a method still sees the object's fields.
    for j in 1..=this.count {
        *sum += this.items[j];
    }
}

impl NamedQueue {
    /// Pascal: `procedure NamedQueue.Init(n: string);`
    fn init(&mut self, n: PString) {
        self.base.create(); // an inherited method
        self.name = n.truncated(10);
    }

    /// Pascal: `procedure NamedQueue.Show;`
    fn show(&mut self) {
        pwriteln!(self.name, ": ", self.base.count, " items, total ", self.base.total());
    }
}

/// The main program: the `begin ... end.` block of `Objects`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut log: i16 = 0; // a global that methods update
    let mut q: Queue = Queue::default();
    let mut nq: NamedQueue = NamedQueue::default();
    log = 0;
    q.create();
    fill(&mut log, &mut q, 3);
    pwriteln!("q total ", q.total(), " full ", q.full());
    nq.init(pstr("numbers"));
    for i in 1_i16..=7 {
        nq.base.add(&mut log, i);
    }
    nq.show();
    pwriteln!("full ", nq.base.full(), " log ", log);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
