//! Generated by PascRust from `arg_order.pas`. Do not edit by hand.
//! Pascal: `program ArgOrder;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Arguments run left to right, even when a later one is computed into a
// temporary first (it reads through a pointer): Bump changes the record
// before head^.value is read. Output from fpc -Mtp.
/// Pascal: `^Node`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PNode = Ptr<Node>;

/// Pascal: `record value: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Node {
    value: i16,
}

/// Pascal: `function Bump: Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn bump(head: &PNode) -> i16 {
    let mut result: i16 = 0;
    head.get_mut().value += 10;
    result = 1;
    result
}

/// Pascal: `procedure Show(a: Integer; var b: Integer);`
fn show(a: i16, b: &mut i16) {
    pwriteln!(a, " ", *b);
}

/// Pascal: `procedure ShowV(a, b: Integer);`
fn show_v(a: i16, b: i16) {
    pwriteln!(a, " ", b);
}

/// The main program: the `begin ... end.` block of `ArgOrder`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut head: PNode = Ptr::nil();
    head = Ptr::alloc();
    head.get_mut().value = 5;
    show(bump(&head), &mut head.get_mut().value);
    head.get_mut().value = 5;
    let a = bump(&head);
    let b = head.get().value;
    show_v(a, b);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
