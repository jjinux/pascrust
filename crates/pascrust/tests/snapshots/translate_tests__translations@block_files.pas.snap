//! Generated by PascRust from `block_files.pas`. Do not edit by hand.
//! Pascal: `program BlockFiles;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Untyped files: BlockWrite and BlockRead in records of 1 byte or of a
// record's size, a copy in chunks with a short last read, a string's
// characters (s[1]), Seek, FileSize, FilePos and Eof in records. Output
// from fpc -Mtp.
/// Pascal: `record name: string[7]; n: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    name: PString,
    n: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Rec { name: string 7, n });

/// The main program: the `begin ... end.` block of `BlockFiles`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PBlockFile = PBlockFile::default();
    let mut g: PBlockFile = PBlockFile::default();
    let mut buf: PArray<u8, 1, 1000> = PArray::default();
    let mut r: Rec = Rec::default();
    let mut back: Rec = Rec::default();
    let mut s: PString = PString::new();
    let mut total: i16 = 0;
    let mut got: u16 = 0;
    let mut wrote: u16 = 0;
    for i in 1_i16..=1000 {
        buf[i] = (i % 251) as u8;
    }
    f.assign("data.bin");
    f.rewrite_records(1);
    wrote = f.block_write_count(&buf.to_bytes(), 1000) as u16;
    pwriteln!("wrote ", wrote, " size ", f.file_size());
    f.close();
    // copy in 256-byte chunks
    f.reset_records(1);
    g.assign("copy.bin");
    g.rewrite_records(1);
    total = 0;
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        got = f.block_read_count(&mut buf, 256) as u16;
        wrote = g.block_write_count(&buf.to_bytes(), got) as u16;
        total = (i32::from(total) + i32::from(got)) as i16;
        if got == 0 {
            break;
        }
    }
    pwriteln!("copied ", total, " size ", g.file_size());
    f.close();
    g.close();
    // a record, with the default record size
    r.name = pstr("pascal");
    r.n = 7;
    f.rewrite_records(10);
    f.block_write(&r.to_bytes(), 1);
    f.close();
    f.reset_records(10);
    f.block_read(&mut back, 1);
    pwriteln!(back.name, " ", back.n, " ", f.file_size(), " ", f.file_pos(), " ", f.eof());
    f.close();
    // a string's characters
    s = pstr("hello world");
    f.rewrite_records(1);
    f.block_write(bytes_after(&string_view_bytes(&s, 255), 1), s.length());
    f.close();
    f.reset_records(1);
    pwriteln!("text ", f.file_size());
    f.seek(6);
    s = PString::new();
    s[0] = b'\x05';
    f.block_read(&mut bytes_from(&mut string_bytes(&mut s, 255), 1), 5);
    pwriteln!(s);
    f.close();
    f.erase();
    g.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
