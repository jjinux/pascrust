//! Generated by PascRust from `eval_order.pas`. Do not edit by hand.
//! Pascal: `program EvalOrder;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `function Bump: Integer;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn bump(n: &mut i16) -> i16 {
    let mut result: i16 = 0;
    *n += 10;
    result = 1;
    result
}

/// Pascal: `function F: Integer;`
fn f() -> i16 {
    let mut result: i16 = 0;
    pwrite!("F");
    result = 1;
    result
}

/// Pascal: `function G: Integer;`
fn g() -> i16 {
    let mut result: i16 = 0;
    pwrite!("G");
    result = 2;
    result
}

/// Pascal: `function Twice(x: Integer): Integer;`
fn twice(x: i16) -> i16 {
    let mut result: i16 = 0;
    result = x * 2;
    result
}

/// Pascal: `function Mark: Integer;`
///
/// Uses globals, which are passed in as parameters.
fn mark(log: &mut PText) -> i16 {
    let mut result: i16 = 0;
    fwrite!(log, "x");
    result = 2;
    result
}

/// The main program: the `begin ... end.` block of `EvalOrder`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // When a function in an expression has side effects: Write(F, G) writes
    // F's value before G runs (TP defines it as Write(F); Write(G)), to the
    // screen and to a file, and n := n + Bump reads n before Bump changes it,
    // as Free Pascal does. A call that can't change n keeps n += ....
    // The .out comes from fpc -Mtp, except that Free Pascal prints the line
    // written to the '' file first: piped, its standard output is held until
    // the program ends. TP (and PascRust) print in program order.
    let mut n: i16 = 0;
    let mut total: i16 = 0;
    let mut log: PText = PText::default();
    let mut line: PString = PString::new();
    n = 0;
    n = n + bump(&mut n);
    pwriteln!("n + Bump: ", n);
    n = 0;
    n = bump(&mut n) + n;
    pwriteln!("Bump + n: ", n);
    pwriteln!(f(), g(), " Write(F, G)");
    pwrite!(f(), " ");
    pwriteln!(g());
    total = 1;
    total += twice(3);
    pwriteln!("total + Twice(3): ", total);
    log.assign("order.txt");
    log.rewrite();
    fwriteln!(log, "a", mark(&mut log), "b");
    log.close();
    log.reset();
    freadln!(log, &mut line);
    log.close();
    log.erase();
    pwriteln!("file: ", line);
    log.assign("");
    log.rewrite();
    fwriteln!(log, "an empty file name is the screen");
    log.close();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
