//! Generated by PascRust from `comments.pas`. Do not edit by hand.
//! Pascal: `program Comments;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Pascal comments are carried into the Rust: this header, comments at
// the ends of lines, comments before statements and declarations, and
// comments before an end.
const LIMIT: i16 = 3; // how many rounds

/// Pascal: `Point = record ... end`
#[derive(Clone, Copy, Debug, Default)]
struct Point {
    x: i16,
    y: i16, // position
    // the point's name
    name: PString,
}

// Add n to the total, twice.
/// Pascal: `procedure AddTwice(n: Integer);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn add_twice(total: &mut i16, n: i16) {
    *total += n; // once
    *total += n; // twice
    // nothing else to do
}

/// The main program: the `begin ... end.` block of `Comments`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: Point = Point::default(); // where we are
    let mut total: i16 = 0;
    total = 0;
    // count up
    for i in 1..=LIMIT {
        add_twice(&mut total, i); // 2, 4, 6
    }
    p.x = total;
    p.name = pstr("here");
    pwriteln!(p.name, " ", p.x);
    // done
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
