//! Generated by pascrust from `find_files.pas`. Do not edit by hand.
//! Pascal: `program FindFiles;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// Pascal: `procedure Make(name: string; text: string);`
///
/// Uses globals, which are passed in as parameters.
fn make(f: &mut PText, name: PString, text: PString) {
    f.assign(name);
    f.rewrite();
    fwrite!(f, text);
    f.close();
}

/// The main program: the `begin ... end.` block of `FindFiles`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // FindFirst and FindNext with DOS wildcards and attributes. Self-checking.
    // (Free Pascal returns matches in directory order, so this .out is built
    // from the checks, by hand: pascrust sorts them by name.)
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut s: SearchRec = SearchRec::default();
    let mut f: PText = PText::default();
    let mut found: PString = PString::new();
    let mut count: i16 = 0;
    checks = 0;
    failures = 0;
    make(&mut f, pstr("b.txt"), pstr("bee"));
    make(&mut f, pstr("a.txt"), pstr("a"));
    make(&mut f, pstr("notes.pas"), pstr("program X; begin end."));
    mk_dir("sub");
    found = PString::new();
    count = 0;
    find_first("*.TXT", ANY_FILE, &mut s);
    while dos_error() == 0 {
        found = found + s.name + " ";
        count += 1;
        find_next(&mut s);
    }
    check(&mut checks, &mut failures, found == "a.txt b.txt ", pstr("FindFirst *.TXT finds both, in name order"));
    check(&mut checks, &mut failures, dos_error() == 18, pstr("DosError 18 after the last one"));
    find_first("b.txt", ANY_FILE, &mut s);
    check(
        &mut checks,
        &mut failures,
        dos_error() == 0 && s.size == 3 && i16::from(s.attr) & i16::from(DIRECTORY) == 0,
        pstr("Size and Attr of a file"),
    );
    check(&mut checks, &mut failures, s.time != 0, pstr("Time of a file"));
    find_first("*.*", DIRECTORY, &mut s);
    count = 0;
    while dos_error() == 0 {
        if i16::from(s.attr) & i16::from(DIRECTORY) != 0 {
            count += 1;
        }
        find_next(&mut s);
    }
    check(&mut checks, &mut failures, count == 1, pstr("with Directory, *.* finds the subdirectory"));
    find_first("*.*", ARCHIVE, &mut s);
    count = 0;
    while dos_error() == 0 {
        if i16::from(s.attr) & i16::from(DIRECTORY) != 0 {
            count += 1;
        }
        find_next(&mut s);
    }
    check(&mut checks, &mut failures, count == 0, pstr("without Directory, no directories"));
    find_first("*.zzz", ANY_FILE, &mut s);
    check(&mut checks, &mut failures, dos_error() == 18, pstr("no match: DosError 18"));
    find_first("nowhere\\*.*", ANY_FILE, &mut s);
    check(&mut checks, &mut failures, dos_error() == 3, pstr("missing directory: DosError 3"));
    f.assign("b.txt");
    f.erase();
    f.assign("a.txt");
    f.erase();
    f.assign("notes.pas");
    f.erase();
    rm_dir("sub");
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
