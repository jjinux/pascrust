//! Generated by PascRust from `find_files.pas`. Do not edit by hand.
//! Pascal: `program FindFiles;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// FindFirst and FindNext with DOS wildcards and attributes. Self-checking.
// (Free Pascal returns matches in directory order, so this .out is built
// from the checks, by hand: pascrust sorts them by name.)

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// Pascal: `procedure Make(name: string; text: string);`
///
/// Uses globals, which are passed in as parameters.
fn make(f: &mut PText, name: PString, text: PString) {
    f.assign(name);
    f.rewrite();
    fwrite!(f, text);
    f.close();
}

/// Pascal: `function Exists(name: string): Boolean;`
fn exists(name: PString) -> bool {
    let mut result: bool = false;
    let mut t: SearchRec = SearchRec::default();
    find_first(name, ANY_FILE, &mut t);
    result = dos_error() == 0;
    result
}

// A recursive directory walk: each level's search waits while the levels
// below are searched.
/// Pascal: `procedure Walk(path: string);`
///
/// Uses globals, which are passed in as parameters.
fn walk(walked_files: &mut i16, walked_dirs: &mut i16, path: PString) {
    let mut t: SearchRec = SearchRec::default();
    find_first(path + "\\*.*", ANY_FILE, &mut t);
    while dos_error() == 0 {
        if i16::from(t.attr) & i16::from(DIRECTORY) == 0 {
            *walked_files += 1;
        } else if t.name != "." && t.name != ".." {
            *walked_dirs += 1;
            walk(walked_files, walked_dirs, path + "\\" + t.name);
        }
        find_next(&mut t);
    }
}

/// The main program: the `begin ... end.` block of `FindFiles`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut s: SearchRec = SearchRec::default();
    let mut t: SearchRec = SearchRec::default();
    let mut f: PText = PText::default();
    let mut found: PString = PString::new();
    let mut count: i16 = 0;
    let mut existing: i16 = 0;
    let mut walked_files: i16 = 0;
    let mut walked_dirs: i16 = 0;
    let mut number: PString = PString::new();
    checks = 0;
    failures = 0;
    make(&mut f, pstr("b.txt"), pstr("bee"));
    make(&mut f, pstr("a.txt"), pstr("a"));
    make(&mut f, pstr("notes.pas"), pstr("program X; begin end."));
    mk_dir("sub");
    found = PString::new();
    count = 0;
    find_first("*.TXT", ANY_FILE, &mut s);
    while dos_error() == 0 {
        found = found + s.name + " ";
        count += 1;
        find_next(&mut s);
    }
    check(&mut checks, &mut failures, found == "a.txt b.txt ", pstr("FindFirst *.TXT finds both, in name order"));
    check(&mut checks, &mut failures, dos_error() == 18, pstr("DosError 18 after the last one"));
    find_first("b.txt", ANY_FILE, &mut s);
    check(
        &mut checks,
        &mut failures,
        dos_error() == 0 && s.size == 3 && i16::from(s.attr) & i16::from(DIRECTORY) == 0,
        pstr("Size and Attr of a file"),
    );
    check(&mut checks, &mut failures, s.time != 0, pstr("Time of a file"));
    find_first("*.*", DIRECTORY, &mut s);
    count = 0;
    while dos_error() == 0 {
        if i16::from(s.attr) & i16::from(DIRECTORY) != 0 {
            count += 1;
        }
        find_next(&mut s);
    }
    check(&mut checks, &mut failures, count == 3, pstr("with Directory, *.* finds the subdirectory, . and .."));
    find_first("sub\\*.*", DIRECTORY, &mut s);
    found = s.name;
    find_next(&mut s);
    found = found + " " + s.name;
    find_next(&mut s);
    check(&mut checks, &mut failures, found == ". .." && dos_error() == 18, pstr("an empty subdirectory has . and .."));
    find_first("*.TXT", DIRECTORY, &mut s);
    check(&mut checks, &mut failures, s.name == "a.txt", pstr("a pattern . doesn't match leaves it out"));
    find_first("*.*", ARCHIVE, &mut s);
    count = 0;
    while dos_error() == 0 {
        if i16::from(s.attr) & i16::from(DIRECTORY) != 0 {
            count += 1;
        }
        find_next(&mut s);
    }
    check(&mut checks, &mut failures, count == 0, pstr("without Directory, no directories"));
    find_first("*.TXT", ANY_FILE, &mut s);
    t = s;
    find_next(&mut t);
    find_next(&mut s);
    check(
        &mut checks,
        &mut failures,
        t.name == "b.txt" && s.name == "b.txt",
        pstr("a copy of a SearchRec goes on by itself"),
    );
    find_first("*.TXT", ANY_FILE, &mut s);
    t = s;
    find_first("b.txt", ANY_FILE, &mut t);
    find_next(&mut s);
    check(
        &mut checks,
        &mut failures,
        dos_error() == 0 && s.name == "b.txt",
        pstr("FindFirst on a copy leaves the original's search alone"),
    );
    find_first("A:*.*", DIRECTORY, &mut s);
    check(&mut checks, &mut failures, s.name != ".", pstr("no . in the root of a drive"));
    find_first("A:\\sub\\..\\*.*", DIRECTORY, &mut s);
    check(&mut checks, &mut failures, s.name != ".", pstr("nor when the root is reached through .."));
    find_first("A:\\..\\*.*", DIRECTORY, &mut s);
    check(&mut checks, &mut failures, s.name != ".", pstr(".. stops at the root of a drive"));
    mk_dir("tree");
    make(&mut f, pstr("tree\\a.txt"), pstr("a"));
    mk_dir("tree\\sub");
    for i in 1_i16..=150 {
        number = pas_str(i);
        mk_dir(pstr("tree\\sub\\d") + number);
    }
    make(&mut f, pstr("tree\\z.txt"), pstr("z"));
    walked_files = 0;
    walked_dirs = 0;
    walk(&mut walked_files, &mut walked_dirs, pstr("tree"));
    check(
        &mut checks,
        &mut failures,
        walked_files == 2 && walked_dirs == 151,
        pstr("a walk through 151 directories sees both files"),
    );
    for i in 1_i16..=150 {
        number = pas_str(i);
        rm_dir(pstr("tree\\sub\\d") + number);
    }
    rm_dir("tree\\sub");
    f.assign("tree\\a.txt");
    f.erase();
    f.assign("tree\\z.txt");
    f.erase();
    rm_dir("tree");
    mk_dir("many");
    for i in 1_i16..=120 {
        number = pas_str(i);
        make(&mut f, pstr("many\\f") + number + ".txt", pstr("x"));
    }
    count = 0;
    existing = 0;
    find_first("many\\*.txt", ANY_FILE, &mut s);
    while dos_error() == 0 {
        count += 1;
        if exists(pstr("many\\") + s.name) {
            existing += 1;
        }
        find_next(&mut s);
    }
    check(
        &mut checks,
        &mut failures,
        count == 120 && existing == 120,
        pstr("a search goes on while 120 others start and stop"),
    );
    for i in 1_i16..=120 {
        number = pas_str(i);
        f.assign(pstr("many\\f") + number + ".txt");
        f.erase();
    }
    rm_dir("many");
    find_first("B?.TXT", ANY_FILE, &mut s);
    check(
        &mut checks,
        &mut failures,
        dos_error() == 0 && s.name == "b.txt",
        pstr("? matches nothing at the end of a name"),
    );
    find_first("????????.???", ARCHIVE, &mut s);
    check(&mut checks, &mut failures, dos_error() == 0 && s.name == "a.txt", pstr("????????.??? matches every name"));
    find_first("*.*", VOLUME_ID, &mut s);
    check(&mut checks, &mut failures, dos_error() == 18, pstr("VolumeID alone: no volume label"));
    find_first("*.TXT", ANY_FILE, &mut s);
    find_first("nowhere\\*.*", ANY_FILE, &mut s);
    find_next(&mut s);
    check(&mut checks, &mut failures, dos_error() == 18, pstr("a failed FindFirst ends the search before it"));
    find_first("*.zzz", ANY_FILE, &mut s);
    check(&mut checks, &mut failures, dos_error() == 18, pstr("no match: DosError 18"));
    find_first("nowhere\\*.*", ANY_FILE, &mut s);
    check(&mut checks, &mut failures, dos_error() == 3, pstr("missing directory: DosError 3"));
    f.assign("b.txt");
    f.erase();
    f.assign("a.txt");
    f.erase();
    f.assign("notes.pas");
    f.erase();
    // A:X is relative to drive A's current directory, as in DOS
    make(&mut f, pstr("sub\\inner.txt"), pstr("in"));
    ch_dir("A:\\sub");
    find_first("A:*.TXT", ANY_FILE, &mut s);
    check(
        &mut checks,
        &mut failures,
        dos_error() == 0 && s.name == "inner.txt",
        pstr("A:*.TXT after ChDir('A:\\sub')"),
    );
    find_first("A:*.*", DIRECTORY, &mut s);
    check(&mut checks, &mut failures, s.name == ".", pstr("and A: is no longer the root, so . is listed"));
    f.assign("A:inner.txt");
    f.erase();
    ch_dir("A:\\");
    rm_dir("sub");
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

