    b_chars.copy_to(b.as_mut_slice());
    val(chars_str(b.as_slice()), &mut n, &mut code);
    pwriteln!(n, " ", code);
    let b_chars = PChar::copy_of(b.as_slice());
    str_copy(&b_chars, &PChar::literal("2.5"));
    b_chars.copy_to(b.as_mut_slice());
    val(chars_str(b.as_slice()), &mut r, &mut code);
    pwriteln!(wd(r, 0, 2), " ", code);
    f.assign("xs_tmp.txt");
    f.rewrite();
    fwriteln!(f, "line one is longer than sixteen");
    fwriteln!(f, "7");
