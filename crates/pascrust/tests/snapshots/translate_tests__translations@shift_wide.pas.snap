//! Generated by pascrust from `shift_wide.pas`. Do not edit by hand.
//! Pascal: `program ShiftWide;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `ShiftWide`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut l: i32 = 0;
    let mut n: i16 = 0;
    i = 1;
    w_ = 65535;
    l = 1;
    n = 20;
    // `checked_shl`/`checked_shr`: shifting by the integer's width or more gives
    // 0, as in Turbo Pascal, where Rust's `<<` and `>>` would panic.
    pwriteln!(
        i.checked_shl(20).unwrap_or(0),
        " ",
        i.checked_shl(n as u32).unwrap_or(0),
        " ",
        i << 4,
        " ",
        w_.checked_shr(n as u32).unwrap_or(0),
        " ",
        w_.checked_shr(16).unwrap_or(0)
    );
    i = -1;
    pwriteln!(
        (i as u16).checked_shr(n as u32).unwrap_or(0) as i16,
        " ",
        ((i as u16) >> 15) as i16,
        " ",
        l.checked_shl(n as u32).unwrap_or(0),
        " ",
        l.checked_shl(32).unwrap_or(0)
    );
    n = 3;
    pwriteln!(i.checked_shl(n as u32).unwrap_or(0), " ", w_.checked_shr(n as u32).unwrap_or(0));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
