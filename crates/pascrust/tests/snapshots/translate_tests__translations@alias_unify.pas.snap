//! Generated by PascRust from `alias_unify.pas`. Do not edit by hand.
//! Pascal: `program AliasUnify;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Show;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn show(generations: i16) {
    pwriteln!("generations = ", generations);
}

/// Pascal: `procedure Pause(var gens: integer);`
///
/// Every call passes `generations` itself as `gens`, so where the Pascal code
/// uses `generations` directly, this function uses `gens`: they are the same
/// variable, and Rust doesn't allow two references to one variable.
fn pause(gens: &mut i16) {
    *gens += 5;
    show(*gens);
    *gens += 1;
}

/// The main program: the `begin ... end.` block of `AliasUnify`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // Pause takes the global `generations` by var, and also calls a procedure
    // that reads the global directly (the pattern from life.pas). Both names
    // refer to the same variable, so the read must see the update.
    let mut generations: i16 = 0;
    generations = 1;
    pause(&mut generations);
    show(generations);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
