//! Generated by pascrust from `for_width.pas`. Do not edit by hand.
//! Pascal: `program ForWidth;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `ForWidth`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // A loop variable declared as Integer is 16 bits even when both bounds are
    // literals, so i * 3000 wraps as it does in Turbo Pascal. (Free Pascal
    // computes in 32 bits here, so this test's .out is written by hand.)
    for i in 10_i16..=12 {
        pwriteln!(i * 3000);
    }
    for i in (11_i16..=12).rev() {
        pwriteln!(i * 3000);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
