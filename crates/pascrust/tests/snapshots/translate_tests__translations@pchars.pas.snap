    buf_chars.copy_to(buf.as_mut_slice());
    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(str_pas(&str_scan(&buf_chars, b',')));
    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(str_end(&buf_chars).diff(&buf_chars));
    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(str_pos(&buf_chars, &PChar::literal("world")).diff(&buf_chars));
    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(count_char(buf_chars.clone(), b'o'));
    buf_chars.copy_to(buf.as_mut_slice());
    let buf_chars = PChar::copy_of(buf.as_slice());
    shout(buf_chars.clone());
    buf_chars.copy_to(buf.as_mut_slice());
    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(str_pas(&buf_chars));
    let name_chars = PChar::copy_of(name.as_slice());
    str_copy(&name_chars, &PChar::literal("Ada"));
    name_chars.copy_to(name.as_mut_slice());
    let name_chars = PChar::copy_of(name.as_slice());
    str_l_cat(&name_chars, &PChar::literal(" Lovelace and more"), 10);
    name_chars.copy_to(name.as_mut_slice());
    let name_chars = PChar::copy_of(name.as_slice());
    pwriteln!("[", str_pas(&name_chars), "]");
    pwriteln!(
        str_comp(&PChar::literal("abc"), &PChar::literal("abd")) < 0,
        " ",
        str_i_comp(&PChar::literal("ABC"), &PChar::literal("abc")),
