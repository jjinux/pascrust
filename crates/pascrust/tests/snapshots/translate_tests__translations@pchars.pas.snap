//! Generated by PascRust from `pchars.pas`. Do not edit by hand.
//! Pascal: `program PChars;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// PChar and the Strings unit: string literals and zero-based Char arrays
// used as PChars, indexing, arithmetic, comparisons, Inc/Dec, GetMem,
// StrNew/StrDispose, and a Char array written through its PChar in a
// routine, a nested call, while and if conditions, for bounds and a case
// selector. Output from fpc -Mtp.

/// Pascal: `array[0..19] of Char`
type TName = PArray<u8, 0, 20>;

/// Pascal: `procedure Show(s: PChar);`
fn show(s: PChar) {
    pwriteln!("[", s, "] ", str_len(&s));
}

/// Pascal: `function CountChar(s: PChar; c: Char): Integer;`
fn count_char(mut s: PChar, c: u8) -> i16 {
    let mut result: i16 = 0;
    let mut k: i16 = 0;
    k = 0;
    while s.get(0) != b'\x00' {
        if s.get(0) == c {
            k += 1;
        }
        s += 1;
    }
    result = k;
    result
}

/// Pascal: `procedure Shout(s: PChar);`
fn shout(s: PChar) {
    str_upper(&s);
}

