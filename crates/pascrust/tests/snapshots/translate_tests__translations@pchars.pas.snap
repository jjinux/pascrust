    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(" ", str_pas(&buf_chars));
    let buf_chars = PChar::copy_of(buf.as_slice());
    if {
        let value = str_comp(&str_upper(&buf_chars), &PChar::literal("ABABABAB")) == 0;
        buf_chars.copy_to(buf.as_mut_slice());
        value
    } {
        let buf_chars = PChar::copy_of(buf.as_slice());
        pwriteln!("upper ", str_pas(&buf_chars));
    } else {
        let buf_chars = PChar::copy_of(buf.as_slice());
        pwriteln!("not ", str_pas(&buf_chars));
    }
    let buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&buf_chars, &PChar::literal("ab"));
    buf_chars.copy_to(buf.as_mut_slice());
    let buf_chars = PChar::copy_of(buf.as_slice());
    // `i` is also used outside this loop (Pascal leaves it holding the
