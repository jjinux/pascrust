        i = i_value;
        pwrite!(i);
    }
    let buf_chars = PChar::copy_of(buf.as_slice());
    pwriteln!(" ", str_pas(&buf_chars));
    let buf_chars = PChar::copy_of(buf.as_slice());
    match {
        let value = str_len(&str_cat(&buf_chars, &PChar::literal("e")));
        buf_chars.copy_to(buf.as_mut_slice());
        value
    } {
        5 => {
            let buf_chars = PChar::copy_of(buf.as_slice());
            pwriteln!("five ", str_pas(&buf_chars));
