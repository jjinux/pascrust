//! Generated by pascrust from `set_range.pas`. Do not edit by hand.
//! Pascal: `program SetRange;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `SetRange`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // A value outside a set's element range is never in it: 300 isn't in a
    // set of Byte, whether it's a constant or a variable. Self-checking.
    // (Free Pascal cuts the variable down to a byte, 300 to 44, so this .out
    // is built from the checks, by hand.)
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut s: PSet<u8> = PSet::new();
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    checks = 0;
    failures = 0;
    s = pset![44, 200];
    i = 300;
    w_ = 256 + 200;
    check(&mut checks, &mut failures, !s.contains(300), pstr("a constant above 255 is not in a set of Byte"));
    check(&mut checks, &mut failures, !s.contains(i), pstr("an Integer variable above 255 is not in it either"));
    check(&mut checks, &mut failures, !s.contains(w_), pstr("nor a Word variable"));
    i = 44;
    check(&mut checks, &mut failures, s.contains(i), pstr("an Integer variable in range is"));
    i = -1;
    check(&mut checks, &mut failures, !s.contains(i), pstr("a negative value is not in a set of Byte"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
