//! Generated by PascRust from `set_file.pas`. Do not edit by hand.
//! Pascal: `program SetFile;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Sets as fields of records in a typed file: written and read back.
/// Pascal: `Rec = record ... end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    n: i16,
    flags: PSet<i8>,
    letters: PSet<u8>,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Rec { n, flags, letters });

/// The main program: the `begin ... end.` block of `SetFile`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PFile<Rec> = PFile::default();
    let mut r: Rec = Rec::default();
    r.n = 5;
    r.flags = pset![1, 3];
    r.letters = pset![b'a'..=b'c'];
    f.assign("setfile.dat");
    f.rewrite();
    f.write(&r);
    f.close();
    r.flags = PSet::new();
    r.letters = PSet::new();
    f.reset();
    f.read(&mut r);
    f.close();
    f.erase();
    pwriteln!(
        r.n,
        " ",
        r.flags.contains(3),
        " ",
        r.flags.contains(2),
        " ",
        r.letters.contains(b'b'),
        " ",
        r.letters.contains(b'z')
    );
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
