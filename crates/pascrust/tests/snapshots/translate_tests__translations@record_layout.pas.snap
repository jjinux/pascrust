//! Generated by PascRust from `record_layout.pas`. Do not edit by hand.
//! Pascal: `program RecordLayout;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Typed files hold records in Turbo Pascal's own layout, the size SizeOf
// gives: a string[30] is 31 bytes, a LongInt 4, a Real 6 (TP's format), so
// files written by TP programs can be read. Self-checking. (Free Pascal
// pads records and writes 8-byte reals, so this .out is built from the
// checks, by hand.)
/// Pascal: `record name: string[30]; ID: LongInt; Index: Real; end`
#[derive(Clone, Copy, Debug, Default)]
struct People {
    name: PString,
    id: i32,
    index: f64,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(People { name: string 30, id, index });

/// Pascal: `(Red, Green, Blue)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Color {
    #[default]
    Red,
    Green,
    Blue,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Color {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Color {
    const VALUES: &'static [Self] = &[Color::Red, Color::Green, Color::Blue];
}

/// Pascal: `record id: Integer; colors: set of Color; end`
#[derive(Clone, Copy, Debug, Default)]
struct Paint {
    id: i16,
    colors: PSet<Color>,
}

file_record!(Paint { id, colors: set 1 });

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `RecordLayout`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut f: PFile<People> = PFile::default();
    let mut raw: PFile<u8> = PFile::default();
    let mut p: People = People::default();
    let mut q: People = People::default();
    let b: u8 = 0;
    let mut bytes: PArray<u8, 1, 41> = PArray::default();
    let mut pf: PFile<Paint> = PFile::default();
    let mut brush: Paint = Paint::default();
    let mut again: Paint = Paint::default();
    checks = 0;
    failures = 0;
    check(&mut checks, &mut failures, 41 == 41, pstr("SizeOf(People) is 41"));
    p.name = pstr("Shannon Behrens");
    p.id = 1;
    p.index = 2930802.0;
    f.assign("people.dat");
    f.rewrite();
    f.write(&p);
    f.close();
    raw.assign("people.dat");
    raw.reset();
    check(&mut checks, &mut failures, raw.file_size() == 41, pstr("one record is 41 bytes on disk"));
    for i in 1_i16..=41 {
        raw.read(&mut bytes[i]);
    }
    raw.close();
    check(
        &mut checks,
        &mut failures,
        i16::from(bytes[1]) == 15 && i16::from(bytes[2]) == i16::from(b'S'),
        pstr("the name's length byte, then its characters"),
    );
    check(
        &mut checks,
        &mut failures,
        i16::from(bytes[32]) == 1 && i16::from(bytes[33]) == 0,
        pstr("the LongInt after the 31 bytes of the name"),
    );
    check(
        &mut checks,
        &mut failures,
        i16::from(bytes[36]) == 150 && i16::from(bytes[41]) == 50,
        pstr("the Real in TP's 6-byte format"),
    );
    f.reset();
    f.read(&mut q);
    f.close();
    f.erase();
    check(&mut checks, &mut failures, q.name == p.name && q.id == 1 && q.index == 2930802.0, pstr("and it reads back"));
    brush.id = 7;
    brush.colors = pset![Color::Red, Color::Blue];
    pf.assign("paint.dat");
    pf.rewrite();
    pf.write(&brush);
    pf.close();
    raw.assign("paint.dat");
    raw.reset();
    check(&mut checks, &mut failures, 3 == 3 && raw.file_size() == 3, pstr("a set of three colours takes one byte"));
    raw.close();
    pf.reset();
    pf.read(&mut again);
    pf.close();
    pf.erase();
    check(
        &mut checks,
        &mut failures,
        again.id == 7 && again.colors == pset![Color::Red, Color::Blue],
        pstr("and reads back"),
    );
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
