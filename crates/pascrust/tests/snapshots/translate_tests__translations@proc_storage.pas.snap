//! Generated by PascRust from `proc_storage.pas`. Do not edit by hand.
//! Pascal: `program ProcStorage;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// A record with a procedural field in a typed file and as untyped bytes:
// the routine is 4 zero bytes, as TP's far address meant nothing to a
// later run of the program, and reads back as nil. Written by hand: Free
// Pascal stores the routine's real (8-byte) address.
/// Pascal: `function(A, B: Integer): Integer`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type Op = ProcVar<fn(i16, i16) -> i16>;

/// Pascal: `record Code: Integer; Apply: Op; end`
#[derive(Clone, Copy, Debug, Default)]
struct Entry {
    code: i16,
    apply: Op,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Entry { code, apply });

/// Pascal: `array[0..255] of Byte`
type TBytes = PArray<u8, 0, 256>;

/// Pascal: `function Add(A, B: Integer): Integer;`
fn add(a: i16, b: i16) -> i16 {
    let mut result: i16 = 0;
    result = a + b;
    result
}

/// Pascal: `procedure Dump(var Data; Size: Word);`
fn dump(data: &mut dyn ByteView, size: u16) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let data = Bytes::of(data);
    for i in 0..=(size - 1) as i16 {
        pwrite!(i16::from(data[i]), " ");
    }
    pwriteln!();
}

/// The main program: the `begin ... end.` block of `ProcStorage`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut e: Entry = Entry::default();
    let mut back: Entry = Entry::default();
    let mut f: PFile<Entry> = PFile::default();
    e.code = 258;
    e.apply = ProcVar::of(add, "Add");
    pwriteln!(e.apply.get()(2, 3), " ", 6);
    dump(&mut e, 6);
    f.assign("proc_storage.dat");
    f.rewrite();
    f.write(&e);
    f.close();
    f.reset();
    f.read(&mut back);
    f.close();
    f.erase();
    pwriteln!(back.code, " ", !back.apply.is_nil(), " ", !e.apply.is_nil());
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
