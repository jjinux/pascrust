//! Generated by PascRust from `untyped_offsets.pas`. Do not edit by hand.
//! Pascal: `program UntypedOffsets;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Untyped arguments that start inside a variable: an element at a
// variable index (of a byte array and a Word array), a field after a
// variant part (all variants start at the same byte), and Move from one.
// An index out of range is runtime error 201 (TP read memory before the
// array). Output from fpc -Mtp, up to that error.
/// Pascal: `array[0..255] of Byte`
type TBytes = PArray<u8, 0, 256>;

/// Pascal: `Fig = record ... end`
///
/// The `case Kind: ... of` part is a tagged union: the program sets `kind`
/// to say which variant's fields are in use. Rust would use an `enum`, but
/// Pascal lets a program set the fields before the tag, so every variant's
/// fields are plain fields here; only `file of` looks at the tag.
#[derive(Clone, Copy, Debug, Default)]
struct Fig {
    x: i16,
    kind: i16,
    r: i16,
    w_: i16,
    h: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
// A variant record keeps one variant in a file: the one `kind` selects,
// padded with zeros to the 4 bytes the variants share in TP.
file_record!(Fig { x, kind; case kind: 4 { 0 => [r], 1 => [w_, h], _ => [] } });

/// Pascal: `procedure Dump(var Data; Size: Word);`
fn dump(data: &mut dyn ByteView, size: u16) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let data = Bytes::of(data);
    for k in 0..=(size - 1) as i16 {
        pwrite!(i16::from(data[k]), " ");
    }
    pwriteln!();
}

/// The main program: the `begin ... end.` block of `UntypedOffsets`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut buf: PArray<u8, 1, 10> = PArray::default();
    let mut words: PArray<u16, 1, 3> = PArray::default();
    let mut f: Fig = Fig::default();
    let mut i: i16 = 0;
    let mut out: PArray<u8, 1, 2> = PArray::default();
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for i_value in 1..=10 {
        i = i_value;
        buf[i] = i as u8;
    }
    i = 3;
    dump(&mut bytes_from(&mut buf, i as i64 - 1), 2);
    words[1] = 258;
    words[2] = 772;
    words[3] = 1286;
    i = 2;
    dump(&mut bytes_from(&mut words, (i as i64 - 1) * 2), 2);
    f.x = 1;
    f.kind = 1;
    f.w_ = 7;
    f.h = 9;
    dump(&mut bytes_from(&mut f, 6), 2);
    move_bytes(bytes_after(&words.to_bytes(), (i as i64 - 1) * 2), &mut out, 2);
    pwriteln!(i16::from(out[1]), " ", i16::from(out[2]));
    i = 0;
    dump(&mut bytes_from(&mut buf, i as i64 - 1), 1);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
