//! Generated by PascRust from `untyped_params.pas`. Do not edit by hand.
//! Pascal: `program UntypedParams;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Untyped var parameters: a routine sees the caller's variable as Turbo
// Pascal's bytes (TBytes(Data)[i]), can write them back (also when it
// leaves through Exit), pass them on, and read them as another type;
// Move and FillChar between different types; an argument that starts
// inside a variable (s[1], buf[3]). Output from fpc -Mtp.
/// Pascal: `array[0..255] of Byte`
type TBytes = PArray<u8, 0, 256>;

/// Pascal: `record name: string[5]; n: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    name: PString,
    n: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Rec { name: string 5, n });

/// Pascal: `procedure Dump(var Data; Size: Word);`
fn dump(data: &mut dyn ByteView, size: u16) {
    // An untyped parameter is the caller's variable as Turbo Pascal's bytes;
    // `Bytes` copies them, and when it's dropped (at any `return`) it
    // writes them back into the variable.
    let data = Bytes::of(data);
    for i in 0..=(size - 1) as i16 {
        pwrite!(i16::from(data[i]), " ");
    }
    pwriteln!();
}

/// Pascal: `procedure Zero(var Data; Size: Word);`
fn zero(data: &mut dyn ByteView, size: u16) {
    let mut data = Bytes::of(data);
    for i in 0..=(size - 1) as i16 {
        data[i] = 0;
    }
}

/// Pascal: `procedure Pass(var Data; Size: Word);`
fn pass(data: &mut dyn ByteView, size: u16) {
    let mut data = Bytes::of(data);
    dump(&mut data, size);
}

/// Pascal: `procedure SetSome(var Data; Count: Word);`
fn set_some(data: &mut dyn ByteView, count: u16) {
    let mut data = Bytes::of(data);
    for i in 0_i16..=7 {
        if i32::from(i) == i32::from(count) {
            return;
        }
        data[i] = 9;
    }
}

/// Pascal: `function First(var Data): Rec;`
fn first(data: &mut dyn ByteView) -> Rec {
    let data = Bytes::of(data);
    let mut result: Rec = Rec::default();
    result = data.read::<Rec>();
    result
}

/// The main program: the `begin ... end.` block of `UntypedParams`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: Rec = Rec::default();
    let mut r2: Rec = Rec::default();
    let mut s: PString = PString::new();
    let mut w_: u16 = 0;
    let mut buf: PArray<u8, 1, 8> = PArray::default();
    r.name = pstr("abc");
    r.n = 258;
    dump(&mut r, 8);
    w_ = 4660;
    pass(&mut w_, 2);
    s = pstr("hello");
    dump(&mut bytes_from(&mut string_bytes(&mut s, 10), 1), 3);
    for i in 1_i16..=8 {
        buf[i] = i as u8;
    }
    zero(&mut bytes_from(&mut buf, 2), 2);
    dump(&mut buf, 8);
    move_bytes(&r.to_bytes(), &mut buf, 8);
    dump(&mut buf, 8);
    r = Rec::default();
    pwriteln!(r.n, " ", r.name.length());
    r2 = first(&mut buf);
    pwriteln!(r2.name, " ", r2.n);
    set_some(&mut buf, 3);
    dump(&mut buf, 8);
    fill_bytes(&mut r, 8, 1);
    pwriteln!(r.n, " ", r.name.length());
    fill_bytes(&mut buf, 3, 0);
    dump(&mut buf, 8);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
