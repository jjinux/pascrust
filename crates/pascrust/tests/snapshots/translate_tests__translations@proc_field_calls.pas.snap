    pwriteln!(f.get()(&mut n) % 2 != 0, " ", f.get()(&mut n).abs(), " ", f.get()(&mut n).pow(2));
    h.next = IntFunc::of(tick, "Tick");
    pwriteln!(h.next.get()(&mut n).abs(), " ", !h.next.is_nil());
    c.next = IntFunc::of(tick, "Tick");
    c.step(&mut n);
    pwriteln!(c.twice(&mut n));
