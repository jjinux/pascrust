//! Generated by PascRust from `proc_field_calls.pas`. Do not edit by hand.
//! Pascal: `program ProcFieldCalls;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// Procedural fields, elements and pointers called as statements (`H.S;`,
// `with H do S;`, `Arr[1];`, `PS^;`), a parameterless function value in a
// standard function's argument (`Abs(F)`: called), and an object's field
// holding one, used in its methods. Output from fpc -Mtp, except lines 6
// and 7, which it refuses (it doesn't call `F` in `Odd(F)`).

/// Pascal: `procedure`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type Action = ProcVar<fn(&mut i16)>;

/// Pascal: `function: Integer`
type IntFunc = ProcVar<fn(&mut i16) -> i16>;

/// Pascal: `^Action`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PAction = Ptr<Action>;

/// Pascal: `record S: Action; Next: IntFunc; end`
#[derive(Clone, Copy, Debug, Default)]
struct Holder {
    s: Action,
    next: IntFunc,
}

/// Pascal: `Counter = object ... end`
#[derive(Clone, Copy, Debug, Default)]
struct Counter {
    next: IntFunc,
}

/// Pascal: `procedure Hello;`
///
/// Kept in a `Action`, so it takes the globals any `Action` routine uses.
fn hello(calls: &mut i16) {
    *calls += 1;
    pwriteln!("hello ", *calls);
}

/// Pascal: `function Tick: Integer;`
///
/// Kept in a `IntFunc`, so it takes the globals any `IntFunc` routine uses.
fn tick(n: &mut i16) -> i16 {
    let mut result: i16 = 0;
    *n += 1;
    result = *n;
    result
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl Counter {
    /// Pascal: `procedure Counter.Step;`
    ///
    /// The global variables this procedure uses are passed in as parameters,
    /// because the globals are local variables of `pascal_main`.
    fn step(&mut self, n: &mut i16) {
        let mut k: i16 = 0;
        k = self.next.get()(n);
        pwriteln!(k, " ", !self.next.is_nil());
    }

    /// Pascal: `function Counter.Twice: Integer;`
    ///
    /// Uses globals, which are passed in as parameters.
    fn twice(&mut self, n: &mut i16) -> i16 {
        let mut result: i16 = 0;
        result = self.next.get()(n) + self.next.get()(n);
        result
    }
}

/// The main program: the `begin ... end.` block of `ProcFieldCalls`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut h: Holder = Holder::default();
    let mut p: Ptr<Holder> = Ptr::nil();
    let mut arr: PArray<Action, 1, 2> = PArray::default();
    let mut ps: PAction = Ptr::nil();
    let mut f: IntFunc = IntFunc::nil();
    let mut c: Counter = Counter::default();
    let mut n: i16 = 0;
    let mut calls: i16 = 0;
    calls = 0;
    n = 0;
    h.s = Action::of(hello, "Hello");
    h.s.get()(&mut calls);
    // Pascal `with`: Rust has no equivalent, so each field is written out in full.
    h.s.get()(&mut calls);
    p = Ptr::alloc();
    p.get_mut().s = Action::of(hello, "Hello");
    p.get().s.get()(&mut calls);
    arr[1] = Action::of(hello, "Hello");
    arr[1].get()(&mut calls);
    ps = Ptr::alloc();
    *ps.get_mut() = Action::of(hello, "Hello");
    (*ps.get()).get()(&mut calls);
