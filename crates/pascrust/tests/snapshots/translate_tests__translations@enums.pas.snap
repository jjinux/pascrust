//! Generated by PascRust from `enums.pas`. Do not edit by hand.
//! Pascal: `program Enums;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `(Paper, Scissors, Rock)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Choice {
    #[default]
    Paper,
    Scissors,
    Rock,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Choice {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Choice {
    const VALUES: &'static [Self] = &[Choice::Paper, Choice::Scissors, Choice::Rock];
}

/// Pascal: `(Win, Lose, Tie)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Outcome {
    #[default]
    Win,
    Lose,
    Tie,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Outcome {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Outcome {
    const VALUES: &'static [Self] = &[Outcome::Win, Outcome::Lose, Outcome::Tie];
}

/// Pascal: `function Play(mine, theirs: Choice): Outcome;`
fn play(mine: Choice, theirs: Choice) -> Outcome {
    let mut result: Outcome = Outcome::Win;
    if mine == theirs {
        result = Outcome::Tie;
    } else if mine == Choice::Paper && theirs == Choice::Rock
        || mine == Choice::Scissors && theirs == Choice::Paper
        || mine == Choice::Rock && theirs == Choice::Scissors
    {
        result = Outcome::Win;
    } else {
        result = Outcome::Lose;
    }
    result
}

/// Pascal: `procedure Show(c: Choice);`
fn show(c: Choice) {
    match c {
        Choice::Paper => {
            pwrite!("paper");
        }
        Choice::Scissors => {
            pwrite!("scissors");
        }
        Choice::Rock => {
            pwrite!("rock");
        }
    }
}

/// The main program: the `begin ... end.` block of `Enums`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut a: Choice = Choice::Paper;
    let mut b: Choice = Choice::Paper;
    let mut results: PArray<i16, 0, 3> = PArray::default();
    for o in enum_range(Outcome::Win, Outcome::Tie) {
        results[o] = 0;
    }
    // `a` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for a_value in enum_range(Choice::Paper, Choice::Rock) {
        a = a_value;
        for b_value in enum_range(Choice::Paper, Choice::Rock) {
            b = b_value;
            results[play(a, b)] = results[play(a, b)] + 1;
        }
    }
    pwriteln!(results[Outcome::Win], " ", results[Outcome::Lose], " ", results[Outcome::Tie]);
    a = Choice::Paper;
    a = a.succ();
    show(a);
    pwriteln!(" ", a as i16, " ", Choice::Rock as i16);
    b = Choice::from_ord(2);
    show(b.pred());
    pwriteln!();
    if Choice::Rock > Choice::Paper {
        pwriteln!("ordered");
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
