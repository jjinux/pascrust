// ===== src/main.rs =====
//! Generated by PascRust from `pr_turtle.pas`. Do not edit by hand.
//! Pascal: `program PRTurtleTest;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

// Each Pascal unit becomes a Rust module.
mod pr_turtle;

#[allow(unused_imports)]
use crate::pr_turtle::*;
use pascrust_runtime::prelude::*;

// PRTurtle, PascRust's turtle graphics on top of Graph, drawn without a
// window and checked with GetPixel. The expected output is worked out by
// hand (Free Pascal has no PRTurtle). The screen is 640 x 480, so the
// turtle's home (0, 0) is pixel (320, 240), and y goes up.

/// The main program: the `begin ... end.` block of `PRTurtleTest`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut turtle: TTurtleContext = TTurtleContext::default();
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    driver = i16::from(DETECT);
    init_graph(&mut driver, &mut mode, "");
    pwriteln!("home: ", xcor(turtle), " ", ycor(turtle), " ", heading(turtle));
    // A square, north first, turning right.
    for i in 1_i16..=4 {
        forwd(&mut turtle, 100);
        turn_right(&mut turtle, 90);
    }
    pwriteln!(
        "square: ",
        xcor(turtle),
        " ",
        ycor(turtle),
        " ",
        heading(turtle),
        ", ",
        get_pixel(320, 190),
        " ",
        get_pixel(370, 140),
        " ",
        get_pixel(420, 190),
        " ",
        get_pixel(300, 100)
    );
    // Pen up: moving draws nothing.
    pen_up(&mut turtle);
    set_heading(&mut turtle, WEST);
    forwd(&mut turtle, 50);
    pwriteln!("pen up: ", xcor(turtle), " ", get_pixel(295, 240));
    pen_down(&mut turtle);
    set_pen_color(&mut turtle, u16::from(RED));
    back(&mut turtle, 20);
    pwriteln!("back: ", xcor(turtle), " ", get_pixel(280, 240));
    // TurnLeft from north is west; SetPosition moves without drawing.
    set_heading(&mut turtle, NORTH);
    turn_left(&mut turtle, 90);
    pwriteln!("left: ", heading(turtle));
    set_position(&mut turtle, -200, -100);
    pwriteln!("position: ", xcor(turtle), " ", ycor(turtle), " ", get_pixel(170, 290));
    // Wrap: off the right edge, back in on the left.
    wrap(&mut turtle);
    set_position(&mut turtle, 300, 0);
    set_heading(&mut turtle, EAST);
    forwd(&mut turtle, 40);
    pwriteln!("wrap: ", xcor(turtle), " ", turtle_there(&mut turtle), " ", get_pixel(630, 240), " ", get_pixel(5, 240));
    no_wrap(&mut turtle);
    forwd(&mut turtle, 1000);
    pwriteln!("nowrap: ", xcor(turtle), " ", turtle_there(&mut turtle));
    // Wrap from outside the window: the turtle comes back in first, and
    // draws only from there (x = 60 to 70, pixels 380 to 390).
    wrap(&mut turtle);
    set_pen_color(&mut turtle, u16::from(YELLOW));
    forwd(&mut turtle, 10);
    pwriteln!(
        "wrap from outside: ",
        xcor(turtle),
        " ",
        get_pixel(385, 240),
        " ",
        get_pixel(100, 240) != u16::from(YELLOW)
    );
    set_position(&mut turtle, 1000, 0);
    forwd(&mut turtle, 0);
    pwriteln!("forwd(0) outside: ", xcor(turtle));
    no_wrap(&mut turtle);
    // Graph's own colour is left as it was.
    set_color(LIGHT_BLUE);
    forwd(&mut turtle, 5);
    pwriteln!("colour: ", get_color());
    // A turtle window: 100 x 100 around (100, 100); home is its centre.
    turtle_window(&mut turtle, 100, 100, 100, 100);
    set_pen_color(&mut turtle, u16::from(GREEN));
    forwd(&mut turtle, 30);
    pwriteln!("window: ", xcor(turtle), " ", ycor(turtle), " ", get_pixel(0, 50), " ", get_pixel(50, 20));
    // The turtle itself, a triangle with its tip 10 pixels ahead (50, 40)
    // and its back edge 5 behind (50, 55): shown, it's drawn (in XOR);
    // hidden, it's gone.
    clear_screen(&mut turtle);
    show_turtle(&mut turtle);
    pwriteln!("shown: ", get_pixel(50, 40), " ", get_pixel(50, 55));
    hide_turtle(&mut turtle);
    pwriteln!("hidden: ", get_pixel(50, 40), " ", get_pixel(50, 55));
    close_graph();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/pr_turtle.rs =====
//! Generated by PascRust from `PRTurtle.pas`. Do not edit by hand.
//! Pascal: `unit PRTurtle;`

#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

// PRTurtle: turtle graphics on top of the Graph unit, with the routines
// of Turbo Pascal 3.0's turtle (Graph3), so a turtle program can use
// Graph and PRTurtle instead. Part of PascRust (MIT); written in Turbo
// Pascal, so it also compiles in TP 7 itself.
//
// The turtle starts at the centre of its window, heading north (up).
// Headings are in degrees, clockwise: North = 0, East = 90. Turtle
// coordinates have their origin at the window's centre, with y going up.
// Call InitGraph first; the window is the whole screen until
// TurtleWindow says otherwise.

pub const NORTH: i16 = 0;
pub const EAST: i16 = 90;
pub const SOUTH: i16 = 180;
pub const WEST: i16 = 270;

// All the turtle's state, in one record: PascRust passes a unit's
// variables to its routines, so one record makes for one argument.
/// Pascal: `TTurtleContext = record ... end`
#[derive(Clone, Copy, Debug, Default)]
pub struct TTurtleContext {
    pub ready: bool, // the window has been set up
    pub pos_x: f64,
    pub pos_y: f64,     // where the turtle is, in turtle coordinates
    pub dir: f64,       // its heading, in degrees from north
    pub down: bool,     // the pen draws
    pub shown: bool,    // the turtle is drawn
    pub wrapping: bool, // leaving one side comes back on the other
    pub pen: u16,       // the pen's colour
    pub pause: i16,     // milliseconds to wait after each move
    pub win_left: i16,
    pub win_top: i16,
    pub win_width: i16,
    pub win_height: i16,
}

// The whole screen, the first time any routine is called (InitGraph has
// run by then, so GetMaxX knows the screen).
/// Pascal: `procedure Setup;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
pub fn setup(turtle: &mut TTurtleContext) {
    if !turtle.ready {
        turtle.ready = true;
        turtle.win_left = 0;
        turtle.win_top = 0;
        turtle.win_width = get_max_x() + 1;
        turtle.win_height = get_max_y() + 1;
        turtle.pen = get_max_color();
        turtle.down = true;
    }
}

// A turtle point on the screen, relative to the turtle window (which is
// the viewport).
/// Pascal: `function ScreenX(X: Real): Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn screen_x(turtle: TTurtleContext, x: f64) -> i16 {
    let mut result: i16 = 0;
    result = (i32::from(turtle.win_width / 2) + x.round() as i32) as i16;
    result
}

/// Pascal: `function ScreenY(Y: Real): Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn screen_y(turtle: TTurtleContext, y: f64) -> i16 {
    let mut result: i16 = 0;
    result = (i32::from(turtle.win_height / 2) - y.round() as i32) as i16;
    result
}

// Flip a pixel's colour, as XOR mode does for lines.
/// Pascal: `procedure FlipPixel(X, Y: Integer);`
pub fn flip_pixel(x: i16, y: i16) {
    put_pixel(x, y, get_pixel(x, y) ^ get_max_color());
}

// The turtle is a small triangle pointing where it's heading, drawn in
// XOR mode, so drawing it a second time takes it away again. (Two lines
// meet at each corner, which XOR draws twice, clearing it; each corner is
// flipped once more.)
/// Pascal: `procedure DrawTurtle;`
///
/// Uses globals, which are passed in as parameters.
pub fn draw_turtle(turtle: TTurtleContext) {
    let mut a: f64 = 0.0;
    let mut tip_x: f64 = 0.0;
    let mut tip_y: f64 = 0.0;
    let mut left_x: f64 = 0.0;
    let mut left_y: f64 = 0.0;
    let mut right_x: f64 = 0.0;
    let mut right_y: f64 = 0.0;
    let mut old: u16 = 0;
    old = get_color();
    a = turtle.dir * ::std::f64::consts::PI / 180.0;
    tip_x = turtle.pos_x + 10.0 * a.sin();
    tip_y = turtle.pos_y + 10.0 * a.cos();
    left_x = turtle.pos_x + 6.0 * (a - 2.5).sin();
    left_y = turtle.pos_y + 6.0 * (a - 2.5).cos();
    right_x = turtle.pos_x + 6.0 * (a + 2.5).sin();
    right_y = turtle.pos_y + 6.0 * (a + 2.5).cos();
    set_write_mode(XOR_PUT);
    set_color(get_max_color());
    line(screen_x(turtle, tip_x), screen_y(turtle, tip_y), screen_x(turtle, left_x), screen_y(turtle, left_y));
    line(screen_x(turtle, left_x), screen_y(turtle, left_y), screen_x(turtle, right_x), screen_y(turtle, right_y));
    line(screen_x(turtle, right_x), screen_y(turtle, right_y), screen_x(turtle, tip_x), screen_y(turtle, tip_y));
    set_write_mode(NORMAL_PUT);
    flip_pixel(screen_x(turtle, tip_x), screen_y(turtle, tip_y));
    flip_pixel(screen_x(turtle, left_x), screen_y(turtle, left_y));
    flip_pixel(screen_x(turtle, right_x), screen_y(turtle, right_y));
    set_color(old);
}

// Draw from the turtle to (ToX, ToY) if the pen is down, and move there.
/// Pascal: `procedure DrawTo(ToX, ToY: Real);`
///
/// Uses globals, which are passed in as parameters.
pub fn draw_to(turtle: &mut TTurtleContext, to_x: f64, to_y: f64) {
    let mut old: u16 = 0;
    if turtle.down {
        old = get_color();
        set_color(turtle.pen);
        line(
            screen_x(*turtle, turtle.pos_x),
            screen_y(*turtle, turtle.pos_y),
            screen_x(*turtle, to_x),
            screen_y(*turtle, to_y),
        );
        set_color(old);
    }
    turtle.pos_x = to_x;
    turtle.pos_y = to_y;
}

// Move to (ToX, ToY). With Wrap on, a line that leaves the window goes
// on from the opposite side, as often as it has to.
/// Pascal: `procedure MoveTurtle(ToX, ToY: Real);`
///
/// Uses globals, which are passed in as parameters.
pub fn move_turtle(turtle: &mut TTurtleContext, mut to_x: f64, mut to_y: f64) {
    let mut half_w: f64 = 0.0;
    let mut half_h: f64 = 0.0;
    let mut t: f64 = 0.0;
    let mut tx: f64 = 0.0;
    let mut ty: f64 = 0.0;
    let mut dx: f64 = 0.0;
    let mut dy: f64 = 0.0;
    let mut steps: i16 = 0;
    half_w = f64::from(turtle.win_width) / 2.0;
    half_h = f64::from(turtle.win_height) / 2.0;
    steps = 0;
    // A turtle outside the window (it went there with NoWrap) comes
    // back in first, with where it's going.
    if turtle.wrapping {
        while turtle.pos_x > half_w {
            turtle.pos_x -= f64::from(turtle.win_width);
            to_x -= f64::from(turtle.win_width);
        }
        while turtle.pos_x < -half_w {
            turtle.pos_x += f64::from(turtle.win_width);
            to_x += f64::from(turtle.win_width);
        }
        while turtle.pos_y > half_h {
            turtle.pos_y -= f64::from(turtle.win_height);
            to_y -= f64::from(turtle.win_height);
        }
        while turtle.pos_y < -half_h {
            turtle.pos_y += f64::from(turtle.win_height);
            to_y += f64::from(turtle.win_height);
        }
    }
    while turtle.wrapping && (to_x.abs() > half_w || to_y.abs() > half_h) && steps < 100 {
        // Where the line first meets the window's edge: a fraction T of
        // the way there.
        dx = to_x - turtle.pos_x;
        dy = to_y - turtle.pos_y;
        tx = 2.0;
        ty = 2.0;
        if dx > 0.0 {
            tx = (half_w - turtle.pos_x) / dx;
        } else if dx < 0.0 {
            tx = (-half_w - turtle.pos_x) / dx;
        }
        if dy > 0.0 {
            ty = (half_h - turtle.pos_y) / dy;
        } else if dy < 0.0 {
            ty = (-half_h - turtle.pos_y) / dy;
        }
        if tx < ty {
            t = tx;
        } else {
            t = ty;
        }
        draw_to(turtle, turtle.pos_x + t * dx, turtle.pos_y + t * dy);
        // Come back in on the other side (of an edge it moves across).
        if t == tx && dx != 0.0 {
            if dx > 0.0 {
                turtle.pos_x -= f64::from(turtle.win_width);
                to_x -= f64::from(turtle.win_width);
            } else {
                turtle.pos_x += f64::from(turtle.win_width);
                to_x += f64::from(turtle.win_width);
            }
        } else if dy > 0.0 {
            turtle.pos_y -= f64::from(turtle.win_height);
            to_y -= f64::from(turtle.win_height);
        } else {
            turtle.pos_y += f64::from(turtle.win_height);
            to_y += f64::from(turtle.win_height);
        }
        steps += 1;
    }
    draw_to(turtle, to_x, to_y);
}

/// Pascal: `procedure Forwd(Dist: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn forwd(turtle: &mut TTurtleContext, dist: i16) {
    let mut a: f64 = 0.0;
    setup(turtle);
    if turtle.shown {
        draw_turtle(*turtle);
    }
    a = turtle.dir * ::std::f64::consts::PI / 180.0;
    move_turtle(turtle, turtle.pos_x + f64::from(dist) * a.sin(), turtle.pos_y + f64::from(dist) * a.cos());
    if turtle.shown {
        draw_turtle(*turtle);
    }
    if turtle.pause > 0 {
        delay(turtle.pause);
    }
}

/// Pascal: `procedure Back(Dist: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn back(turtle: &mut TTurtleContext, dist: i16) {
    forwd(turtle, -dist);
}

// An angle kept between 0 and 360.
/// Pascal: `function Normal(A: Real): Real;`
pub fn normal(mut a: f64) -> f64 {
    let mut result: f64 = 0.0;
    while a < 0.0 {
        a += 360.0;
    }
    while a >= 360.0 {
        a -= 360.0;
    }
    result = a;
    result
}

/// Pascal: `procedure Turn(Angle: Real);`
///
/// Uses globals, which are passed in as parameters.
pub fn turn(turtle: &mut TTurtleContext, angle: f64) {
    setup(turtle);
    if turtle.shown {
        draw_turtle(*turtle);
    }
    turtle.dir = normal(turtle.dir + angle);
    if turtle.shown {
        draw_turtle(*turtle);
    }
}

/// Pascal: `procedure TurnLeft(Angle: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turn_left(turtle: &mut TTurtleContext, angle: i16) {
    turn(turtle, f64::from(-angle));
}

/// Pascal: `procedure TurnRight(Angle: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turn_right(turtle: &mut TTurtleContext, angle: i16) {
    turn(turtle, f64::from(angle));
}

/// Pascal: `procedure SetHeading(Angle: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn set_heading(turtle: &mut TTurtleContext, angle: i16) {
    turn(turtle, normal(f64::from(angle)) - turtle.dir);
}

/// Pascal: `function Heading: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn heading(turtle: TTurtleContext) -> i16 {
    let mut result: i16 = 0;
    result = (turtle.dir.round() as i32 % 360) as i16;
    result
}

/// Pascal: `procedure SetPosition(X, Y: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn set_position(turtle: &mut TTurtleContext, x: i16, y: i16) {
    setup(turtle);
    if turtle.shown {
        draw_turtle(*turtle);
    }
    turtle.pos_x = f64::from(x);
    turtle.pos_y = f64::from(y);
    if turtle.shown {
        draw_turtle(*turtle);
    }
}

/// Pascal: `function Xcor: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn xcor(turtle: TTurtleContext) -> i16 {
    let mut result: i16 = 0;
    result = turtle.pos_x.round() as i32 as i16;
    result
}

/// Pascal: `function Ycor: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn ycor(turtle: TTurtleContext) -> i16 {
    let mut result: i16 = 0;
    result = turtle.pos_y.round() as i32 as i16;
    result
}

/// Pascal: `procedure Home;`
///
/// Uses globals, which are passed in as parameters.
pub fn home(turtle: &mut TTurtleContext) {
    setup(turtle);
    if turtle.shown {
        draw_turtle(*turtle);
    }
    turtle.pos_x = 0.0;
    turtle.pos_y = 0.0;
    turtle.dir = f64::from(NORTH);
    if turtle.shown {
        draw_turtle(*turtle);
    }
}

/// Pascal: `procedure ClearScreen;`
///
/// Uses globals, which are passed in as parameters.
pub fn clear_screen(turtle: &mut TTurtleContext) {
    setup(turtle);
    clear_view_port();
    turtle.shown = false;
    home(turtle);
}

/// Pascal: `procedure PenDown;`
///
/// Uses globals, which are passed in as parameters.
pub fn pen_down(turtle: &mut TTurtleContext) {
    setup(turtle);
    turtle.down = true;
}

/// Pascal: `procedure PenUp;`
///
/// Uses globals, which are passed in as parameters.
pub fn pen_up(turtle: &mut TTurtleContext) {
    setup(turtle);
    turtle.down = false;
}

/// Pascal: `procedure SetPenColor(Color: Word);`
///
/// Uses globals, which are passed in as parameters.
pub fn set_pen_color(turtle: &mut TTurtleContext, color: u16) {
    setup(turtle);
    turtle.pen = color;
}

/// Pascal: `procedure ShowTurtle;`
///
/// Uses globals, which are passed in as parameters.
pub fn show_turtle(turtle: &mut TTurtleContext) {
    setup(turtle);
    if !turtle.shown {
        turtle.shown = true;
        draw_turtle(*turtle);
    }
}

/// Pascal: `procedure HideTurtle;`
///
/// Uses globals, which are passed in as parameters.
pub fn hide_turtle(turtle: &mut TTurtleContext) {
    setup(turtle);
    if turtle.shown {
        draw_turtle(*turtle);
        turtle.shown = false;
    }
}

/// Pascal: `procedure Wrap;`
///
/// Uses globals, which are passed in as parameters.
pub fn wrap(turtle: &mut TTurtleContext) {
    turtle.wrapping = true;
}

/// Pascal: `procedure NoWrap;`
///
/// Uses globals, which are passed in as parameters.
pub fn no_wrap(turtle: &mut TTurtleContext) {
    turtle.wrapping = false;
}

/// Pascal: `procedure TurtleDelay(Ms: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turtle_delay(turtle: &mut TTurtleContext, ms: i16) {
    turtle.pause = ms;
}

/// Pascal: `function TurtleThere: Boolean;`
///
/// Uses globals, which are passed in as parameters.
pub fn turtle_there(turtle: &mut TTurtleContext) -> bool {
    let mut result: bool = false;
    setup(turtle);
    result = turtle.pos_x.abs() <= f64::from(turtle.win_width) / 2.0
        && turtle.pos_y.abs() <= f64::from(turtle.win_height) / 2.0;
    result
}

// The turtle's window: W by H pixels with its centre at (X, Y) on the
// screen. It's the viewport, so lines are clipped to it, and the turtle
// goes home.
/// Pascal: `procedure TurtleWindow(X, Y, W, H: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turtle_window(turtle: &mut TTurtleContext, x: i16, y: i16, w_: i16, h: i16) {
    setup(turtle);
    hide_turtle(turtle);
    turtle.win_left = x - w_ / 2;
    turtle.win_top = y - h / 2;
    turtle.win_width = w_;
    turtle.win_height = h;
    set_view_port(turtle.win_left, turtle.win_top, turtle.win_left + w_ - 1, turtle.win_top + h - 1, CLIP_ON);
    home(turtle);
}
