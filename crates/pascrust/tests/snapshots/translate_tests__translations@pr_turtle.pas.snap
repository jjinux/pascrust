// ===== src/main.rs =====
//! Generated by PascRust from `pr_turtle.pas`. Do not edit by hand.
//! Pascal: `program PRTurtleTest;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod pr_turtle;

#[allow(unused_imports)]
use crate::pr_turtle::*;
use pascrust_runtime::prelude::*;

// PRTurtle, PascRust's turtle graphics on top of Graph, drawn without a
// window and checked with GetPixel. The expected output is worked out by
// hand (Free Pascal has no PRTurtle). The screen is 640 x 480, so the
// turtle's home (0, 0) is pixel (320, 240), and y goes up.

/// The main program: the `begin ... end.` block of `PRTurtleTest`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut ready: bool = false; // the window has been set up
    let mut pos_x: f64 = 0.0;
    let mut pos_y: f64 = 0.0; // where the turtle is, in turtle coordinates
    let mut dir: f64 = 0.0; // its heading, in degrees from north
    let mut down: bool = false; // the pen draws
    let mut shown: bool = false; // the turtle is drawn
    let mut wrapping: bool = false; // leaving one side comes back on the other
    let mut pen: u16 = 0; // the pen's colour
    let pause: i16 = 0; // milliseconds to wait after each move
    let mut win_left: i16 = 0;
    let mut win_top: i16 = 0;
    let mut win_width: i16 = 0;
    let mut win_height: i16 = 0;
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    driver = i16::from(DETECT);
    init_graph(&mut driver, &mut mode, "");
    pwriteln!("home: ", xcor(pos_x), " ", ycor(pos_y), " ", heading(dir));
    // A square, north first, turning right.
    for i in 1_i16..=4 {
        forwd(
            &mut ready,
            &mut pos_x,
            &mut pos_y,
            dir,
            &mut down,
            shown,
            wrapping,
            &mut pen,
            pause,
            &mut win_left,
            &mut win_top,
            &mut win_width,
            &mut win_height,
            100,
        );
        turn_right(
            &mut ready,
            pos_x,
            pos_y,
            &mut dir,
            &mut down,
            shown,
            &mut pen,
            &mut win_left,
            &mut win_top,
            &mut win_width,
            &mut win_height,
            90,
        );
    }
    pwriteln!(
        "square: ",
        xcor(pos_x),
        " ",
        ycor(pos_y),
        " ",
        heading(dir),
        ", ",
        get_pixel(320, 190),
        " ",
        get_pixel(370, 140),
        " ",
        get_pixel(420, 190),
        " ",
        get_pixel(300, 100)
    );
    // Pen up: moving draws nothing.
    pen_up(&mut ready, &mut down, &mut pen, &mut win_left, &mut win_top, &mut win_width, &mut win_height);
    set_heading(
        &mut ready,
        pos_x,
        pos_y,
        &mut dir,
        &mut down,
        shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        WEST,
    );
    forwd(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        wrapping,
        &mut pen,
        pause,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        50,
    );
    pwriteln!("pen up: ", xcor(pos_x), " ", get_pixel(295, 240));
    pen_down(&mut ready, &mut down, &mut pen, &mut win_left, &mut win_top, &mut win_width, &mut win_height);
    set_pen_color(
        &mut ready,
        &mut down,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        u16::from(RED),
    );
    back(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        wrapping,
        &mut pen,
        pause,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        20,
    );
    pwriteln!("back: ", xcor(pos_x), " ", get_pixel(280, 240));
    // TurnLeft from north is west; SetPosition moves without drawing.
    set_heading(
        &mut ready,
        pos_x,
        pos_y,
        &mut dir,
        &mut down,
        shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        NORTH,
    );
    turn_left(
        &mut ready,
        pos_x,
        pos_y,
        &mut dir,
        &mut down,
        shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        90,
    );
    pwriteln!("left: ", heading(dir));
    set_position(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        -200,
        -100,
    );
    pwriteln!("position: ", xcor(pos_x), " ", ycor(pos_y), " ", get_pixel(170, 290));
    // Wrap: off the right edge, back in on the left.
    wrap(&mut wrapping);
    set_position(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        300,
        0,
    );
    set_heading(
        &mut ready,
        pos_x,
        pos_y,
        &mut dir,
        &mut down,
        shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        EAST,
    );
    forwd(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        wrapping,
        &mut pen,
        pause,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        40,
    );
    pwriteln!(
        "wrap: ",
        xcor(pos_x),
        " ",
        turtle_there(
            &mut ready,
            pos_x,
            pos_y,
            &mut down,
            &mut pen,
            &mut win_left,
            &mut win_top,
            &mut win_width,
            &mut win_height
        ),
        " ",
        get_pixel(630, 240),
        " ",
        get_pixel(5, 240)
    );
    no_wrap(&mut wrapping);
    forwd(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        wrapping,
        &mut pen,
        pause,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        1000,
    );
    pwriteln!(
        "nowrap: ",
        xcor(pos_x),
        " ",
        turtle_there(
            &mut ready,
            pos_x,
            pos_y,
            &mut down,
            &mut pen,
            &mut win_left,
            &mut win_top,
            &mut win_width,
            &mut win_height
        )
    );
    // A turtle window: 100 x 100 around (100, 100); home is its centre.
    turtle_window(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        &mut dir,
        &mut down,
        &mut shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        100,
        100,
        100,
        100,
    );
    set_pen_color(
        &mut ready,
        &mut down,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        u16::from(GREEN),
    );
    forwd(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        dir,
        &mut down,
        shown,
        wrapping,
        &mut pen,
        pause,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
        30,
    );
    pwriteln!("window: ", xcor(pos_x), " ", ycor(pos_y), " ", get_pixel(0, 50), " ", get_pixel(50, 20));
    // The turtle itself, a triangle with its tip 10 pixels ahead (50, 40)
    // and its back edge 5 behind (50, 55): shown, it's drawn (in XOR);
    // hidden, it's gone.
    clear_screen(
        &mut ready,
        &mut pos_x,
        &mut pos_y,
        &mut dir,
        &mut down,
        &mut shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
    );
    show_turtle(
        &mut ready,
        pos_x,
        pos_y,
        dir,
        &mut down,
        &mut shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
    );
    pwriteln!("shown: ", get_pixel(50, 40), " ", get_pixel(50, 55));
    hide_turtle(
        &mut ready,
        pos_x,
        pos_y,
        dir,
        &mut down,
        &mut shown,
        &mut pen,
        &mut win_left,
        &mut win_top,
        &mut win_width,
        &mut win_height,
    );
    pwriteln!("hidden: ", get_pixel(50, 40), " ", get_pixel(50, 55));
    close_graph();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/pr_turtle.rs =====
//! Generated by PascRust from `PRTurtle.pas`. Do not edit by hand.
//! Pascal: `unit PRTurtle;`

#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

// PRTurtle: turtle graphics on top of the Graph unit, with the routines
// of Turbo Pascal 3.0's turtle (Graph3), so a turtle program can use
// Graph and PRTurtle instead. Part of PascRust (MIT); written in Turbo
// Pascal, so it also compiles in TP 7 itself.
//
// The turtle starts at the centre of its window, heading north (up).
// Headings are in degrees, clockwise: North = 0, East = 90. Turtle
// coordinates have their origin at the window's centre, with y going up.
// Call InitGraph first; the window is the whole screen until
// TurtleWindow says otherwise.

pub const NORTH: i16 = 0;
pub const EAST: i16 = 90;
pub const SOUTH: i16 = 180;
pub const WEST: i16 = 270;

// The whole screen, the first time any routine is called (InitGraph has
// run by then, so GetMaxX knows the screen).
/// Pascal: `procedure Setup;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
pub fn setup(
    ready: &mut bool,
    down: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    if !*ready {
        *ready = true;
        *win_left = 0;
        *win_top = 0;
        *win_width = get_max_x() + 1;
        *win_height = get_max_y() + 1;
        *pen = get_max_color();
        *down = true;
    }
}

// A turtle point on the screen, relative to the turtle window (which is
// the viewport).
/// Pascal: `function ScreenX(X: Real): Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn screen_x(win_width: i16, x: f64) -> i16 {
    let mut result: i16 = 0;
    result = (i32::from(win_width / 2) + x.round() as i32) as i16;
    result
}

/// Pascal: `function ScreenY(Y: Real): Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn screen_y(win_height: i16, y: f64) -> i16 {
    let mut result: i16 = 0;
    result = (i32::from(win_height / 2) - y.round() as i32) as i16;
    result
}

// Flip a pixel's colour, as XOR mode does for lines.
/// Pascal: `procedure FlipPixel(X, Y: Integer);`
pub fn flip_pixel(x: i16, y: i16) {
    put_pixel(x, y, get_pixel(x, y) ^ get_max_color());
}

// The turtle is a small triangle pointing where it's heading, drawn in
// XOR mode, so drawing it a second time takes it away again. (Two lines
// meet at each corner, which XOR draws twice, clearing it; each corner is
// flipped once more.)
/// Pascal: `procedure DrawTurtle;`
///
/// Uses globals, which are passed in as parameters.
pub fn draw_turtle(pos_x: f64, pos_y: f64, dir: f64, win_width: i16, win_height: i16) {
    let mut a: f64 = 0.0;
    let mut tip_x: f64 = 0.0;
    let mut tip_y: f64 = 0.0;
    let mut left_x: f64 = 0.0;
    let mut left_y: f64 = 0.0;
    let mut right_x: f64 = 0.0;
    let mut right_y: f64 = 0.0;
    a = dir * ::std::f64::consts::PI / 180.0;
    tip_x = pos_x + 10.0 * a.sin();
    tip_y = pos_y + 10.0 * a.cos();
    left_x = pos_x + 6.0 * (a - 2.5).sin();
    left_y = pos_y + 6.0 * (a - 2.5).cos();
    right_x = pos_x + 6.0 * (a + 2.5).sin();
    right_y = pos_y + 6.0 * (a + 2.5).cos();
    set_write_mode(XOR_PUT);
    set_color(get_max_color());
    line(
        screen_x(win_width, tip_x),
        screen_y(win_height, tip_y),
        screen_x(win_width, left_x),
        screen_y(win_height, left_y),
    );
    line(
        screen_x(win_width, left_x),
        screen_y(win_height, left_y),
        screen_x(win_width, right_x),
        screen_y(win_height, right_y),
    );
    line(
        screen_x(win_width, right_x),
        screen_y(win_height, right_y),
        screen_x(win_width, tip_x),
        screen_y(win_height, tip_y),
    );
    set_write_mode(NORMAL_PUT);
    flip_pixel(screen_x(win_width, tip_x), screen_y(win_height, tip_y));
    flip_pixel(screen_x(win_width, left_x), screen_y(win_height, left_y));
    flip_pixel(screen_x(win_width, right_x), screen_y(win_height, right_y));
}

// Draw from the turtle to (ToX, ToY) if the pen is down, and move there.
/// Pascal: `procedure DrawTo(ToX, ToY: Real);`
///
/// Uses globals, which are passed in as parameters.
pub fn draw_to(
    pos_x: &mut f64,
    pos_y: &mut f64,
    down: bool,
    pen: u16,
    win_width: i16,
    win_height: i16,
    to_x: f64,
    to_y: f64,
) {
    if down {
        set_color(pen);
        line(
            screen_x(win_width, *pos_x),
            screen_y(win_height, *pos_y),
            screen_x(win_width, to_x),
            screen_y(win_height, to_y),
        );
    }
    *pos_x = to_x;
    *pos_y = to_y;
}

// Move to (ToX, ToY). With Wrap on, a line that leaves the window goes
// on from the opposite side, as often as it has to.
/// Pascal: `procedure MoveTurtle(ToX, ToY: Real);`
///
/// Uses globals, which are passed in as parameters.
pub fn move_turtle(
    pos_x: &mut f64,
    pos_y: &mut f64,
    down: bool,
    wrapping: bool,
    pen: u16,
    win_width: i16,
    win_height: i16,
    mut to_x: f64,
    mut to_y: f64,
) {
    let mut half_w: f64 = 0.0;
    let mut half_h: f64 = 0.0;
    let mut t: f64 = 0.0;
    let mut tx: f64 = 0.0;
    let mut ty: f64 = 0.0;
    let mut dx: f64 = 0.0;
    let mut dy: f64 = 0.0;
    let mut steps: i16 = 0;
    half_w = f64::from(win_width) / 2.0;
    half_h = f64::from(win_height) / 2.0;
    steps = 0;
    while wrapping && (to_x.abs() > half_w || to_y.abs() > half_h) && steps < 100 {
        // Where the line first meets the window's edge: a fraction T of
        // the way there.
        dx = to_x - *pos_x;
        dy = to_y - *pos_y;
        tx = 2.0;
        ty = 2.0;
        if dx > 0.0 {
            tx = (half_w - *pos_x) / dx;
        } else if dx < 0.0 {
            tx = (-half_w - *pos_x) / dx;
        }
        if dy > 0.0 {
            ty = (half_h - *pos_y) / dy;
        } else if dy < 0.0 {
            ty = (-half_h - *pos_y) / dy;
        }
        if tx < ty {
            t = tx;
        } else {
            t = ty;
        }
        draw_to(pos_x, pos_y, down, pen, win_width, win_height, *pos_x + t * dx, *pos_y + t * dy);
        // Come back in on the other side.
        if t == tx {
            if dx > 0.0 {
                *pos_x -= f64::from(win_width);
                to_x -= f64::from(win_width);
            } else {
                *pos_x += f64::from(win_width);
                to_x += f64::from(win_width);
            }
        } else if dy > 0.0 {
            *pos_y -= f64::from(win_height);
            to_y -= f64::from(win_height);
        } else {
            *pos_y += f64::from(win_height);
            to_y += f64::from(win_height);
        }
        steps += 1;
    }
    draw_to(pos_x, pos_y, down, pen, win_width, win_height, to_x, to_y);
}

/// Pascal: `procedure Forwd(Dist: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn forwd(
    ready: &mut bool,
    pos_x: &mut f64,
    pos_y: &mut f64,
    dir: f64,
    down: &mut bool,
    shown: bool,
    wrapping: bool,
    pen: &mut u16,
    pause: i16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    dist: i16,
) {
    let mut a: f64 = 0.0;
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    if shown {
        draw_turtle(*pos_x, *pos_y, dir, *win_width, *win_height);
    }
    a = dir * ::std::f64::consts::PI / 180.0;
    move_turtle(
        pos_x,
        pos_y,
        *down,
        wrapping,
        *pen,
        *win_width,
        *win_height,
        *pos_x + f64::from(dist) * a.sin(),
        *pos_y + f64::from(dist) * a.cos(),
    );
    if shown {
        draw_turtle(*pos_x, *pos_y, dir, *win_width, *win_height);
    }
    if pause > 0 {
        delay(pause);
    }
}

/// Pascal: `procedure Back(Dist: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn back(
    ready: &mut bool,
    pos_x: &mut f64,
    pos_y: &mut f64,
    dir: f64,
    down: &mut bool,
    shown: bool,
    wrapping: bool,
    pen: &mut u16,
    pause: i16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    dist: i16,
) {
    forwd(ready, pos_x, pos_y, dir, down, shown, wrapping, pen, pause, win_left, win_top, win_width, win_height, -dist);
}

// An angle kept between 0 and 360.
/// Pascal: `function Normal(A: Real): Real;`
pub fn normal(mut a: f64) -> f64 {
    let mut result: f64 = 0.0;
    while a < 0.0 {
        a += 360.0;
    }
    while a >= 360.0 {
        a -= 360.0;
    }
    result = a;
    result
}

/// Pascal: `procedure Turn(Angle: Real);`
///
/// Uses globals, which are passed in as parameters.
pub fn turn(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    dir: &mut f64,
    down: &mut bool,
    shown: bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    angle: f64,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    if shown {
        draw_turtle(pos_x, pos_y, *dir, *win_width, *win_height);
    }
    *dir = normal(*dir + angle);
    if shown {
        draw_turtle(pos_x, pos_y, *dir, *win_width, *win_height);
    }
}

/// Pascal: `procedure TurnLeft(Angle: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turn_left(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    dir: &mut f64,
    down: &mut bool,
    shown: bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    angle: i16,
) {
    turn(ready, pos_x, pos_y, dir, down, shown, pen, win_left, win_top, win_width, win_height, f64::from(-angle));
}

/// Pascal: `procedure TurnRight(Angle: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turn_right(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    dir: &mut f64,
    down: &mut bool,
    shown: bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    angle: i16,
) {
    turn(ready, pos_x, pos_y, dir, down, shown, pen, win_left, win_top, win_width, win_height, f64::from(angle));
}

/// Pascal: `procedure SetHeading(Angle: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn set_heading(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    dir: &mut f64,
    down: &mut bool,
    shown: bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    angle: i16,
) {
    turn(
        ready,
        pos_x,
        pos_y,
        dir,
        down,
        shown,
        pen,
        win_left,
        win_top,
        win_width,
        win_height,
        normal(f64::from(angle)) - *dir,
    );
}

/// Pascal: `function Heading: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn heading(dir: f64) -> i16 {
    let mut result: i16 = 0;
    result = (dir.round() as i32 % 360) as i16;
    result
}

/// Pascal: `procedure SetPosition(X, Y: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn set_position(
    ready: &mut bool,
    pos_x: &mut f64,
    pos_y: &mut f64,
    dir: f64,
    down: &mut bool,
    shown: bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    x: i16,
    y: i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    if shown {
        draw_turtle(*pos_x, *pos_y, dir, *win_width, *win_height);
    }
    *pos_x = f64::from(x);
    *pos_y = f64::from(y);
    if shown {
        draw_turtle(*pos_x, *pos_y, dir, *win_width, *win_height);
    }
}

/// Pascal: `function Xcor: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn xcor(pos_x: f64) -> i16 {
    let mut result: i16 = 0;
    result = pos_x.round() as i32 as i16;
    result
}

/// Pascal: `function Ycor: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn ycor(pos_y: f64) -> i16 {
    let mut result: i16 = 0;
    result = pos_y.round() as i32 as i16;
    result
}

/// Pascal: `procedure Home;`
///
/// Uses globals, which are passed in as parameters.
pub fn home(
    ready: &mut bool,
    pos_x: &mut f64,
    pos_y: &mut f64,
    dir: &mut f64,
    down: &mut bool,
    shown: bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    if shown {
        draw_turtle(*pos_x, *pos_y, *dir, *win_width, *win_height);
    }
    *pos_x = 0.0;
    *pos_y = 0.0;
    *dir = f64::from(NORTH);
    if shown {
        draw_turtle(*pos_x, *pos_y, *dir, *win_width, *win_height);
    }
}

/// Pascal: `procedure ClearScreen;`
///
/// Uses globals, which are passed in as parameters.
pub fn clear_screen(
    ready: &mut bool,
    pos_x: &mut f64,
    pos_y: &mut f64,
    dir: &mut f64,
    down: &mut bool,
    shown: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    clear_view_port();
    *shown = false;
    home(ready, pos_x, pos_y, dir, down, *shown, pen, win_left, win_top, win_width, win_height);
}

/// Pascal: `procedure PenDown;`
///
/// Uses globals, which are passed in as parameters.
pub fn pen_down(
    ready: &mut bool,
    down: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    *down = true;
}

/// Pascal: `procedure PenUp;`
///
/// Uses globals, which are passed in as parameters.
pub fn pen_up(
    ready: &mut bool,
    down: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    *down = false;
}

/// Pascal: `procedure SetPenColor(Color: Word);`
///
/// Uses globals, which are passed in as parameters.
pub fn set_pen_color(
    ready: &mut bool,
    down: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    color: u16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    *pen = color;
}

/// Pascal: `procedure ShowTurtle;`
///
/// Uses globals, which are passed in as parameters.
pub fn show_turtle(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    dir: f64,
    down: &mut bool,
    shown: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    if !*shown {
        *shown = true;
        draw_turtle(pos_x, pos_y, dir, *win_width, *win_height);
    }
}

/// Pascal: `procedure HideTurtle;`
///
/// Uses globals, which are passed in as parameters.
pub fn hide_turtle(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    dir: f64,
    down: &mut bool,
    shown: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    if *shown {
        draw_turtle(pos_x, pos_y, dir, *win_width, *win_height);
        *shown = false;
    }
}

/// Pascal: `procedure Wrap;`
///
/// Uses globals, which are passed in as parameters.
pub fn wrap(wrapping: &mut bool) {
    *wrapping = true;
}

/// Pascal: `procedure NoWrap;`
///
/// Uses globals, which are passed in as parameters.
pub fn no_wrap(wrapping: &mut bool) {
    *wrapping = false;
}

/// Pascal: `procedure TurtleDelay(Ms: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turtle_delay(pause: &mut i16, ms: i16) {
    *pause = ms;
}

/// Pascal: `function TurtleThere: Boolean;`
///
/// Uses globals, which are passed in as parameters.
pub fn turtle_there(
    ready: &mut bool,
    pos_x: f64,
    pos_y: f64,
    down: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
) -> bool {
    let mut result: bool = false;
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    result = pos_x.abs() <= f64::from(*win_width) / 2.0 && pos_y.abs() <= f64::from(*win_height) / 2.0;
    result
}

// The turtle's window: W by H pixels with its centre at (X, Y) on the
// screen. It's the viewport, so lines are clipped to it, and the turtle
// goes home.
/// Pascal: `procedure TurtleWindow(X, Y, W, H: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn turtle_window(
    ready: &mut bool,
    pos_x: &mut f64,
    pos_y: &mut f64,
    dir: &mut f64,
    down: &mut bool,
    shown: &mut bool,
    pen: &mut u16,
    win_left: &mut i16,
    win_top: &mut i16,
    win_width: &mut i16,
    win_height: &mut i16,
    x: i16,
    y: i16,
    w_: i16,
    h: i16,
) {
    setup(ready, down, pen, win_left, win_top, win_width, win_height);
    hide_turtle(ready, *pos_x, *pos_y, *dir, down, shown, pen, win_left, win_top, win_width, win_height);
    *win_left = x - w_ / 2;
    *win_top = y - h / 2;
    *win_width = w_;
    *win_height = h;
    set_view_port(*win_left, *win_top, *win_left + w_ - 1, *win_top + h - 1, CLIP_ON);
    home(ready, pos_x, pos_y, dir, down, *shown, pen, win_left, win_top, win_width, win_height);
}
