//! Generated by PascRust from `case_guards.pas`. Do not edit by hand.
//! Pascal: `program CaseGuards;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// A case label worked out from a constant (K + 1) can't be a Rust
// pattern: its arm tests it in a guard, keeping the name.

const K: i16 = 5;
const L: i16 = 9;

/// The main program: the `begin ... end.` block of `CaseGuards`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut n: i32 = 0;
    let mut c: u8 = 0;
    for i in 1_i16..=16 {
        match i {
            value if value == 1 || value == K + 1 => {
                pwrite!("a");
            }
            value if (K * 2..=K * 3).contains(&value) => {
                pwrite!("b");
            }
            L => {
                pwrite!("c");
            }
            value if (K + 2..=L - 1).contains(&value) => {
                pwrite!("d");
            }
            _ => {
                pwrite!(".");
            }
        }
    }
    pwriteln!();
    n = 5;
    match n {
        value if value == i32::from(K) => {
            pwriteln!("n K");
        }
        value if value == i32::from(L) + 1 => {
            pwriteln!("n L + 1");
        }
        _ => {}
    }
    c = b'f';
    match c {
        value if value == (i16::from(b'a') + K) as u8 => {
            pwriteln!("f");
        }
        _ => {}
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
