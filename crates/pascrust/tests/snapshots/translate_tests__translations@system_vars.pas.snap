//! Generated by pascrust from `system_vars.pas`. Do not edit by hand.
//! Pascal: `program SystemVars;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if !ok {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `SystemVars`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut first: i16 = 0;
    let mut second: i16 = 0;
    let mut n: i16 = 0;
    let mut f: PFile<i16> = PFile::default();
    checks = 0;
    failures = 0;
    set_rand_seed(1234);
    first = random(1000);
    set_rand_seed(1234);
    second = random(1000);
    check(&mut checks, &mut failures, first == second, pstr("RandSeed repeats a sequence"));
    check(&mut checks, &mut failures, rand_seed() != 1234, pstr("Random moves RandSeed on"));
    check(&mut checks, &mut failures, i16::from(file_mode()) == 2, pstr("FileMode starts at 2"));
    f.assign("system_vars.tmp");
    f.rewrite();
    n = 7;
    f.write(&n);
    f.close();
    set_file_mode(0);
    f.reset();
    f.read(&mut n);
    f.close();
    f.erase();
    set_file_mode(2);
    check(&mut checks, &mut failures, n == 7, pstr("Reset with FileMode 0 reads"));
    pwrite!("to ");
    pwriteln!("Output");
    preadln!(&mut n);
    check(&mut checks, &mut failures, n == 42, pstr("ReadLn(Input, ...)"));
    check(&mut checks, &mut failures, eof(), pstr("Eof(Input)"));
    check(&mut checks, &mut failures, exit_code() == 0, pstr("ExitCode starts at 0"));
    set_exit_code(3);
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
