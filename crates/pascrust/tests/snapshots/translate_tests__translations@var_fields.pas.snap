//! Generated by pascrust from `var_fields.pas`. Do not edit by hand.
//! Pascal: `program VarFields;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `record x, y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Point {
    x: i16,
    y: i16,
}

/// Pascal: `record center: Point; radius: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Circle {
    center: Point,
    radius: i16,
}

/// Pascal: `object center: Point; radius: Integer; procedure Init; end`
#[derive(Clone, Copy, Debug, Default)]
struct Shape {
    center: Point,
    radius: i16,
}

/// Pascal: `^Point`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PPoint = Ptr<Point>;

/// Pascal: `record a: array[1..2] of Integer; y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct TPair {
    a: PArray<i16, 1, 2>,
    y: i16,
}

/// Pascal: `^TPair`
type PPair = Ptr<TPair>;

/// Pascal: `procedure SetTwo(var a, b: Integer);`
fn set_two(a: &mut i16, b: &mut i16) {
    *a = 1;
    *b = 2;
}

/// Pascal: `function Swapped(var a, b: Integer): Boolean;`
fn swapped(a: &mut i16, b: &mut i16) -> bool {
    let mut result: bool = false;
    let mut t: i16 = 0;
    t = *a;
    *a = *b;
    *b = t;
    result = *a != *b;
    result
}

/// Pascal: `procedure Fill(var pt: Point);`
fn fill(pt: &mut Point) {
    set_two(&mut pt.x, &mut pt.y);
}

/// Pascal: `procedure Local;`
fn local() {
    let mut r: Circle = Circle::default();
    set_two(&mut r.center.y, &mut r.radius);
    pwriteln!(r.center.y, " ", r.radius);
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl Shape {
    /// Pascal: `procedure Shape.Init;`
    fn init(&mut self) {
        set_two(&mut self.center.x, &mut self.radius);
    }
}

/// The main program: the `begin ... end.` block of `VarFields`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: Point = Point::default();
    let mut c: Circle = Circle::default();
    let mut s: Shape = Shape::default();
    let mut q: PPoint = Ptr::nil();
    let mut points: PArray<PPoint, 1, 3> = PArray::default();
    let mut pair: PPair = Ptr::nil();
    let mut k: i16 = 0;
    set_two(&mut p.x, &mut p.y);
    pwriteln!(p.x, " ", p.y);
    set_two(&mut c.center.x, &mut c.radius);
    pwriteln!(c.center.x, " ", c.radius);
    p.x = 0;
    fill(&mut p);
    pwriteln!(p.x, " ", p.y);
    s.init();
    pwriteln!(s.center.x, " ", s.radius);
    local();
    q = Ptr::alloc();
    q.with_mut(|point| set_two(&mut point.x, &mut point.y));
    pwriteln!(q.get().x, " ", q.get().y);
    if q.with_mut(|point| swapped(&mut point.x, &mut point.y)) {
        pwriteln!(q.get().x, " ", q.get().y);
    }
    q.dispose();
    // `k` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for k_value in 1..=3 {
        k = k_value;
        points[k] = Ptr::alloc();
    }
    k = 2;
    points[k].with_mut(|point| set_two(&mut point.x, &mut point.y));
    pwriteln!(points[2].get().x, " ", points[2].get().y);
    pair = Ptr::alloc();
    pair.with_mut(|rec| set_two(&mut rec.a[1], &mut rec.y));
    pwriteln!(pair.get().a[1], " ", pair.get().y);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
