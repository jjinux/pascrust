//! Generated by PascRust from `array_high_low.pas`. Do not edit by hand.
//! Pascal: `program ArrayHighLow;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// High and Low of an array are its bounds in the Rust (a.high(),
// TArr::HIGH), so they follow the array's declaration.

const N: i16 = 10;

/// Pascal: `array[1..N] of Integer`
type TArr = PArray<i16, 1, 10>;

/// Pascal: `procedure Last;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn last(a: TArr) {
    pwriteln!(a[a.high()]);
}

/// The main program: the `begin ... end.` block of `ArrayHighLow`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut a: TArr = TArr::default();
    let mut i: i16 = 0;
    let mut total: i16 = 0;
    let mut l: i32 = 0;
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for i_value in a.low() as i16..=a.high() as i16 {
        i = i_value;
        a[i] = i;
    }
    total = 0;
    for i_value in 1..=a.high() as i16 {
        i = i_value;
        total += a[i];
    }
    l = (a.high() - a.low() + 1) as i32;
    pwriteln!(total, " ", l, " ", TArr::HIGH, " ", a.low());
    if i < a.high() as i16 {
        pwriteln!("less");
    }
    last(a);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
