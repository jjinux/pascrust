//! Generated by PascRust from `counter.pas`: the unit `Counter` as a Rust
//! library. Call it through `pascrust_runtime::call`, which turns a Pascal
//! runtime error into an `Err`.

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this library's does.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

// Each Pascal unit is a module; the units it uses are public, since the
// unit's interface may name their types.
mod counter;
pub mod counter_rust;
pub mod helper;

// The unit's interface (and the runtime, with `PString`, `call` and the rest).
pub use counter::*;
pub use counter_rust::tally_twice;
pub use pascrust_runtime;

#[allow(unused_imports)]
use helper::*;
#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

/// The variables of unit `Counter` and of the units it uses: what a Pascal
/// program would have as globals. Its methods are the unit's interface
/// routines, with the variables passed in.
pub struct CounterContext {
    /// Pascal: `HelperCount: Integer` (unit `Helper`)
    pub helper_count: i16,
    /// Pascal: `Count: Integer` (unit `Helper`)
    pub count: i16,
    /// Pascal: `Count: Integer`
    pub count_2: i16,
    /// Pascal: `Hook: TBumper`
    pub hook: TBumper,
    /// Pascal: `Log: String`
    pub log: PString,
    /// Pascal: `Secret: Integer` (a typed constant)
    pub secret: i16,
    /// Pascal: `Internal: Integer`
    pub internal: i16,
}

impl CounterContext {
    /// The variables as a Pascal program starts with them: declared, then the
    /// units' initialization parts run. Call it through `call`: they're
    /// Pascal code, which can fail.
    pub fn new() -> CounterContext {
        pascrust_runtime::warn_unless_wrapping(|| std::hint::black_box(i16::MAX) + 1);
        let mut helper_count: i16 = 0;
        let count: i16 = 0; // same name as Counter's
        let count_2: i16 = 0;
        let mut hook: TBumper = TBumper::nil();
        let mut log: PString = PString::new();
        let secret: i16 = 7;
        let mut internal: i16 = 0;
        // The initialization part of unit `Helper`.
        helper::helper_init(&mut helper_count);
        // The initialization part of unit `Counter`.
        counter::counter_init(&mut helper_count, &mut hook, &mut log, secret, &mut internal);
        CounterContext { helper_count, count, count_2, hook, log, secret, internal }
    }

    /// Pascal: `procedure Bump(N: Integer);`
    pub fn bump(&mut self, n: i16) {
        counter::bump(&mut self.helper_count, &mut self.count_2, self.internal, n)
    }

    /// Pascal: `function Current: Integer;`
    pub fn current(&self) -> i16 {
        counter::current(self.count_2)
    }

    /// Pascal: `procedure Swap(var A, B: Integer);`
    pub fn swap(&mut self, a: &mut i16, b: &mut i16) {
        counter::swap(&mut self.log, a, b)
    }

    /// Pascal: `procedure New(N: Integer);`
    /// (`new_2`: `new` makes the struct.)
    pub fn new_2(&mut self, n: i16) {
        counter::new(&mut self.count_2, n)
    }

    /// Pascal: `function Pure(X: Integer): Integer;`
    pub fn pure(&self, x: i16) -> i16 {
        counter::pure(x)
    }

    /// Pascal: `procedure CallHook(N: Integer);`
    pub fn call_hook(&mut self, n: i16) {
        counter::call_hook(&mut self.helper_count, &mut self.count_2, self.hook, self.internal, n)
    }

    /// Pascal: `procedure TickTwice;`
    pub fn tick_twice(&mut self) {
        counter::tick_twice(&mut self.helper_count, &mut self.count)
    }

    /// Pascal: `procedure AddTimes(N, Times: Integer);`
    pub fn add_times(&mut self, n: i16, times: i16) {
        counter::add_times(&mut self.count_2, n, times)
    }

    /// Pascal: `function Probe: Integer;`
    pub fn probe(&self) -> i16 {
        counter::probe()
    }

    /// Pascal: `function Next(N: Integer): Integer;`
    pub fn next(&self, n: i16) -> i16 {
        counter::next(n)
    }

    /// Pascal: `function TallyTwice(T: TTally): Integer;`
    pub fn tally_twice(&self, t: TTally) -> i16 {
        counter_rust::tally_twice(t)
    }
}
