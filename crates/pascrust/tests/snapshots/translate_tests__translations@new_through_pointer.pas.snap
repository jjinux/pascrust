/// The main program: the `begin ... end.` block of `NewThroughPointer`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut q: AnyPtr = AnyPtr::nil();
    let mut n: PNode = Ptr::nil();
    q = AnyPtr::from_ptr(&Ptr::<TNode>::alloc());
    q.cast::<TNode>().get_mut().v = 5;
    q.cast::<TNode>().get_mut().name = pstr("five");
    n = q.cast::<TNode>();
    pwriteln!(n.get().v, " ", q.cast::<TNode>().get().name);
    n.get_mut().v += 1;
    pwriteln!(q.cast::<TNode>().get().v);
    q.cast::<TNode>().dispose();
    n = Ptr::<TNode>::alloc();
    n.get_mut().v = 3;
    pwriteln!(n.get().v);
