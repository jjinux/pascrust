//! Generated by pascrust from `arrays.pas`. Do not edit by hand.
//! Pascal: `program Arrays;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

const MAX_COL: i16 = 5;
const MAX_ROW: i16 = 3;

/// Pascal: `array[0..MaxCol, 0..MaxRow] of boolean`
type GridT = PArray<PArray<bool, 0, 4>, 0, 6>;

/// Pascal: `array['a'..'e'] of integer`
type Counts = PArray<i16, 97, 5>;

/// Pascal: `procedure Clear(var g: GridT);`
fn clear(g: &mut GridT) {
    for c in 0..=MAX_COL {
        for r in 0..=MAX_ROW {
            g[c][r] = false;
        }
    }
}

/// Pascal: `function CountAlive(g: GridT): integer;`
fn count_alive(g: GridT) -> i16 {
    let mut result: i16 = 0;
    let mut n: i16 = 0;
    n = 0;
    for c in 0..=MAX_COL {
        for r in 0..=MAX_ROW {
            if g[c][r] {
                n += 1;
            }
        }
    }
    result = n;
    result
}

/// The main program: the `begin ... end.` block of `Arrays`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let days: PArray<i16, 1, 3> = PArray::new([31, 28, 31]);
    let mut grid: GridT = GridT::default();
    let mut tally: Counts = Counts::default();
    let mut squares: PArray<i32, 1, 10> = PArray::default();
    let c: i16 = 0;
    let r: i16 = 0;
    let alive: i16 = 0;
    let mut word: PString = PString::new();
    for i in 1_i16..=10 {
        squares[i] = i32::from(i * i);
    }
    pwriteln!(squares[1], " ", squares[10]);
    pwriteln!(days[1] + days[2] + days[3]);
    clear(&mut grid);
    grid[1][1] = true;
    grid[2][3] = true;
    pwriteln!("alive: ", count_alive(grid));
    word = pstr("abacabad");
    for ch in b'a'..=b'e' {
        tally[ch] = 0;
    }
    for i in 1..=word.length() {
        if word[i] <= b'e' {
            tally[word[i]] += 1;
        }
    }
    for ch in b'a'..=b'e' {
        pwrite!(ch, "=", tally[ch], " ");
    }
    pwriteln!();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
