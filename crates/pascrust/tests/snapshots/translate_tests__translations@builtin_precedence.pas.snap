//! Generated by PascRust from `builtin_precedence.pas`. Do not edit by hand.
//! Pascal: `program BuiltinPrecedence;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// Standard functions whose Rust is an expression, not a call, inside a
// larger one: Succ(i) * 2 is (i + 1) * 2, Odd(a) = Odd(b) compares two
// comparisons, a cast before < gets parentheses. Output from fpc -Mtp
// except Hi(i * 300) * 2: Free Pascal works out i * 300 in 32 bits
// (high byte 0), TP and PascRust in 16 (5).

/// The main program: the `begin ... end.` block of `BuiltinPrecedence`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    let mut c: u8 = 0;
    let mut b: u8 = 0;
    i = 5;
    j = 3;
    c = b'A';
    b = 200;
    pwriteln!((i + 1) * 2, " ", (i - 1) * 2, " ", (i % 2 != 0) == (j % 2 != 0));
    pwriteln!(i16::from(c) < 70, " ", i16::from(c) * 2, " ", (-i).abs() * 2, " ", i.pow(2) * 2);
    pwriteln!(
        ((i16::from(c) + 1) as u8) < b'C',
        " ",
        i16::from((i * 300 >> 8) as u8) * 2,
        " ",
        i16::from(i as u8) * 2,
        " ",
        i.swap_bytes() * 2
    );
    pwriteln!(2.4_f64.round() as i32 * 2, " ", 2.7_f64.trunc() as i32 * 2, " ", 3 * 2, " ", i16::from(b) * 2);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
