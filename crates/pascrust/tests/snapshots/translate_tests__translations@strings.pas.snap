//! Generated by PascRust from `strings.pas`. Do not edit by hand.
//! Pascal: `program Strings;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `Strings`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: PString = PString::new();
    let mut t: PString = PString::new();
    let mut short: PString = PString::new();
    let mut c: u8 = 0;
    let mut n: i16 = 0;
    let mut code: i16 = 0;
    let mut r: f64 = 0.0;
    s = pstr("Turbo");
    t = s + " Pascal";
    pwriteln!(t, " has ", t.length(), " characters");
    pwriteln!(t.copy(7, 6));
    pwriteln!(pos("Pas", t));
    t.delete(1, 6);
    pwriteln!(t);
    t.insert("Free ", 1);
    pwriteln!(t);
    short = pstr("abcdefgh").truncated(5);
    pwriteln!(short);
    c = t[1];
    pwriteln!(c, " ", b'q'.to_ascii_uppercase(), " ", i16::from(c), " ", b'A');
    t[1] = b'f';
    pwriteln!(t);
    if s < "Zebra" {
        pwriteln!("Turbo < Zebra");
    }
    if s == "Turbo" {
        pwriteln!("equal");
    }
    s = pas_str(42);
    pwriteln!("[", s, "]");
    s = pas_str(wd(3.14159, 6, 2));
    pwriteln!("[", s, "]");
    val("123", &mut n, &mut code);
    pwriteln!(n, " ", code);
    val("12x", &mut n, &mut code);
    pwriteln!(code);
    pwriteln!("it's", " ", w("a", 3), " ", "end!");
    pwriteln!(pstr("a") + "b" + "c");
    r = 2.5;
    pwriteln!(wd(r, 8, 3), "|", w(7, 4), "|", w(true, 6));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
