//! Generated by pascrust from `lifting.pas`. Do not edit by hand.
//! Pascal: `program Lifting;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Note(s: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn note(global_count: &mut i16, log: &mut PString, s: PString) {
    *log = *log + s;
    *global_count += 1;
}

/// Pascal: `procedure Outer(var total: integer; step: integer);`
///
/// Uses globals, which are passed in as parameters.
fn outer(global_count: &mut i16, log: &mut PString, total: &mut i16, step: i16) {
    let mut i: i16 = 0;
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for i_value in 1..=3 {
        i = i_value;
        outer_middle(global_count, log, total, step, i);
    }
}

/// Pascal: `procedure Middle;`
///
/// Nested inside `Outer` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn outer_middle(global_count: &mut i16, log: &mut PString, total: &mut i16, step: i16, i: i16) {
    outer_middle_inner(total, step, i);
    note(global_count, log, pstr("m"));
}

/// Pascal: `procedure Inner;`
///
/// Nested inside `Middle`; lifted, with outer variables passed in.
fn outer_middle_inner(total: &mut i16, step: i16, i: i16) {
    *total += step * i;
}

/// Pascal: `procedure Hidden;`
///
/// Uses globals, which are passed in as parameters.
fn hidden(global_count: &mut i16, log: &mut PString) {
    let mut count: i16 = 0;
    count = 100;
    note(global_count, log, pstr("h"));
    pwriteln!("local count ", count);
}

/// The main program: the `begin ... end.` block of `Lifting`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut global_count: i16 = 0;
    let mut log: PString = PString::new();
    let mut sum: i16 = 0;
    global_count = 0;
    log = PString::new();
    sum = 0;
    outer(&mut global_count, &mut log, &mut sum, 2);
    pwriteln!("sum ", sum);
    hidden(&mut global_count, &mut log);
    pwriteln!("count ", global_count, " log ", log);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
