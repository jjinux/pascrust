//! Generated by PascRust from `proc_globals.pas`. Do not edit by hand.
//! Pascal: `program ProcGlobals;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Routines kept in a procedural variable that use globals: every routine
// of the type takes the globals any of them uses, and so does a call
// through one (Run). Output from fpc -Mtp.
/// Pascal: `procedure(var N: Integer)`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type Bump = ProcVar<fn(&mut i16, &mut i16)>;

/// Pascal: `procedure AddOne(var N: Integer);`
///
/// Kept in a `Bump`, so it takes the globals any `Bump` routine uses.
fn add_one(count: &mut i16, n: &mut i16) {
    *n += 1;
}

/// Pascal: `procedure AddCount(var N: Integer);`
///
/// Kept in a `Bump`, so it takes the globals any `Bump` routine uses.
fn add_count(count: &mut i16, n: &mut i16) {
    *count += 1;
    *n += *count;
}

/// Pascal: `procedure Run(Q: Bump; times: Integer);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn run_(count: &mut i16, other: &mut i16, q: Bump, times: i16) {
    for i in 1..=times {
        q.get()(count, other);
    }
}

/// The main program: the `begin ... end.` block of `ProcGlobals`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut count: i16 = 0;
    let mut other: i16 = 0;
    let mut p: Bump = ProcVar::nil();
    count = 0;
    other = 0;
    p = ProcVar::of(add_one, "AddOne");
    p.get()(&mut count, &mut other);
    run_(&mut count, &mut other, ProcVar::of(add_count, "AddCount"), 3);
    pwriteln!(other, " ", count);
    p = ProcVar::of(add_count, "AddCount");
    run_(&mut count, &mut other, p, 2);
    pwriteln!(other, " ", count);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
