// ===== src/main.rs =====
//! Generated by PascRust from `proc_unit_types.pas`. Do not edit by hand.
//! Pascal: `program ProcUnitTypes;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod proc_unit;

#[allow(unused_imports)]
use crate::proc_unit::*;
use pascrust_runtime::prelude::*;

// A routine kept in a unit's procedural type that uses a global of a type
// the program declares: the unit names the program's type.

/// Pascal: `record Count, Total: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Stats {
    count: i16,
    total: i16,
}

/// Pascal: `procedure Tally(N: Integer);`
///
/// Kept in a `Handler`, so it takes the globals any `Handler` routine uses.
fn tally(s: &mut Stats, n: i16) {
    s.count += 1;
    s.total += n;
}

/// The main program: the `begin ... end.` block of `ProcUnitTypes`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut on_event: Handler = ProcVar::nil();
    let mut s: Stats = Stats::default();
    s.count = 0;
    s.total = 0;
    on_event = ProcVar::of(tally, "Tally");
    fire(on_event, &mut s, 3);
    fire(on_event, &mut s, 4);
    pwriteln!(s.count, " ", s.total);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/proc_unit.rs =====
//! Generated by PascRust from `procunit.pas`. Do not edit by hand.
//! Pascal: `unit ProcUnit;`

#[allow(unused_imports)]
use pascrust_runtime::prelude::*;
// The program's types that routines kept in this unit's procedural types use.
use crate::Stats;

// A unit with a procedural type; the program keeps its own routines in
// it (see proc_unit_types.pas).

/// Pascal: `procedure(N: Integer)`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
pub type Handler = ProcVar<fn(&mut Stats, i16)>;

/// Pascal: `procedure Fire(N: Integer);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
pub fn fire(on_event: Handler, s: &mut Stats, n: i16) {
    if !on_event.is_nil() {
        on_event.get()(s, n);
    }
}
