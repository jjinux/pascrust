//! Generated by PascRust from `printer.pas`. Do not edit by hand.
//! Pascal: `program PrinterTest;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// The Printer unit's Lst. PascRust prints to printer.txt (or wherever
// PASCRUST_PRINTER says), so this reads the file back to check what was
// printed. Self-checking. (Free Pascal's Lst is a real printer device, so
// this .out is built from the checks, by hand.)

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `PrinterTest`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut f: PText = PText::default();
    let mut line: PString = PString::new();
    let mut total: f64 = 0.0;
    checks = 0;
    failures = 0;
    total = 12.5;
    fwriteln!(Lst, "Report for March");
    fwrite!(Lst, "Total: ");
    fwriteln!(Lst, wd(total, 6, 2));
    Lst.flush();
    f.assign("printer.txt");
    f.reset();
    freadln!(f, &mut line);
    check(&mut checks, &mut failures, line == "Report for March", pstr("first printed line"));
    freadln!(f, &mut line);
    check(&mut checks, &mut failures, line == "Total:  12.50", pstr("second printed line, with a format"));
    check(&mut checks, &mut failures, f.eof(), pstr("nothing else printed"));
    f.close();
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
