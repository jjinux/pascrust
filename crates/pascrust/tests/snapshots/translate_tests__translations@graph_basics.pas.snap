//! Generated by PascRust from `graph_basics.pas`. Do not edit by hand.
//! Pascal: `program GraphBasics;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// The Graph unit, drawn without a window (the tests run with
// PASCRUST_GRAPH=headless) and checked with GetPixel. The expected output is
// written by hand: Free Pascal's Graph unit needs a real screen.

/// The main program: the `begin ... end.` block of `GraphBasics`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    let mut pattern: FillPatternType = FillPatternType::default();
    driver = i16::from(DETECT);
    init_graph(&mut driver, &mut mode, "C:\\TP\\BGI");
    pwriteln!("driver ", driver, ", mode ", mode, ", result ", graph_result());
    pwriteln!("screen ", get_max_x(), " x ", get_max_y(), ", colours 0..", get_max_color());
    set_color(RED);
    line(10, 10, 20, 10);
    pwriteln!("line: ", get_pixel(10, 10), " ", get_pixel(20, 10), " ", get_pixel(21, 10));
    set_line_style(SOLID_LN, 0, THICK_WIDTH);
    line(10, 30, 50, 30);
    pwriteln!("thick: ", get_pixel(30, 29), " ", get_pixel(30, 31), " ", get_pixel(30, 32));
    set_line_style(DOTTED_LN, 0, NORM_WIDTH);
    line(0, 50, 7, 50);
    pwrite!("dotted: ");
    for i in 0_i16..=7 {
        pwrite!(get_pixel(i, 50));
    }
    pwriteln!();
    set_fill_style(SOLID_FILL, BLUE);
    bar(100, 100, 109, 109);
    pwriteln!("bar: ", get_pixel(100, 100), " ", get_pixel(109, 109), " ", get_pixel(110, 110));
    set_color(GREEN);
    circle(200, 200, 20);
    pwriteln!("circle: ", get_pixel(220, 200), " ", get_pixel(200, 180), " ", get_pixel(200, 200));
    set_fill_style(SOLID_FILL, YELLOW);
    flood_fill(200, 200, GREEN);
    pwriteln!("flood: ", get_pixel(200, 200), " ", get_pixel(230, 200));
    get_fill_pattern(&mut pattern);
    pwriteln!("pattern: ", i16::from(pattern[1]), " ", i16::from(pattern[8]));
    set_view_port(300, 300, 400, 400, CLIP_ON);
    put_pixel(0, 0, WHITE);
    put_pixel(200, 0, WHITE);
    set_view_port(0, 0, get_max_x(), get_max_y(), CLIP_ON);
    pwriteln!("viewport: ", get_pixel(300, 300), " ", get_pixel(500, 300));
    set_text_justify(CENTER_TEXT, CENTER_TEXT);
    pwriteln!("text: ", text_width("Hello"), " x ", text_height("Hello"));
    move_to(5, 5);
    line_to(15, 5);
    pwriteln!("position: ", get_x(), ", ", get_y());
    set_bk_color(BLUE);
    pwriteln!("background: ", get_bk_color(), ", pixel ", get_pixel(0, 479));
    close_graph();
    pwriteln!("done");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
