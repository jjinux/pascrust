//! Generated by pascrust from `ptr_args.pas`. Do not edit by hand.
//! Pascal: `program PtrArgs;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// A value argument read through a pointer (p^ or p^.field) is copied
// before the call, so the callee may change or dispose the record.
/// Pascal: `^Node`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type NodePtr = Ptr<Node>;

/// Pascal: `record value: integer; next: NodePtr; end`
#[derive(Clone, Debug, Default)]
struct Node {
    value: i16,
    next: NodePtr,
}

/// Pascal: `procedure FreeAndShow(n: Node; count: integer);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn free_and_show(head: &mut NodePtr, n: Node, count: i16) {
    head.dispose();
    *head = Ptr::nil();
    pwriteln!("freed node ", n.value, " (count ", count, ")");
}

/// Pascal: `procedure Bump(var p: NodePtr; old: integer);`
fn bump(p: &mut NodePtr, old: i16) {
    p.get_mut().value = old + 1;
}

/// The main program: the `begin ... end.` block of `PtrArgs`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut head: NodePtr = Ptr::nil();
    head = Ptr::alloc();
    head.get_mut().value = 41;
    head.get_mut().next = Ptr::nil();
    let old = head.get().value;
    bump(&mut head, old);
    pwriteln!("value is now ", head.get().value);
    let n = head.get().clone();
    let count = head.get().value;
    free_and_show(&mut head, n, count);
    pwriteln!("head is nil: ", head.is_nil());
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
