//! Generated by pascrust from `crlf.pas`. Do not edit by hand.
//! Pascal: `program CrLf;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `CrLf`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // This file has DOS (CR LF) line endings, and so does its input; the
    // program also reads back a text file written with them.
    let mut f: PText = PText::default();
    let mut name: PString = PString::new();
    let mut line: PString = PString::new();
    let mut n: i16 = 0;
    preadln!(&mut name);
    preadln!(&mut n);
    pwriteln!("name=[", name, "] n=", n);
    f.assign("crlf.txt");
    f.rewrite();
    fwrite!(f, "first", "\r\n", "second", "\r\n");
    f.close();
    f.reset();
    while !f.eof() {
        freadln!(f, &mut line);
        pwriteln!("[", line, "] length ", line.length());
    }
    f.close();
    f.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
