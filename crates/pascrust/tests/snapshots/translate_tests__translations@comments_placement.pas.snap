// ===== src/main.rs =====
//! Generated by pascrust from `comments_placement.pas`. Do not edit by hand.
//! Pascal: `program CommentsPlacement;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod cmt_unit;
mod cmt_unit2;

#[allow(unused_imports)]
use crate::cmt_unit::*;
#[allow(unused_imports)]
use crate::cmt_unit2::*;
use pascrust_runtime::prelude::*;

// This program checks comment placement.
// Where comments land in the Rust: after an end, before an else if,
// before until, on loop variables, on declarations with no Rust of
// their own.
// for Ready and Two

/// Pascal: `(Red, Green)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Color {
    #[default]
    Red,
    Green,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Color {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Color {
    const VALUES: &'static [Self] = &[Color::Red, Color::Green];
}

/// Pascal: `object total: Integer; { adds one } procedure Bump; end`
#[derive(Clone, Copy, Debug, Default)]
struct Counter {
    total: i16,
}

// Pascal: `TCount = Integer` // an alias makes no Rust

/// Pascal: `procedure Outer;`
fn outer() {
    outer_later();
}

// a nested namesake
/// Pascal: `procedure Later;`
///
/// Nested inside `Outer` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn outer_later() {}

// body below
// the real Later
/// Pascal: `procedure Later(k: Integer);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn later(x: &mut i16, k: i16) {
    *x += k;
}

/// Pascal: `procedure Count;`
fn count() {
    // Counts to three.
    // Pascal: `i, j: Integer` // the counters
    for i in 1_i16..=3 {
        pwrite!(i);
    }
    for j in 1_i16..=0 {
        pwrite!(j);
    }
    pwriteln!();
}

/// Pascal: `procedure Foo;`
///
/// Uses globals, which are passed in as parameters.
fn foo(x: &mut i16) {
    *x = 1;
} // of Foo

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl Counter {
    // adds one
    /// Pascal: `procedure Counter.Bump;`
    fn bump(&mut self) {
        self.total += 1;
    }
}

/// The main program: the `begin ... end.` block of `CommentsPlacement`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut ready: bool = false;
    let primes: PArray<i16, 1, 3> = PArray::new([2, 3, 5]); // the first primes
    let mut c: Counter = Counter::default();
    let mut t: i16 = 0;
    let mut hue: Color = Color::Red;
    let mut x: i16 = 0;
    let mut y: i16 = 0; // both coordinates
    let mut n: i16 = 0;
    // The initialization part of unit `CmtUnit`.
    cmt_unit_init(&mut ready);
    n = 0;
    foo(&mut x);
    later(&mut x, 2 * 0); // twice
    count();
    if x > 0 {
        y = 1;
        // then branch
    } else {
        y = 2;
    } // else branch
    if x > 5 {
        y = 0;
    } else {
        // otherwise
        y += 0;
    }
    // an empty block
    match x {
        5 => {
            y = 0;
        }
        // other values
        // need nothing
        _ => {}
    } // case
    while n < 2 {
        n += 1;
    } // while loop
    n += 1; // a plain block
    if x == 2 {
        y = 3;
    } else if x == 1 {
        // before else if
        y += 10;
    }
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        n += 1;
        // about to test
        if n > 4 {
            break;
        }
    } // loop done
    c.total = 0;
    c.bump();
    t = c.total;
    hue = Color::Green;
    match hue {
        Color::Red => {
            y += 0;
        }
        Color::Green => {
            y += 0;
        }
    } // every colour covered
    match hue {
        Color::Red => {
            y += 0;
        }
        Color::Green => {
            y += 0;
        }
        #[allow(unreachable_patterns)]
        _ => {
            // The arms above cover every value, so Pascal's `else` never runs.
            // an else that can't happen
            y = 0;
        }
    }
    outer();
    pwriteln!(x, " ", y, " ", n, " ", ready, " ", t, " ", primes[3] + TWO);
} // end of program

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

