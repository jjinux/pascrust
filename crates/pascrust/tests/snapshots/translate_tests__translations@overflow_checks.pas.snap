//! Generated by PascRust from `overflow_checks.pas`. Do not edit by hand.
//! Pascal: `program OverflowChecks;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// The $Q+ switch: integer +, -, *, negation, Abs, Sqr, Succ, Pred, Inc
// and Dec stop with runtime error 215 when the result doesn't fit, as in
// TP 7; code compiled with $Q- wraps around. Expected output by hand:
// Free Pascal works in 32 or 64 bits, so 32767 + 1 doesn't overflow
// there.

const K: i16 = 5;

/// Pascal: `record N: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rec {
    n: i16,
}

/// Pascal: `^Rec`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PRec = Ptr<Rec>;

/// Pascal: `record q: PRec; end`
#[derive(Clone, Debug, Default)]
struct Outer {
    q: PRec,
}

/// Pascal: `procedure Bump(var N: Integer; by: Integer);`
fn bump(n: &mut i16, by: i16) {
    // `{$Q+}`: `checked_add` and the like give `None` when the result doesn't fit,
    // and `overflow` stops with runtime error 215, as in Turbo Pascal.
    *n = (*n).checked_add(by).unwrap_or_else(overflow);
}

/// The main program: the `begin ... end.` block of `OverflowChecks`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: Ptr<Rec> = Ptr::nil();
    let mut r: Ptr<Outer> = Ptr::nil();
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    let mut b: u8 = 0;
    let mut l: i32 = 0;
    let mut w_: u16 = 0;
    let mut s: i8 = 0;
    i = 32767;
    j = i + 1;
    pwriteln!(j);
    l = 100000;
    pwriteln!(
        i.checked_sub(1).unwrap_or_else(overflow),
        " ",
        l.checked_mul(2).unwrap_or_else(overflow),
        " ",
        i.checked_neg().unwrap_or_else(overflow),
        " ",
        j.checked_add(1).unwrap_or_else(overflow).checked_abs().unwrap_or_else(overflow),
        " ",
        i.checked_sub(1).unwrap_or_else(overflow).checked_add(1).unwrap_or_else(overflow),
        " ",
        j.checked_add(1).unwrap_or_else(overflow).checked_sub(1).unwrap_or_else(overflow)
    );
    b = 254;
    b = b.checked_add(1).unwrap_or_else(overflow);
    b = b.checked_sub(255).unwrap_or_else(overflow);
    j = 181;
    bump(&mut j, 0);
    pwriteln!(
        i16::from(b),
        " ",
        j.checked_pow(2).unwrap_or_else(overflow),
        " ",
        2_i16.checked_mul(j).unwrap_or_else(overflow)
    );
    p = Ptr::alloc();
    p.get_mut().n = 1;
    {
        let updated = p.get().n.checked_add(1).unwrap_or_else(overflow);
        p.get_mut().n = updated;
    }
    // Pascal `with`: Rust has no equivalent, so each field is written out in full.
    {
        let updated = p.get().n.checked_add(2).unwrap_or_else(overflow);
        p.get_mut().n = updated;
    }
    pwriteln!(p.get().n, " ", 5_i16.checked_mul(j).unwrap_or_else(overflow));
    r = Ptr::alloc();
    r.get_mut().q = p.clone();
    {
        let updated = r.get().q.get().n.checked_add(40).unwrap_or_else(overflow);
        r.get().q.get_mut().n = updated;
    }
    pwriteln!(p.get().n);
    // A constant (2 + 3) is worked out when TP compiles, so it isn't checked.
    b = 10;
    b = b.checked_sub(2 + 3).unwrap_or_else(overflow);
    w_ = 10;
    w_ = w_.checked_mul(2 + 3).unwrap_or_else(overflow);
    pwriteln!(
        j.checked_mul(2 + 3).unwrap_or_else(overflow),
        " ",
        (2 + 3) * (4 + 5),
        " ",
        l.checked_sub(2 + 3).unwrap_or_else(overflow),
        " ",
        i16::from(b),
        " ",
        w_
    );
    // A constant step that's negative turns round, as -5 does: up by 5.
    b = 250;
    b = b.checked_add(5).unwrap_or_else(overflow);
    {
        let updated = p.get().n.checked_add(K).unwrap_or_else(overflow);
        p.get_mut().n = updated;
    }
    pwriteln!(i16::from(b), " ", p.get().n);
    // A variable step that's negative adds as a number: 10 + -5 is 5.
    b = 10;
    s = -5;
    // `{$Q+}`: a step whose type holds values the target's can't is added in a wider type;
    // `try_from` fails, and `overflow` stops with runtime error 215, when the result doesn't fit.
    b = u8::try_from(i32::from(b) + i32::from(s)).unwrap_or_else(|_| overflow());
    {
        let updated = r.get().q.get().n.checked_sub(i16::from(s)).unwrap_or_else(overflow);
        r.get().q.get_mut().n = updated;
    }
    w_ = 3;
    w_ = u16::try_from(i32::from(w_) + i32::from(i16::from(s).checked_add(2).unwrap_or_else(overflow)))
        .unwrap_or_else(|_| overflow());
    pwriteln!(i16::from(b), " ", p.get().n, " ", w_);
    // Ord, Succ and typecasts of constants are constants too.
    b = 1;
    b = b.checked_add(i16::from(b'A') as u8).unwrap_or_else(overflow);
    b = b.checked_add((K + 1) as u8).unwrap_or_else(overflow);
    b = b.checked_add(3_u16 as u8).unwrap_or_else(overflow);
    l = 1;
    l = l.checked_add(i32::from(i16::from(b'A') + 1)).unwrap_or_else(overflow);
    pwriteln!(i16::from(b), " ", l);
    pwriteln!(i + 1);
    i = i.checked_add(1).unwrap_or_else(overflow);
    pwriteln!("not reached");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
