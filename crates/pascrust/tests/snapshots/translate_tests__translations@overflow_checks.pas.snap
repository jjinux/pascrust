//! Generated by PascRust from `overflow_checks.pas`. Do not edit by hand.
//! Pascal: `program OverflowChecks;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// The $Q+ switch: integer +, -, *, negation, Abs, Sqr, Succ, Pred, Inc
// and Dec stop with runtime error 215 when the result doesn't fit, as in
// TP 7; code compiled with $Q- wraps around. Expected output by hand: Free Pascal works in
// 32 or 64 bits, so 32767 + 1 doesn't overflow there.

/// Pascal: `procedure Bump(var n: Integer; by: Integer);`
fn bump(n: &mut i16, by: i16) {
    // `{$Q+}`: `checked_add` and the like give `None` when the result doesn't fit,
    // and `overflow` stops with runtime error 215, as in Turbo Pascal.
    *n = (*n).checked_add(by).unwrap_or_else(overflow);
}

/// The main program: the `begin ... end.` block of `OverflowChecks`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    let mut b: u8 = 0;
    let mut l: i32 = 0;
    i = 32767;
    j = i + 1;
    pwriteln!(j);
    l = 100000;
    pwriteln!(
        i.checked_sub(1).unwrap_or_else(overflow),
        " ",
        l.checked_mul(2).unwrap_or_else(overflow),
        " ",
        i.checked_neg().unwrap_or_else(overflow),
        " ",
        j.checked_add(1).unwrap_or_else(overflow).checked_abs().unwrap_or_else(overflow),
        " ",
        i.checked_sub(1).unwrap_or_else(overflow).checked_add(1).unwrap_or_else(overflow),
        " ",
        j.checked_add(1).unwrap_or_else(overflow).checked_sub(1).unwrap_or_else(overflow)
    );
    b = 254;
    b = b.checked_add(1).unwrap_or_else(overflow);
    b = b.checked_sub(255).unwrap_or_else(overflow);
    j = 181;
    bump(&mut j, 0);
    pwriteln!(
        i16::from(b),
        " ",
        j.checked_pow(2).unwrap_or_else(overflow),
        " ",
        2_i16.checked_mul(j).unwrap_or_else(overflow)
    );
    pwriteln!(i + 1);
    i = i.checked_add(1).unwrap_or_else(overflow);
    pwriteln!("not reached");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
