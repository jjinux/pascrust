//! Generated by PascRust from `const_casts.pas`. Do not edit by hand.
//! Pascal: `program ConstCasts;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// Typecasts in constant expressions, which TP 7 allows: Word(-1) is 65535,
// as a constant, a case label, an array bound and a set element. Output
// from fpc -Mtp.

const W1: u16 = 65535;
const B1: u8 = 44;
const S1: i8 = -56;
const C1: u8 = b'A';
const LAST: Color = Color::Blue;
const FLAG: bool = true;
const HALF: i16 = 32767;
const CODE: i16 = 67;

/// Pascal: `(Red, Green, Blue)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Color {
    #[default]
    Red,
    Green,
    Blue,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Color {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Color {
    const VALUES: &'static [Self] = &[Color::Red, Color::Green, Color::Blue];
}

/// The main program: the `begin ... end.` block of `ConstCasts`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut b: u8 = 0;
    let mut a: PArray<i16, 0, 3> = PArray::default();
    pwriteln!(W1, " ", i16::from(B1), " ", S1, " ", C1, " ", LAST as i16, " ", FLAG, " ", HALF, " ", CODE);
    pwriteln!(W1 - 1, " ", 2, " ", pset![set of u8; b'@'..=b'F'].contains(C1));
    for i in 0_i16..=2 {
        a[i] = i * 10;
    }
    pwriteln!(a[2_u8]);
    b = 44;
    match b {
        44 => {
            pwriteln!("forty-four");
        }
        _ => {
            pwriteln!("other");
        }
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
