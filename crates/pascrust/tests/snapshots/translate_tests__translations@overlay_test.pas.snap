// ===== src/main.rs =====
//! Generated by PascRust from `overlay_test.pas`. Do not edit by hand.
//! Pascal: `program OverlayTest;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod ovl_help;

#[allow(unused_imports)]
use crate::ovl_help::*;
use pascrust_runtime::prelude::*;

// The Overlay unit, faked: there's nothing to load, so it reports success
// and remembers its settings. Self-checking. (Free Pascal has no overlay
// manager, so this .out is built from the checks, by hand.)

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `OverlayTest`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    checks = 0;
    failures = 0;
    ovr_init("OVERLAY.OVR");
    check(&mut checks, &mut failures, ovr_result() == OVR_OK, pstr("OvrInit succeeds without a .OVR file"));
    ovr_init_ems();
    check(&mut checks, &mut failures, ovr_result() == OVR_OK, pstr("OvrInitEMS succeeds"));
    ovr_set_buf(ovr_get_buf() + 16384);
    check(&mut checks, &mut failures, ovr_get_buf() == 65536 + 16384, pstr("OvrSetBuf and OvrGetBuf"));
    ovr_set_retry(ovr_get_buf() / 3);
    check(&mut checks, &mut failures, ovr_get_retry() == (65536 + 16384) / 3, pstr("OvrSetRetry and OvrGetRetry"));
    ovr_clear_buf();
    check(&mut checks, &mut failures, twice(21) == 42, pstr("calling into an overlaid unit"));
    check(&mut checks, &mut failures, ovr_load_count() == 0 && ovr_trap_count() == 0, pstr("nothing is ever loaded"));
    set_ovr_result(OVR_ERROR);
    check(&mut checks, &mut failures, ovr_result() == -1, pstr("OvrResult can be set"));
    set_ovr_file_mode(0);
    check(&mut checks, &mut failures, i16::from(ovr_file_mode()) == 0, pstr("OvrFileMode can be set"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/ovl_help.rs =====
//! Generated by PascRust from `ovlhelp.pas`. Do not edit by hand.
//! Pascal: `unit OvlHelp;`

#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

// A unit that overlay_test.pas marks for overlaying. TP required units in
// overlays to be compiled with the O+ switch, as below.

/// Pascal: `function Twice(n: Integer): Integer;`
pub fn twice(n: i16) -> i16 {
    let mut result: i16 = 0;
    result = n * 2;
    result
}
