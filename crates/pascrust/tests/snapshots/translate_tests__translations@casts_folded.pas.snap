//! Generated by PascRust from `casts_folded.pas`. Do not edit by hand.
//! Pascal: `program CastsFolded;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// Review batch M: more conversions of numbers (out of range, nested, as
// the receiver of a method), not Odd of expressions, Succ of a
// comparison, and bit operators next to shifts and arithmetic. Output
// from fpc -Mtp, except Integer(-1) shr 1: TP shifts in 16 bits (32767),
// Free Pascal in 64.

/// The main program: the `begin ... end.` block of `CastsFolded`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut a: i16 = 0;
    let mut l: i32 = 0;
    let mut b: u8 = 0;
    i = 5;
    a = 2;
    l = -3;
    b = 7;
    pwriteln!(-128_i8, " ", -32768_i16, " ", 4464_u16, " ", i16::from(b'\x00'), " ", i16::from(b'\xff'));
    pwriteln!(-1_i16 as u16, " ", 65535_u16 as i16, " ", i32::from(65535_u16), " ", 5_u16, " ", 5_i16);
    // `checked_shl`/`checked_shr`: shifting by the integer's width or more gives
    // 0, as in Turbo Pascal, where Rust's `<<` and `>>` would panic.
    pwriteln!(
        (-5_i16).abs(),
        " ",
        (-5_i16).pow(2),
        " ",
        i16::from(-300_i16 as u8),
        " ",
        (-1_i16).checked_shl(a as u32).unwrap_or(0),
        " ",
        ((-1_i16 as u16) >> 1) as i16
    );
    pwriteln!((i + 1) % 2 == 0, " ", -i % 2 == 0, " ", !(i % 2 == 0), " ", l % 2 == 0, " ", b.is_multiple_of(2));
    pwriteln!(
        (i << 1) & 3,
        " ",
        (i << 1) | 1,
        " ",
        (i & 3) | a,
        " ",
        i + (1 & 3),
        " ",
        i & 7 & 3,
        " ",
        !b.is_multiple_of(2)
    );
    pwriteln!((i < 3).succ(), " ", (i == 5).pred(), " ", i + (1 << 1), " ", (i << 1) << 2, " ", (-1_i16 as u16) >> 1);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
