//! Generated by PascRust from `inc_wrap.pas`. Do not edit by hand.
//! Pascal: `program IncWrap;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// Integer arithmetic wraps, as in TP, even where rustc can see it will
// (it refuses that by default); and a negative step at the type's
// minimum, or one just past the type's top (128 in a ShortInt
// adds -128).

/// The main program: the `begin ... end.` block of `IncWrap`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut sb: i8 = 0;
    let mut b: u8 = 0;
    i = 0;
    i += -32768;
    sb = 0;
    sb -= -128;
    pwriteln!(i, " ", sb);
    b = 250;
    b += 10;
    pwriteln!(i16::from(b));
    b = 5;
    b -= 10;
    pwriteln!(i16::from(b));
    b = 10;
    b -= 200;
    pwriteln!(i16::from(b));
    b = 250;
    b = (i16::from(b) + 10) as u8;
    pwriteln!(i16::from(b));
    // Inc(b, 256) changes nothing: 256 wraps to 0 in Byte arithmetic.
    pwriteln!(i16::from(b));
    sb = 10;
    // 128 wraps to -128 in ShortInt arithmetic, as in Turbo Pascal.
    sb += -128;
    i = 10;
    // 32768 wraps to -32768 in Integer arithmetic, as in Turbo Pascal.
    i += -32768;
    pwriteln!(sb, " ", i);
    // 32768 wraps to -32768 in Integer arithmetic, as in Turbo Pascal.
    i -= -32768;
    pwriteln!(i);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
