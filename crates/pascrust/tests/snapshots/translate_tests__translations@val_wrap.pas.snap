//! Generated by PascRust from `val_wrap.pas`. Do not edit by hand.
//! Pascal: `program ValWrap;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `ValWrap`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // Val reads a number as a 64-bit integer and stores it in the variable's
    // type, wrapping if it doesn't fit; a minus sign is an error for an
    // unsigned type, and after an error the variable is 0. TP left these
    // cases undefined; this follows Free Pascal, whose output this is.
    let mut i: i16 = 0;
    let mut code: i16 = 0;
    let mut b: u8 = 0;
    let mut w_: u16 = 0;
    let mut l: i32 = 0;
    val("40000", &mut i, &mut code);
    pwriteln!(i, " ", code);
    val("300", &mut b, &mut code);
    pwriteln!(i16::from(b), " ", code);
    val("70000", &mut i, &mut code);
    pwriteln!(i, " ", code);
    val("$FFFF", &mut i, &mut code);
    pwriteln!(i, " ", code);
    val("-1", &mut w_, &mut code);
    pwriteln!(w_, " ", code);
    val("3000000000", &mut l, &mut code);
    pwriteln!(l, " ", code);
    val("12x", &mut i, &mut code);
    pwriteln!(i, " ", code);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
