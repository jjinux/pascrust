//! Generated by pascrust from `control.pas`. Do not edit by hand.
//! Pascal: `program Control;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `Control`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut total: i16 = 0;
    let mut done: bool = false;
    total = 0;
    // `i` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for i_value in 1..=10 {
        i = i_value;
        total += i;
    }
    pwriteln!("sum 1..10 = ", total);
    for i_value in (1..=3).rev() {
        i = i_value;
        pwrite!(i, " ");
    }
    pwriteln!();
    i = 0;
    while i < 5 {
        i += 2;
    }
    pwriteln!("while ended at ", i);
    i = 10;
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        i -= 3;
        if i < 0 {
            break;
        }
    }
    pwriteln!("repeat ended at ", i);
    for c in b'a'..=b'e' {
        pwrite!(c);
    }
    pwriteln!();
    for i_value in 1..=5 {
        i = i_value;
        match i {
            1 => {
                pwriteln!("one");
            }
            2 | 3 => {
                pwriteln!("two or three");
            }
            _ => {
                pwriteln!("big");
            }
        }
    }
    done = false;
    if !done && total > 50 {
        pwriteln!("yes");
    } else if done {
        pwriteln!("done");
    } else {
        pwriteln!("no");
    }
    for i_value in 1..=100 {
        i = i_value;
        if i % 7 == 0 {
            continue;
        }
        if i > 10 {
            break;
        }
        pwrite!(i, " ");
    }
    pwriteln!();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
