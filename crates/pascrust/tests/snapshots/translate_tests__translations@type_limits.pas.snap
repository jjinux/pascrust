//! Generated by PascRust from `type_limits.pas`. Do not edit by hand.
//! Pascal: `program TypeLimits;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// High and Low of a type are names in the Rust, where its type is known:
// i16::MAX for High(Integer), N for High(Index) with Index = 1..N.

const N: i16 = 10;

/// The main program: the `begin ... end.` block of `TypeLimits`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut l: i32 = 0;
    let mut b: u8 = 0;
    let mut c: u8 = 0;
    let mut s: i8 = 0;
    let mut x: i8 = 0;
    i = i16::MAX;
    l = i32::from(i16::MAX);
    w_ = u16::MAX;
    l = i32::MIN;
    b = u8::MAX;
    c = u8::MAX;
    s = i8::MIN;
    x = N as i8;
    i = 1;
    if i < i16::MAX {
        pwriteln!(i, " ", l, " ", w_, " ", i16::from(b), " ", i16::from(c), " ", s, " ", x);
    }
    pwriteln!(32767, " ", 32767 + 1, " ", 10);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
