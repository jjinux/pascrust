//! Generated by PascRust from `set_constant_patterns.pas`. Do not edit by hand.
//! Pascal: `program SetPat;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// x in [...] with constant elements is a match pattern; a constant
// expression in it (K + 1, Succ(Mon)) is written as its value.

const K: i16 = 5;
const FIRST: u8 = b'a';
const WEEKEND: Day = Day::Sat;

/// Pascal: `(Mon, Tue, Wed, Thu, Fri, Sat, Sun)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Day {
    #[default]
    Mon,
    Tue,
    Wed,
    Thu,
    Fri,
    Sat,
    Sun,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Day {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Day {
    const VALUES: &'static [Self] = &[Day::Mon, Day::Tue, Day::Wed, Day::Thu, Day::Fri, Day::Sat, Day::Sun];
}

/// The main program: the `begin ... end.` block of `SetPat`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut b: u8 = 0;
    let mut c: u8 = 0;
    let mut d: Day = Day::Mon;
    i = 7;
    b = 6;
    c = b'c';
    d = Day::Sun;
    pwriteln!(matches!(i, 6..=10), " ", matches!(i16::from(b), K | 6), " ", matches!(i, -5..=-1 | 10));
    pwriteln!(matches!(c, FIRST..=b'c'), " ", matches!(c, b'b'));
    pwriteln!(matches!(d, Day::Tue | Day::Sat | Day::Sun), " ", matches!(d, Day::Sat));
    pwriteln!(matches!(i16::from(b), K..=10), " ", matches!(i, K));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
