// ===== src/main.rs =====
//! Generated by pascrust from `units_demo.pas`. Do not edit by hand.
//! Pascal: `program UnitsDemo;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod geometry;
mod labels;

#[allow(unused_imports)]
use crate::geometry::*;
#[allow(unused_imports)]
use crate::labels::*;
use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `UnitsDemo`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut created: i16 = 0; // a unit global, counted by MakePoint
    let mut p: Point = Point::default();
    // The initialization part of unit `Geometry`.
    geometry_init(&mut created);
    // The initialization part of unit `Labels`.
    labels_init();
    p = make_point(&mut created, 3, 4);
    tag(p, pstr("home"));
    tag(make_point(&mut created, 1, 2), pstr("work"));
    pwriteln!(labels_name(), " ", SIDES, " ", created);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/geometry.rs =====
//! Generated by pascrust from `geometry.pas`. Do not edit by hand.
//! Pascal: `unit Geometry;`

#[allow(unused_imports)]
use crate::labels::*;
#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

// Used by units_demo.pas.

pub const SIDES: i16 = 4;

/// Pascal: `record x, y: integer; end`
#[derive(Clone, Copy, Debug, Default)]
pub struct Point {
    pub x: i16,
    pub y: i16,
}

/// Pascal: `function MakePoint(x, y: integer): Point;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
pub fn make_point(created: &mut i16, x: i16, y: i16) -> Point {
    let mut result: Point = Point::default();
    let mut p: Point = Point::default();
    p.x = x;
    p.y = y;
    *created += 1;
    result = p;
    result
}

/// Pascal: `procedure Describe(p: Point);`
pub fn describe(p: Point) {
    pwriteln!("(", p.x, ", ", p.y, ")");
}

/// Pascal: `function Name: string;`
pub fn name() -> PString {
    let mut result: PString = PString::new();
    result = pstr("geometry");
    result
}

/// The initialization part of unit `Geometry`, run before the main program.
pub fn geometry_init(created: &mut i16) {
    *created = 0;
    pwriteln!("Geometry initialized");
}

// ===== src/labels.rs =====
//! Generated by pascrust from `labels.pas`. Do not edit by hand.
//! Pascal: `unit Labels;`

#[allow(unused_imports)]
use crate::geometry::*;
#[allow(unused_imports)]
use pascrust_runtime::prelude::*;

// Used by units_demo.pas. Declares `Name` too: the program uses both units,
// and Turbo Pascal's rule is that the unit listed later wins.

/// Pascal: `function Name: string;`
pub fn labels_name() -> PString {
    let mut result: PString = PString::new();
    result = pstr("labels");
    result
}

/// Pascal: `procedure Tag(p: Point; text: string);`
pub fn tag(p: Point, text: PString) {
    pwrite!(text, " at ");
    describe(p);
}

/// The initialization part of unit `Labels`, run before the main program.
pub fn labels_init() {
    pwriteln!("Labels initialized");
}
