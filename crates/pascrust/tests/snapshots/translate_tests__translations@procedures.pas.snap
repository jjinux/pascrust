//! Generated by pascrust from `procedures.pas`. Do not edit by hand.
//! Pascal: `program Procedures;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Swap(var a, b: integer);`
fn swap(a: &mut i16, b: &mut i16) {
    let mut t: i16 = 0;
    t = *a;
    *a = *b;
    *b = t;
}

/// Pascal: `function Fact(n: integer): longint;`
fn fact(n: i16) -> i32 {
    let mut result: i32 = 0;
    if n <= 1 {
        result = 1;
    } else {
        result = i32::from(n) * fact(n - 1);
    }
    result
}

/// Pascal: `function IsOdd(n: integer): boolean;`
fn is_odd(n: i16) -> bool {
    let mut result: bool = false;
    if n == 0 {
        result = false;
    } else {
        result = is_even(n - 1);
    }
    result
}

/// Pascal: `function IsEven(n: integer): boolean;`
fn is_even(n: i16) -> bool {
    let mut result: bool = false;
    if n == 0 {
        result = true;
    } else {
        result = is_odd(n - 1);
    }
    result
}

/// Pascal: `procedure Bump;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn bump(counter: &mut i16) {
    *counter += 1;
}

/// Pascal: `procedure BumpTwice;`
///
/// Uses globals, which are passed in as parameters.
fn bump_twice(counter: &mut i16) {
    bump(counter);
    bump(counter);
}

/// Pascal: `procedure Report(limit: integer);`
fn report(limit: i16) {
    let mut total: i16 = 0;
    total = 0;
    report_add_up_to(&mut total, limit);
    pwriteln!("total = ", total);
}

/// Pascal: `procedure Add(n: integer);`
///
/// Nested inside `Report` in the Pascal source. Rust functions can't see
/// their caller's local variables, so this one was "lifted" to the top level
/// and any outer variables it uses are passed in as extra parameters.
fn report_add(total: &mut i16, n: i16) {
    *total += n;
}

/// Pascal: `procedure AddUpTo(n: integer);`
///
/// Nested inside `Report`; lifted, with outer variables passed in.
fn report_add_up_to(total: &mut i16, n: i16) {
    if n > 0 {
        report_add(total, n);
        report_add_up_to(total, n - 1);
    }
}

/// Pascal: `function Twice(n: integer): integer;`
fn twice(mut n: i16) -> i16 {
    let mut result: i16 = 0;
    n *= 2;
    result = n;
    if n > 100 {
        return result;
    }
    result = n + 1;
    result
}

/// The main program: the `begin ... end.` block of `Procedures`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // Value and var parameters, functions, recursion, forward declarations,
    // nested procedures that use outer locals, and globals.
    let mut x: i16 = 0;
    let mut y: i16 = 0;
    let mut counter: i16 = 0;
    x = 1;
    y = 2;
    swap(&mut x, &mut y);
    pwriteln!(x, " ", y);
    pwriteln!(fact(10));
    pwriteln!(is_even(10), " ", is_odd(7));
    counter = 0;
    bump_twice(&mut counter);
    bump(&mut counter);
    pwriteln!("counter = ", counter);
    report(4);
    pwriteln!(twice(5), " ", twice(60));
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
