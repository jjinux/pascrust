}

/// Pascal: `function Factorial(N: Integer): LongInt;`
///
/// Kept in a `Func`, so it takes the globals any `Func` routine uses.
fn factorial(fact: Func, n: i16) -> i32 {
    let mut result: i32 = 0;
    if n <= 1 {
        result = 1;
    } else {
        result = i32::from(n) * fact.get()(fact, n - 1);
    }
