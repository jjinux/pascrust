}

// `Deref` lets the struct be used as the `ProcVar` inside it: `f.get()`,
// `f.is_nil()` and `f.address()` reach the `ProcVar`'s methods.
impl std::ops::Deref for State {
    type Target = ProcVar<fn(&mut State)>;

    fn deref(&self) -> &Self::Target {
        &self.0
    }
}

file_record!(newtype State);

