// state machine (each state sets the next) and recursion through a
// global function variable. Rust's type aliases can't name themselves, so
// these types are structs; one is stored in a file too. Output from
// fpc -Mtp except the last two lines: TP's procedural value is 4 bytes
// (Free Pascal's 8, padded), and a stored one reads back as nil.

/// Pascal: `procedure`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
///
/// A `State` routine uses a `State` variable, and a type alias can't name
/// itself, so this one is a struct around its `ProcVar`.
#[derive(Clone, Copy, Debug, Default, PartialEq)]
struct State(ProcVar<fn(&mut State)>);

impl State {
    const fn nil() -> State {
        State(ProcVar::nil())
