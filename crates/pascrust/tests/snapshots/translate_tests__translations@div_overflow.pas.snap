//! Generated by PascRust from `div_overflow.pas`. Do not edit by hand.
//! Pascal: `program DivOverflow;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `DivOverflow`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // The most negative Integer divided by -1 doesn't fit an Integer. TP's
    // 16-bit divide trapped, which it reported as runtime error 200, as for
    // division by zero. (Free Pascal divides in a wider type and prints
    // 32768, so this .out is written by hand.)
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    i = -32767 - 1;
    j = -1;
    pwriteln!("dividing");
    pwriteln!(i / j);
    pwriteln!("not reached");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
