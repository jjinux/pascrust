//! Generated by PascRust from `pchar_edges.pas`. Do not edit by hand.
//! Pascal: `program PCharEdges;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Edge cases of the Strings unit: StrPos of an empty string is the end,
// StrLen(nil) is 0, and the StrL... routines look at no more than MaxLen
// characters (a string without a #0 within them is fine). Output from
// fpc -Mtp.

/// The main program: the `begin ... end.` block of `PCharEdges`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: PChar = PChar::nil();
    let mut p: PChar = PChar::nil();
    let mut q: PChar = PChar::nil();
    let mut buf: PArray<u8, 0, 10> = PArray::default();
    s = str_new(&PChar::literal("abc"));
    p = str_pos(&s, &PChar::literal(""));
    pwriteln!(p.is_nil(), " ", p.diff(&s));
    q = PChar::nil();
    pwriteln!(str_len(&q));
    p = PChar::alloc(4);
    p.set(0, b'x');
    p.set(1, b'y');
    p.set(2, b'z');
    p.set(3, b'w');
    // A Char array used as a PChar: Rust can't point into the array, so
    // the statement gets a copy of its characters, copied back after it
    // if it may change them.
    let buf_chars = PChar::copy_of(buf.as_slice());
    str_l_copy(&buf_chars, &p, 2);
    buf_chars.copy_to(buf.as_mut_slice());
    pwriteln!(
        "[",
        buf,
        "] ",
        str_l_comp(&p, &PChar::literal("xyq"), 2),
        " ",
        str_l_i_comp(&p, &PChar::literal("XYZW"), 4)
    );
    let buf_chars = PChar::copy_of(buf.as_slice());
    str_copy(&buf_chars, &PChar::literal("ab"));
    buf_chars.copy_to(buf.as_mut_slice());
    let buf_chars = PChar::copy_of(buf.as_slice());
    str_l_cat(&buf_chars, &p, 4);
    buf_chars.copy_to(buf.as_mut_slice());
    pwriteln!("[", buf, "]");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
