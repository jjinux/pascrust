//! Generated by pascrust from `io_result.pas`. Do not edit by hand.
//! Pascal: `program IOCheck;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `function Exists(name: string): Boolean;`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn exists(f: &mut PText, name: PString) -> bool {
    let mut result: bool = false;
    f.assign(name);
    // `{$I-}`: an I/O error in `io_unchecked` sets `IOResult` instead of
    // stopping the program.
    io_unchecked(|| f.reset());
    result = io_result() == 0;
    result
}

/// The main program: the `begin ... end.` block of `IOCheck`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PText = PText::default();
    let mut n: i16 = 0;
    let mut code: i16 = 0;
    pwriteln!("missing: ", exists(&mut f, pstr("no_such_file.txt")));
    code = io_result();
    pwriteln!("after reading it: ", code);
    io_unchecked(|| f.reset());
    io_unchecked(|| f.close());
    code = io_result();
    pwriteln!("close was skipped: ", code);
    io_unchecked(|| preadln!(&mut n));
    code = io_result();
    pwriteln!("bad number: ", code);
    preadln!(&mut n);
    code = io_result();
    pwriteln!("good number: ", n, " ", code);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
