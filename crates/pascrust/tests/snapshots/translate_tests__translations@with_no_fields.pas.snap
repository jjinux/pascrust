/// The main program: the `begin ... end.` block of `WithNoFields`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: Tr = Tr::default();
    // `goto Done` jumps forward: Rust can't jump, but it can leave a block
    // early, so the statements it skips are in the block `'done`, and the
    // jump is `break 'done`.
    'done: {
        break 'done;
        // Never runs, in the Pascal either:
        // pwriteln!(1);
    }
    // Pascal `with`: Rust has no equivalent, so each field is written out in full.
    r.x = 2;
    pwriteln!(r.x);
