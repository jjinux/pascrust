//! Generated by PascRust from `constant_expressions.pas`. Do not edit by hand.
//! Pascal: `program ConstantExpressions;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it. And
// Turbo Pascal's integer arithmetic wraps around, as this program's does
// (Cargo.toml turns overflow checks off), so a sum rustc can see wraps
// (`b := 250; Inc(b, 10)`) is fine too.
#![allow(unused_variables, unused_assignments, dead_code, arithmetic_overflow)]

use pascrust_runtime::prelude::*;

// Constants worked out from other constants keep the names in the Rust
// (const M = K * 2 + 1 is `K * 2 + 1`), and are worked out in 32 bits, as
// TP does: C + 1 with C = 32767 is 32768, even where C is an Integer.

const K: i16 = 5;
const C: i16 = 32767;
const M: i16 = K * 2 + 1;
const LO: i16 = 1;
const HI: i16 = LO + K;
const Z: i16 = 255 & K;
const CH_K: u8 = b'F'; // Chr(Ord('A') + K)
const WIDE: i32 = C as i32 + 1;
const PI2: f64 = 6.28;
const NEG: i16 = -K;

/// The main program: the `begin ... end.` block of `ConstantExpressions`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut l: i32 = 0;
    i = 2;
    l = i32::from(K) + 30000;
    pwriteln!(l);
    i *= 20000;
    pwriteln!(i);
    i = 3;
    i *= (i32::from(C) + 1) as i16;
    pwriteln!(i);
    l = i32::from(C) + 1;
    pwriteln!(l, " ", i32::from(C) + 1);
    pwriteln!(30000 + 30000, " ", (30000 + 30000) / 2);
    pwriteln!(M, " ", HI, " ", Z, " ", CH_K, " ", WIDE, " ", wd(PI2, 0, 2), " ", NEG);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
