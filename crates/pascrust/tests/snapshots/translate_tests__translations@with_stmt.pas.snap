//! Generated by PascRust from `with_stmt.pas`. Do not edit by hand.
//! Pascal: `program WithStmt;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// with r do ... lets the body use r's fields (and an object's methods) by
// their bare names.
/// Pascal: `record x, y: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Point {
    x: i16,
    y: i16,
}

/// Pascal: `record topLeft, size: Point; name: string[10]; end`
#[derive(Clone, Copy, Debug, Default)]
struct Rect {
    top_left: Point,
    size: Point,
    name: PString,
}

/// Pascal: `^Node`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PNode = Ptr<Node>;

/// Pascal: `record value: Integer; next: PNode; end`
#[derive(Clone, Debug, Default)]
struct Node {
    value: i16,
    next: PNode,
}

/// Pascal: `object count: Integer; procedure Bump; end`
#[derive(Clone, Copy, Debug, Default)]
struct Counter {
    count: i16,
}

// A Pascal object's methods go in an `impl` block. Each takes `&mut self`,
// which is Pascal's implicit `Self` parameter.
impl Counter {
    /// Pascal: `procedure Counter.Bump;`
    fn bump(&mut self) {
        self.count += 1;
    }
}

/// The main program: the `begin ... end.` block of `WithStmt`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut r: Rect = Rect::default();
    let mut pts: PArray<Point, 1, 3> = PArray::default();
    let mut x: i16 = 0;
    let mut head: PNode = Ptr::nil();
    let mut p: PNode = Ptr::nil();
    let mut c: Counter = Counter::default();
    let mut node: PNode = Ptr::nil();
    let mut node_2: PNode = Ptr::nil();
    let mut node_3: PNode = Ptr::nil();
    x = 100;
    // Pascal `with`: Rust has no equivalent, so each field is written out in full.
    r.name = pstr("box");
    r.top_left.x = 1; // the field: the innermost with wins
    r.top_left.y = 2;
    r.size.x = 30;
    r.size.y = 40;
    pwriteln!(r.name, " ", r.top_left.x, " ", r.top_left.y, " ", r.size.x, " ", r.size.y, " ", x);
    pwriteln!(r.name, " ", r.top_left.x + r.top_left.y);
    for i in 1_i16..=3 {
        pts[i].x = i;
        pts[i].y = i * i;
    }
    pwriteln!(pts[3].x, " ", pts[3].y);
    // A list built with with p^ do: the body changes p, but the with still
    // means the record p pointed to when it started.
    head = Ptr::nil();
    for i in 1_i16..=3 {
        p = Ptr::alloc();
        node = p.clone();
        node.get_mut().value = i * 10;
        node.get_mut().next = head.clone();
        head = p.clone();
        p = Ptr::nil();
        node.get_mut().value += 1;
    }
    p = head.clone();
    while !p.is_nil() {
        node_2 = p.clone();
        pwrite!(node_2.get().value, " ");
        p = node_2.get().next.clone();
    }
    pwriteln!();
    node_3 = head.get().next.clone();
    pwriteln!(node_3.get().value);
    c.count = 0;
    c.bump();
    c.bump();
    pwriteln!(c.count);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
