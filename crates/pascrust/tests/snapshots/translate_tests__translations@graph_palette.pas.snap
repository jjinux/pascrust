//! Generated by PascRust from `graph_palette.pas`. Do not edit by hand.
//! Pascal: `program GraphPalette;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Graph's palettes, GraphDefaults, the mode queries, SetAspectRatio,
// SetUserCharSize and the font and buffer fakes (the tests run with
// PASCRUST_GRAPH=headless). Self-checking: Free Pascal's Graph unit needs
// a real screen, so this .out is built from the checks, by hand.

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `GraphPalette`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    let mut lo: i16 = 0;
    let mut hi: i16 = 0;
    let mut font: i16 = 0;
    let mut pal: PaletteType = PaletteType::default();
    let mut xasp: u16 = 0;
    let mut yasp: u16 = 0;
    checks = 0;
    failures = 0;
    driver = i16::from(DETECT);
    init_graph(&mut driver, &mut mode, "");
    get_palette(&mut pal);
    check(
        &mut checks,
        &mut failures,
        i16::from(pal.size) == 16 && i16::from(pal.colors[RED]) == 4 && i16::from(pal.colors[BROWN]) == 20,
        pstr("GetPalette: the EGA colours"),
    );
    check(&mut checks, &mut failures, get_palette_size() == 16, pstr("GetPaletteSize"));
    set_palette(RED, 63);
    get_palette(&mut pal);
    check(&mut checks, &mut failures, i16::from(pal.colors[RED]) == 63, pstr("SetPalette shows in GetPalette"));
    for i in 0..=i16::from(MAX_COLORS) {
        pal.colors[i] = -1;
    }
    pal.colors[BLUE] = 5;
    set_all_palette(&mut pal);
    get_palette(&mut pal);
    check(
        &mut checks,
        &mut failures,
        i16::from(pal.colors[BLUE]) == 5 && i16::from(pal.colors[RED]) == 63,
        pstr("SetAllPalette: -1 leaves a colour alone"),
    );
    get_default_palette(&mut pal);
    check(
        &mut checks,
        &mut failures,
        i16::from(pal.colors[BLUE]) == 1 && i16::from(pal.colors[RED]) == 4,
        pstr("GetDefaultPalette"),
    );
    set_rgb_palette(pal.colors[RED], 63, 0, 0);
    set_color(RED);
    put_pixel(5, 5, YELLOW);
    graph_defaults();
    get_palette(&mut pal);
    check(
        &mut checks,
        &mut failures,
        get_color() == u16::from(WHITE) && i16::from(pal.colors[RED]) == 4,
        pstr("GraphDefaults resets colours and the palette"),
    );
    check(&mut checks, &mut failures, get_pixel(5, 5) == u16::from(YELLOW), pstr("but not the picture"));
    set_aspect_ratio(5000, 10000);
    get_aspect_ratio(&mut xasp, &mut yasp);
    check(&mut checks, &mut failures, xasp == 5000 && yasp == 10000, pstr("SetAspectRatio and GetAspectRatio"));
    check(&mut checks, &mut failures, get_driver_name() == "EGAVGA", pstr("GetDriverName"));
    check(
        &mut checks,
        &mut failures,
        get_max_mode() == i16::from(VGA_HI) && get_mode_name(VGA_HI) == "640 x 480 VGA",
        pstr("GetMaxMode and GetModeName"),
    );
    get_mode_range(VGA, &mut lo, &mut hi);
    check(&mut checks, &mut failures, lo == i16::from(VGA_LO) && hi == i16::from(VGA_HI), pstr("GetModeRange of VGA"));
    get_mode_range(CGA, &mut lo, &mut hi);
    check(&mut checks, &mut failures, lo == 0 && hi == 4, pstr("GetModeRange of CGA"));
    get_mode_range(99, &mut lo, &mut hi);
    check(&mut checks, &mut failures, lo == -1 && hi == -1, pstr("GetModeRange of no driver"));
    font = install_user_font("LITT.CHR");
    set_graph_buf_size(8192);
    check(&mut checks, &mut failures, font > i16::from(GOTHIC_FONT), pstr("InstallUserFont gives a new font number"));
    set_text_style(DEFAULT_FONT, HORIZ_DIR, USER_CHAR_SIZE);
    set_user_char_size(1, 1, 3, 1);
    check(&mut checks, &mut failures, text_height("A") == 24, pstr("SetUserCharSize scales the text"));
    close_graph();
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
