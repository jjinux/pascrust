//! Generated by pascrust from `crt_plain.pas`. Do not edit by hand.
//! Pascal: `program CrtPlain;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `CrtPlain`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut c: u8 = 0;
    let mut n: i16 = 0;
    clr_scr();
    text_color(YELLOW);
    text_background(BLUE);
    goto_xy(10, 5);
    pwriteln!("Press keys...");
    n = 0;
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        c = read_key();
        n += 1;
        pwriteln!("key ", n, ": ", i16::from(c));
        if c.to_ascii_uppercase() == b'Q' {
            break;
        }
    }
    if key_pressed() {
        pwriteln!("more keys waiting");
    }
    pwriteln!("window ", i16::from(wind_max() as u8) + 1, "x", i16::from((wind_max() >> 8) as u8) + 1);
    delay(1000);
    norm_video();
    pwriteln!("bye");
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
