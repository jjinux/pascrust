//! Generated by pascrust from `case_labels.pas`. Do not edit by hand.
//! Pascal: `program CaseLabels;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Case labels: wide ranges, ranges that cover a whole integer type, enum
// ranges, and labels an earlier arm already covers. Self-checking. (Free
// Pascal rejects a label that appears twice, which TP allows, so this .out
// is built from the checks, by hand.)
/// Pascal: `(Mon, Tue, Wed, Thu, Fri, Sat, Sun)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Day {
    #[default]
    Mon,
    Tue,
    Wed,
    Thu,
    Fri,
    Sat,
    Sun,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Day {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Day {
    const VALUES: &'static [Self] = &[Day::Mon, Day::Tue, Day::Wed, Day::Thu, Day::Fri, Day::Sat, Day::Sun];
}

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `CaseLabels`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut l: i32 = 0;
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut sh: i8 = 0;
    let mut b: u8 = 0;
    let mut d: Day = Day::Mon;
    let mut what: PString = PString::new();
    checks = 0;
    failures = 0;
    l = 5;
    match l {
        1..=1000000000 => {
            what = pstr("big");
        }
        _ => {}
    }
    check(&mut checks, &mut failures, what == "big", pstr("a range of a billion values"));
    i = -7;
    match i {
        -32768..=-1 => {
            what = pstr("negative");
        }
        0..=32767 => {
            what = pstr("not negative");
        }
    }
    check(&mut checks, &mut failures, what == "negative", pstr("two ranges cover every Integer"));
    w_ = 65535;
    match w_ {
        0..=65535 => {
            what = pstr("word");
        }
    }
    check(&mut checks, &mut failures, what == "word", pstr("one range covers every Word"));
    sh = -128;
    match sh {
        -128..=127 => {
            what = pstr("shortint");
        }
        #[allow(unreachable_patterns)]
        _ => {
            // The arms above cover every value, so Pascal's `else` never runs.
            what = pstr("never");
        }
    }
    check(&mut checks, &mut failures, what == "shortint", pstr("a ShortInt case with an else that can't run"));
    d = Day::Wed;
    match d {
        Day::Mon | Day::Tue | Day::Wed | Day::Thu | Day::Fri => {
            what = pstr("weekday");
        }
        Day::Sat | Day::Sun => {
            what = pstr("weekend");
        }
    }
    check(&mut checks, &mut failures, what == "weekday", pstr("an enum range: Mon..Fri"));
    d = Day::Sun;
    match d {
        Day::Mon | Day::Tue | Day::Wed | Day::Thu | Day::Fri => {
            what = pstr("weekday");
        }
        _ => {
            what = pstr("weekend");
        }
    }
    check(&mut checks, &mut failures, what == "weekend", pstr("an enum range with an else"));
    b = 2;
    match b {
        1 | 2 => {
            what = pstr("one or two");
        }
        // 1..=2 also appeared in an earlier arm, which wins.
        0 => {
            what = pstr("zero");
        }
        _ => {
            what = pstr("more");
        }
    }
    check(&mut checks, &mut failures, what == "one or two", pstr("a range an earlier arm covers: the first arm wins"));
    b = 9;
    match b {
        3..=7 => {
            what = pstr("middle");
        }
        1..=5 | 6..=10 => {
            what = pstr("low");
        }
        _ => {}
    }
    check(&mut checks, &mut failures, what == "low", pstr("ranges that overlap an earlier one"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
