//! Generated by pascrust from `dos_misc.pas`. Do not edit by hand.
//! Pascal: `program DosMisc;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `DosMisc`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // The smaller Dos routines: FSplit, EnvCount/EnvStr, DosError as a
    // variable, and the ones pascrust fakes (DosVersion, DiskFree/DiskSize,
    // SetDate/SetTime, the Ctrl-Break and verify switches, SwapVectors).
    // Self-checking. (Free Pascal reports the real system's version and disk
    // space, so this .out is built from the checks, by hand.)
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut d: PString = PString::new();
    let mut n: PString = PString::new();
    let mut e: PString = PString::new();
    let mut b: bool = false;
    let mut v: u16 = 0;
    let mut r: Registers = Registers::default();
    checks = 0;
    failures = 0;
    f_split("C:\\GAMES\\SCORES.DAT", &mut d, &mut n, &mut e);
    check(
        &mut checks,
        &mut failures,
        d == "C:\\GAMES\\" && n == "SCORES" && e == ".DAT",
        pstr("FSplit of a full path"),
    );
    f_split("README", &mut d, &mut n, &mut e);
    check(&mut checks, &mut failures, d == "" && n == "README" && e == "", pstr("FSplit of a bare name"));
    f_split("A:LONGFILENAME.TEXT", &mut d, &mut n, &mut e);
    check(
        &mut checks,
        &mut failures,
        d == "A:" && n == "LONGFILE" && e == ".TEX",
        pstr("FSplit cuts to NameStr and ExtStr"),
    );
    check(&mut checks, &mut failures, env_count() > 0, pstr("EnvCount"));
    check(&mut checks, &mut failures, pos("=", env_str(1)) > 1, pstr("EnvStr is NAME=value"));
    check(&mut checks, &mut failures, env_str(0) == "", pstr("EnvStr(0) is empty"));
    v = dos_version();
    check(
        &mut checks,
        &mut failures,
        i16::from(v as u8) == 6 && i16::from((v >> 8) as u8) == 22,
        pstr("DosVersion is 6.22"),
    );
    check(
        &mut checks,
        &mut failures,
        disk_size(0) > 0 && disk_free(0) > 0 && disk_free(0) <= disk_size(0),
        pstr("DiskFree and DiskSize"),
    );
    check(&mut checks, &mut failures, disk_free(0) / (disk_size(0) / 100) == 50, pstr("DiskFree is half of DiskSize"));
    check(&mut checks, &mut failures, disk_size(30) == -1, pstr("DiskSize of an invalid drive"));
    set_cbreak(true);
    get_cbreak(&mut b);
    check(&mut checks, &mut failures, b, pstr("SetCBreak and GetCBreak"));
    set_verify(true);
    get_verify(&mut b);
    check(&mut checks, &mut failures, b, pstr("SetVerify and GetVerify"));
    set_date(1997, 3, 11);
    set_time(7, 0, 0, 0);
    swap_vectors();
    r.ax = 4660;
    check(&mut checks, &mut failures, r.ax == 4660, pstr("a Registers record can be declared and used"));
    set_dos_error(5);
    check(&mut checks, &mut failures, dos_error() == 5, pstr("DosError is a variable"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
