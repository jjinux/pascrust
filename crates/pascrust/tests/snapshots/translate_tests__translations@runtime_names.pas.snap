//! Generated by pascrust from `runtime_names.pas`. Do not edit by hand.
//! Pascal: `program RuntimeNames;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `^CharSet`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PSet_ = Ptr<PSet<u8>>;

/// Pascal: `array[1..3] of Integer`
type PArray_ = PArray<i16, 1, 3>;

/// Pascal: `^Integer`
type Ptr_ = Ptr<i16>;

/// Pascal: `record name: PText; size: Integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct PFile_ {
    name: PString,
    size: i16,
}

// Type names that the runtime also uses (PSet, PArray, Ptr, PText,
// PFile) are renamed in the Rust, so a program can use them too.
// Pascal: `CharSet = set of Char`

/// The main program: the `begin ... end.` block of `RuntimeNames`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: PSet_ = Ptr::nil();
    let mut a: PArray_ = PArray_::default();
    let mut p: Ptr_ = Ptr::nil();
    let mut f: PFile_ = PFile_::default();
    s = Ptr::alloc();
    *s.get_mut() = pset![b'a', b'b'];
    a[2] = 7;
    p = Ptr::alloc();
    *p.get_mut() = a[2] * 2;
    f.name = pstr("notes.txt");
    f.size = *p.get();
    pwriteln!((*s.get()).contains(b'b'), " ", a[2], " ", *p.get(), " ", f.name, " ", f.size);
    s.dispose();
    p.dispose();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
