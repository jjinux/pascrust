/// The main program: the `begin ... end.` block of `GeneratedNames`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PFile<Rec> = PFile::default();
    let mut r: Rec = Rec::default();
    let mut d: Default_ = Default_::default();
    let mut p: PShape = Ptr::nil();
