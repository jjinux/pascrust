// ===== src/main.rs =====
//! Generated by pascrust from `virtual_units.pas`. Do not edit by hand.
//! Pascal: `program VirtualUnits;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// Each Pascal unit becomes a Rust module.
mod shapes;

#[allow(unused_imports)]
use crate::shapes::*;
use pascrust_runtime::prelude::*;

// A descendant declared in the program of an object whose unit has the
// virtual method.
/// Pascal: `^TCircle`
///
/// A Pascal pointer becomes a `Ptr`, the runtime's safe handle to a shared
/// heap record (an `Rc<RefCell<...>>` inside): using `nil` or a disposed
/// record is a runtime error instead of undefined behaviour.
type PCircle = Ptr<AnyShape>;

/// Pascal: `object(TShape) radius: Integer; procedure Draw; virtual; end`
#[derive(Clone, Copy, Debug, Default)]
struct TCircle {
    /// The inherited part: `TCircle` descends from `TShape`. Rust has no struct
    /// inheritance, so the parent object is embedded as a field, and inherited
    /// fields and methods are reached through it (`self.base.x`).
    base: TShape,
    radius: i16,
}

// Turbo Pascal finds a virtual method's version at run time, from the
// object's real type. Here each object type in the hierarchy has a trait
// like this one: its default methods are written once but run with `self`
// being the real object, so a call to a virtual method inside them goes to
// the right version. Each object implements the traits of its ancestors.
trait TCircleMethods: TShapeMethods {
    /// The `TCircle` part of the object, for its fields.
    fn t_circle(&mut self) -> &mut TCircle;

    /// Pascal: `procedure TCircle.Draw;`
    fn t_circle_draw(&mut self) {
        pwriteln!("circle ", self.t_circle().base.x, " radius ", self.t_circle().radius);
    }
}

impl TCircleMethods for TCircle {
    fn t_circle(&mut self) -> &mut TCircle {
        self
    }
}

impl TShapeMethods for TCircle {
    fn t_shape(&mut self) -> &mut TShape {
        &mut self.base
    }
    fn draw(&mut self) {
        self.t_circle_draw()
    }
}

/// The main program: the `begin ... end.` block of `VirtualUnits`.
/// Its local variables are the Pascal program's global variables.
/// (Including the global variables of every unit.)
fn pascal_main() {
    let mut c: TCircle = TCircle::default();
    let mut p: PShape = Ptr::nil();
    let mut circle: PCircle = Ptr::nil();
    c.base.init(1);
    c.radius = 2;
    show_all(&mut c);
    circle = Ptr::new(AnyShape::Circle(TCircle::default()));
    circle.get_mut().as_t_circle_mut().base.init(3);
    p = circle.clone();
    p.get_mut().show();
    p.dispose();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

