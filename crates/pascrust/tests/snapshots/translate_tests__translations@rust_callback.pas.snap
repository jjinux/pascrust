// ===== src/main.rs =====
//! Generated by PascRust from `rust_callback.pas`. Do not edit by hand.
//! Pascal: `program RustCallback;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

// The Rust files the program links with `{$L file.rs}`: its `external`
// routines are there.
mod rust_callback;

use pascrust_runtime::prelude::*;

// Rust calling back into Pascal: the program passes its own function to
// a Rust routine as a procedural value, and the Rust sorts with it.
// Output written by hand: Free Pascal can't link Rust.

/// Pascal: `function(A, B: Integer): Boolean`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type TLess = ProcVar<fn(i16, i16) -> bool>;

/// Pascal: `array[1..6] of Integer`
type TList = PArray<i16, 1, 6>;

// Pascal: `procedure SortWith(var Items: TList; Less: TLess);`
// Written in Rust, in `rust_callback.rs`: `pub fn sort_with(items: &mut TList, less: TLess)`

/// Pascal: `function Descending(A, B: Integer): Boolean;`
fn descending(a: i16, b: i16) -> bool {
    let mut result: bool = false;
    result = a > b;
    result
}

/// The main program: the `begin ... end.` block of `RustCallback`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut items: TList = TList::default();
    items[1] = 3;
    items[2] = 1;
    items[3] = 4;
    items[4] = 1;
    items[5] = 5;
    items[6] = 9;
    rust_callback::sort_with(&mut items, TLess::of(descending, "Descending"));
    for i in 1_i16..=6 {
        pwrite!(items[i], " ");
    }
    pwriteln!();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}

// ===== src/rust_callback.rs =====
//! The Rust half of rust_callback.pas: a sort that calls back into Pascal.

use crate::{TLess, TList};

/// An insertion sort that asks Pascal which of two items comes first.
pub fn sort_with(items: &mut TList, less: TLess) {
    let less = less.get();
    for i in 2..=6 {
        let mut j = i;
        while j > 1 && less(items[j], items[j - 1]) {
            let t = items[j];
            items[j] = items[j - 1];
            items[j - 1] = t;
            j -= 1;
        }
    }
}
