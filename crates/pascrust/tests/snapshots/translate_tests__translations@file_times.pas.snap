//! Generated by pascrust from `file_times.pas`. Do not edit by hand.
//! Pascal: `program FileTimes;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// The main program: the `begin ... end.` block of `FileTimes`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    // File times and attributes: PackTime/UnpackTime, GetFTime/SetFTime and
    // GetFAttr/SetFAttr. Self-checking. (Free Pascal on Unix can't remember
    // Hidden or Archive, which pascrust does while the program runs, so this
    // .out is built from the checks, by hand.)
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut dt: DateTime = DateTime::default();
    let mut back: DateTime = DateTime::default();
    let mut when_packed: i32 = 0;
    let mut stamp: i32 = 0;
    let mut f: PText = PText::default();
    let mut g: PFile<i16> = PFile::default();
    let mut attr: u16 = 0;
    let mut n: i16 = 0;
    checks = 0;
    failures = 0;
    dt.year = 1997;
    dt.month = 3;
    dt.day = 11;
    dt.hour = 7;
    dt.min = 30;
    dt.sec = 41;
    pack_time(&mut dt, &mut when_packed);
    unpack_time(when_packed, &mut back);
    check(
        &mut checks,
        &mut failures,
        back.year == 1997 && back.month == 3 && back.day == 11,
        pstr("PackTime and UnpackTime keep the date"),
    );
    check(
        &mut checks,
        &mut failures,
        back.hour == 7 && back.min == 30 && back.sec == 40,
        pstr("and the time, to 2 seconds"),
    );
    f.assign("stamp.txt");
    f.rewrite();
    fwriteln!(f, "hello");
    f.close();
    set_f_time(&mut f, when_packed);
    check(&mut checks, &mut failures, dos_error() == 0, pstr("SetFTime"));
    get_f_time(&mut f, &mut stamp);
    check(&mut checks, &mut failures, stamp == when_packed, pstr("GetFTime reads back what SetFTime set"));
    get_f_attr(&mut f, &mut attr);
    check(
        &mut checks,
        &mut failures,
        attr & u16::from(ARCHIVE) != 0 && attr & u16::from(DIRECTORY) == 0,
        pstr("a new file is Archive, not a Directory"),
    );
    set_f_attr(&mut f, READ_ONLY);
    get_f_attr(&mut f, &mut attr);
    check(&mut checks, &mut failures, attr & u16::from(READ_ONLY) != 0, pstr("SetFAttr ReadOnly"));
    set_f_attr(&mut f, HIDDEN);
    get_f_attr(&mut f, &mut attr);
    check(
        &mut checks,
        &mut failures,
        attr & u16::from(HIDDEN) != 0 && attr & u16::from(READ_ONLY) == 0,
        pstr("SetFAttr Hidden, and not ReadOnly any more"),
    );
    f.erase();
    g.assign("numbers.dat");
    g.rewrite();
    n = 5;
    g.write(&n);
    g.close();
    get_f_time(&mut g, &mut stamp);
    check(&mut checks, &mut failures, dos_error() == 0 && stamp != 0, pstr("GetFTime of a typed file"));
    g.erase();
    mk_dir("sub");
    f.assign("sub");
    get_f_attr(&mut f, &mut attr);
    check(&mut checks, &mut failures, attr & u16::from(DIRECTORY) != 0, pstr("GetFAttr of a directory"));
    rm_dir("sub");
    f.assign("missing.txt");
    get_f_attr(&mut f, &mut attr);
    check(&mut checks, &mut failures, dos_error() == 2, pstr("GetFAttr of a missing file: DosError 2"));
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
        halt(1);
    }
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
