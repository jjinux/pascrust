//! Generated by PascRust from `goto_forms.pas`. Do not edit by hand.
//! Pascal: `program GotoForms;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// The forms of goto PascRust translates: back (a loop), forward past an
// if (a block), crossing jumps that nest once a block starts earlier, a
// numbered label inside repeat, out of a case arm, and in a procedure.

/// Pascal: `procedure Count;`
fn count() {
    let mut k: i16 = 0;
    k = 0;
    // `goto Next` jumps back: the statements from the label on are a loop,
    // and the jump is `continue 'next`. Otherwise the loop runs once.
    'next: loop {
        k += 1;
        if k < 3 {
            continue 'next;
        }
        break 'next;
    }
    pwriteln!("count ", k);
}

/// The main program: the `begin ... end.` block of `GotoForms`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut n: i16 = 0;
    let mut i: i16 = 0;
    n = 0;
    'top: loop {
        n += 1;
        // `goto Skip` jumps forward: Rust can't jump, but it can leave a block
        // early, so the statements it skips are in the block `'skip`, and the
        // jump is `break 'skip`.
        'skip: {
            if n % 2 == 0 {
                break 'skip;
            }
            pwriteln!("odd ", n);
        }
        if n < 5 {
            continue 'top;
        }
        break 'top;
    }
    i = 0;
    // Pascal `repeat ... until`: the body always runs at least once.
    loop {
        i += 1;
        'label_10: {
            if i == 2 {
                break 'label_10;
            }
            pwriteln!("i ", i);
        }
        if i >= 3 {
            break;
        }
    }
    'done: {
        match n {
            5 => {
                pwriteln!("five");
                break 'done;
            }
            _ => {}
        }
        pwriteln!("not reached");
    }
    count();
    n = 0;
    'inside: loop {
        n += 1;
        if n < 2 {
            continue 'inside;
        }
        break 'inside;
    }
    pwriteln!("n ", n);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
