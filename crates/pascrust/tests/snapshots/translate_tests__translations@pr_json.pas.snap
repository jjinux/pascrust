    let mut v: PJsonValue = Ptr::nil();
    v = json_parse(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed, s);
    if v.is_nil() {
        pwriteln!("error: ", *json_error);
    } else {
        pwriteln!(json_to_string(hex, to_string, output2, v.clone()));
        json_free(v.clone());
    }
}

