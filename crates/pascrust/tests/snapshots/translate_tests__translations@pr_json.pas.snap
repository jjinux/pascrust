/// Pascal: `procedure Show(const S: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn show(
    json_error: &mut PString,
    from_file: &mut bool,
    source: &mut PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
    hex: PString,
    to_string: &mut bool,
    output2: &mut PString,
    s: PString,
