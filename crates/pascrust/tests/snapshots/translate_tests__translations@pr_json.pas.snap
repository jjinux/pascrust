        next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    } else {
        fail(json_error, *at_end, *where_, failed, pstr("expected '") + c + "'");
    }
}

// The value of four hex digits after \u.
/// Pascal: `function HexDigits: Integer;`
///
/// Uses globals, which are passed in as parameters.
pub fn hex_digits(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
) -> i16 {
    let mut result: i16 = 0;
    let mut n: i16 = 0;
    let mut d: i16 = 0;
    n = 0;
    for i in 1_i16..=4 {
        next_char(from_file, source, source_pos, input2, ch, at_end, where_);
        match ch.to_ascii_uppercase() {
            b'0'..=b'9' => {
                d = i16::from(*ch) - i16::from(b'0');
            }
            b'A'..=b'F' => {
                d = i16::from(ch.to_ascii_uppercase()) - i16::from(b'A') + 10;
            }
            _ => {
                fail(json_error, *at_end, *where_, failed, pstr("expected a hex digit"));
                d = 0;
            }
        }
        n = n * 16 + d;
    }
    result = n;
    result
}

// A string, with Ch at its opening quote.
/// Pascal: `function ParseString: string;`
///
/// Uses globals, which are passed in as parameters.
pub fn parse_string(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
) -> PString {
    let mut result: PString = PString::new();
    let mut s: PString = PString::new();
    let mut c: u8 = 0;
    let mut code: i16 = 0;
    s = PString::new();
    next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    while !*failed && *ch != b'"' {
        if *at_end {
            fail(json_error, *at_end, *where_, failed, pstr("a string doesn't end"));
        } else {
            c = *ch;
            if c == b'\\' {
                next_char(from_file, source, source_pos, input2, ch, at_end, where_);
                match *ch {
                    b'"' | b'\\' | b'/' => {
                        c = *ch;
                    }
                    b'b' => {
                        c = b'\x08';
                    }
                    b'f' => {
                        c = b'\x0c';
                    }
                    b'n' => {
                        c = b'\n';
                    }
                    b'r' => {
                        c = b'\r';
                    }
                    b't' => {
                        c = b'\t';
                    }
                    b'u' => {
                        code =
                            hex_digits(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed);
                        if code <= 255 {
                            c = code as u8;
                        } else {
                            c = b'?';
                        }
                    }
                    _ => {
                        fail(json_error, *at_end, *where_, failed, pstr("unknown escape \\") + *ch);
                    }
                }
            }
            if s.length() < 255 {
                s = s + c;
            }
            next_char(from_file, source, source_pos, input2, ch, at_end, where_);
        }
    }
    next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    result = s;
    result
}

// A number, with Ch at its first character.
/// Pascal: `function ParseNumber: PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn parse_number(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    let mut s: PString = PString::new();
    let mut x: f64 = 0.0;
    let mut code: i16 = 0;
    s = PString::new();
    while !*at_end && matches!(*ch, b'0'..=b'9' | b'-' | b'+' | b'.' | b'e' | b'E') {
        s = s + *ch;
        next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    }
    val(s, &mut x, &mut code);
    if code != 0 {
        fail(json_error, *at_end, *where_, failed, pstr("a bad number"));
    }
    result = json_new_number(x);
    result
}

// true, false or null, with Ch at its first letter.
/// Pascal: `function ParseWord: PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn parse_word(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    let mut w_: PString = PString::new();
    w_ = PString::new();
    while !*at_end && matches!(*ch, b'a'..=b'z') {
        w_ = w_ + *ch;
        next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    }
    if w_ == "true" {
        result = json_new_bool(true);
    } else if w_ == "false" {
        result = json_new_bool(false);
    } else {
        if w_ != "null" {
            fail(json_error, *at_end, *where_, failed, pstr("expected a value"));
        }
        result = json_new_null().clone();
    }
    result
}

// An array or object, with Ch at its opening bracket.
/// Pascal: `function ParseList(Kind: TJsonKind): PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn parse_list(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
    kind: TJsonKind,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    let mut list: PJsonValue = Ptr::nil();
    let mut member: PJsonValue = Ptr::nil();
    let mut key: PString = PString::new();
    let mut close: u8 = 0;
    let mut done: bool = false;
    list = new_value(kind);
    if kind == TJsonKind::JkArray {
        close = b']';
    } else {
        close = b'}';
    }
    next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    skip_space(from_file, source, source_pos, input2, ch, at_end, where_);
    done = *ch == close;
    if done {
        next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    }
    while !done && !*failed {
        skip_space(from_file, source, source_pos, input2, ch, at_end, where_);
        key = PString::new();
        if kind == TJsonKind::JkObject {
            if *ch == b'"' {
                key = parse_string(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed);
            } else {
                fail(json_error, *at_end, *where_, failed, pstr("expected a key"));
            }
            expect(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed, b':');
        }
        if !*failed {
            member = parse_value(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed).clone();
            member.get_mut().key = key;
            append(list.clone(), member.clone());
            skip_space(from_file, source, source_pos, input2, ch, at_end, where_);
            if *ch == b',' {
                next_char(from_file, source, source_pos, input2, ch, at_end, where_);
            } else {
                expect(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed, close);
                done = true;
            }
        }
    }
    result = list.clone();
    result
}

/// Pascal: `function ParseValue: PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn parse_value(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    skip_space(from_file, source, source_pos, input2, ch, at_end, where_);
    match *ch {
        b'{' => {
            result = parse_list(
                json_error,
                from_file,
                source,
                source_pos,
                input2,
                ch,
                at_end,
                where_,
                failed,
                TJsonKind::JkObject,
            );
        }
        b'[' => {
            result = parse_list(
                json_error,
                from_file,
                source,
                source_pos,
                input2,
                ch,
                at_end,
                where_,
                failed,
                TJsonKind::JkArray,
            );
        }
        b'"' => {
            result = json_new_string(parse_string(
                json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed,
            ));
        }
        b'-' | b'0'..=b'9' => {
            result =
                parse_number(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed).clone();
        }
        b'a'..=b'z' => {
            result = parse_word(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed).clone();
        }
        _ => {
            fail(json_error, *at_end, *where_, failed, pstr("expected a value"));
            result = json_new_null().clone();
        }
    }
    result
}

// The whole text is one value, with nothing after it.
/// Pascal: `function ParseAll: PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn parse_all(
    json_error: &mut PString,
    from_file: bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    let mut v: PJsonValue = Ptr::nil();
    *json_error = PString::new();
    *failed = false;
    *where_ = 0;
    next_char(from_file, source, source_pos, input2, ch, at_end, where_);
    v = parse_value(json_error, from_file, source, source_pos, input2, ch, at_end, where_, failed).clone();
    skip_space(from_file, source, source_pos, input2, ch, at_end, where_);
    if !*at_end {
        fail(json_error, *at_end, *where_, failed, pstr("more after the value"));
    }
    if *failed {
        json_free(v.clone());
        v = Ptr::nil();
    }
    result = v.clone();
    result
}

/// Pascal: `function JsonParse(const S: string): PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn json_parse(
    json_error: &mut PString,
    from_file: &mut bool,
    source: &mut PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
    s: PString,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    *from_file = false;
    *source = s;
    *source_pos = 1;
    result = parse_all(json_error, *from_file, *source, source_pos, input2, ch, at_end, where_, failed).clone();
    result
}

/// Pascal: `function JsonLoad(const FileName: string): PJsonValue;`
///
/// Uses globals, which are passed in as parameters.
pub fn json_load(
    json_error: &mut PString,
    from_file: &mut bool,
    source: PString,
    source_pos: &mut i16,
    input2: &mut PText,
    ch: &mut u8,
    at_end: &mut bool,
    where_: &mut i32,
    failed: &mut bool,
    file_name: PString,
) -> PJsonValue {
    let mut result: PJsonValue = Ptr::nil();
    input2.assign(file_name);
    // `{$I-}`: an I/O error in `io_unchecked` sets `IOResult` instead of
    // stopping the program.
    io_unchecked(|| input2.reset());
    if io_result() != 0 {
        *json_error = pstr("cannot open ") + file_name;
        result = Ptr::nil();
        return result;
    }
    *from_file = true;
    result = parse_all(json_error, *from_file, source, source_pos, input2, ch, at_end, where_, failed).clone();
    input2.close();
    result
}

// ----- Writing JSON -----
// A number as JSON writes it: a whole number without a point, others
// without trailing zeros.
/// Pascal: `function NumberText(X: Real): string;`
pub fn number_text(x: f64) -> PString {
    let mut result: PString = PString::new();
    let mut s: PString = PString::new();
    if x.fract() == 0.0 && x.abs() < 2147483647.0 {
        s = pas_str(x.trunc() as i32);
    } else {
        s = pas_str(wd(x, 0, 9));
        while s[s.length()] == b'0' {
            s.delete(s.length(), 1);
        }
        if s[s.length()] == b'.' {
            s.delete(s.length(), 1);
        }
    }
    result = s;
    result
}

// A string in quotes, with the characters JSON can't have as they are
// escaped.
/// Pascal: `function Quoted(const S: string): string;`
///
/// Uses globals, which are passed in as parameters.
pub fn quoted(hex: PString, s: PString) -> PString {
    let mut result: PString = PString::new();
    let mut q: PString = PString::new();
    q = pstr("\"");
    for i in 1..=s.length() {
        match s[i] {
            b'"' => {
                q = q + "\\\"";
            }
            b'\\' => {
                q = q + "\\\\";
            }
            b'\x08' => {
                q = q + "\\b";
            }
            b'\t' => {
                q = q + "\\t";
            }
            b'\n' => {
                q = q + "\\n";
            }
            b'\x0c' => {
                q = q + "\\f";
            }
            b'\r' => {
                q = q + "\\r";
            }
            b'\x00'..=b'\x07' | b'\x0b' | b'\x0e'..=b'\x1f' => {
                q = q + "\\u00" + hex[i16::from(s[i]) / 16 + 1] + hex[i16::from(s[i]) % 16 + 1];
            }
            _ => {
                q = q + s[i];
            }
        }
    }
    result = q + "\"";
    result
}

/// Pascal: `procedure Put(var F: Text; const S: string);`
///
/// Uses globals, which are passed in as parameters.
pub fn put(to_string: bool, output2: &mut PString, f: &mut PText, s: PString) {
    if to_string {
        if output2.length() + s.length() <= 255 {
            *output2 = *output2 + s;
        } else {
            *output2 = (*output2 + s).copy(1, 255);
        }
    } else {
        fwrite!(f, s);
    }
}

/// Pascal: `procedure NewLine(var F: Text; Indent, Depth: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn new_line(to_string: bool, output2: &mut PString, f: &mut PText, indent: i16, depth: i16) {
    if indent > 0 {
        if to_string {
            put(to_string, output2, f, pstr(" "));
        } else {
            fwriteln!(f);
            for i in 1..=indent * depth {
                fwrite!(f, " ");
            }
        }
    }
}

/// Pascal: `procedure WriteValue(var F: Text; V: PJsonValue; Indent, Depth: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn write_value(
    hex: PString,
    to_string: bool,
    output2: &mut PString,
    f: &mut PText,
    v: PJsonValue,
    indent: i16,
    depth: i16,
) {
    let mut member: PJsonValue = Ptr::nil();
    match json_kind(v.clone()) {
        TJsonKind::JkNull => {
            put(to_string, output2, f, pstr("null"));
        }
        TJsonKind::JkBoolean => {
            if v.get().bool {
                put(to_string, output2, f, pstr("true"));
            } else {
                put(to_string, output2, f, pstr("false"));
            }
        }
        TJsonKind::JkNumber => {
            let x = v.get().number;
            let s = number_text(x);
            put(to_string, output2, f, s);
        }
        TJsonKind::JkString => {
            let s = v.get().str;
            let s_2 = quoted(hex, s);
            put(to_string, output2, f, s_2);
        }
        TJsonKind::JkArray | TJsonKind::JkObject => {
            if v.get().kind == TJsonKind::JkArray {
                put(to_string, output2, f, pstr("["));
            } else {
                put(to_string, output2, f, pstr("{"));
            }
            member = v.get().first.clone();
            while !member.is_nil() {
                new_line(to_string, output2, f, indent, depth + 1);
                if v.get().kind == TJsonKind::JkObject {
                    let s = member.get().key;
                    let s_2 = quoted(hex, s);
                    put(to_string, output2, f, s_2);
                    if indent > 0 {
                        put(to_string, output2, f, pstr(": "));
                    } else {
                        put(to_string, output2, f, pstr(":"));
                    }
                }
                write_value(hex, to_string, output2, f, member.clone(), indent, depth + 1);
                let next = member.get().next.clone();
                member = next;
                if !member.is_nil() {
                    put(to_string, output2, f, pstr(","));
                }
            }
            if !v.get().first.is_nil() {
                new_line(to_string, output2, f, indent, depth);
            }
            if v.get().kind == TJsonKind::JkArray {
                put(to_string, output2, f, pstr("]"));
            } else {
                put(to_string, output2, f, pstr("}"));
            }
        }
    }
}

/// Pascal: `procedure JsonWrite(var F: Text; V: PJsonValue; Indent: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn json_write(
    hex: PString,
    to_string: &mut bool,
    output2: &mut PString,
    f: &mut PText,
    v: PJsonValue,
    indent: i16,
) {
    *to_string = false;
    write_value(hex, *to_string, output2, f, v.clone(), indent, 0);
}

/// Pascal: `procedure JsonSave(const FileName: string; V: PJsonValue; Indent: Integer);`
///
/// Uses globals, which are passed in as parameters.
pub fn json_save(
    hex: PString,
    to_string: &mut bool,
    output2: &mut PString,
    file_name: PString,
    v: PJsonValue,
    indent: i16,
) {
    let mut f: PText = PText::default();
    f.assign(file_name);
    f.rewrite();
    json_write(hex, to_string, output2, &mut f, v.clone(), indent);
    fwriteln!(f);
    f.close();
}

/// Pascal: `function JsonToString(V: PJsonValue): string;`
///
/// Uses globals, which are passed in as parameters.
pub fn json_to_string(hex: PString, to_string: &mut bool, output2: &mut PString, v: PJsonValue) -> PString {
    let mut result: PString = PString::new();
    *to_string = true;
    *output2 = PString::new();
    write_value(hex, *to_string, output2, &mut PText::console(), v.clone(), 0, 0);
    *to_string = false;
    result = *output2;
    result
}
