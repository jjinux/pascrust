//! Generated by PascRust from `cast_compare.pas`. Do not edit by hand.
//! Pascal: `program CastCompare;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// A conversion or a shift on the left of a comparison: Rust reads
// `i as u16 < w` as the start of generic arguments, so the cast needs
// parentheses there (and only there).

/// The main program: the `begin ... end.` block of `CastCompare`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut w_: u16 = 0;
    let mut b: u8 = 0;
    i = 80;
    w_ = 100;
    b = 3;
    if (((i as u16) >> 1) as i16) < 50 {
        pwriteln!("shr");
    }
    if (i as u16) < w_ {
        pwriteln!("Word");
    }
    if i16::from((i + 200) as u8) <= 24 {
        pwriteln!("Byte");
    }
    if !(i16::from(b) - 3 != 0) {
        pwriteln!("Boolean");
    }
    pwriteln!(i as u16 + w_, " ", i16::from((i16::from(b) * 50) as i8) < 0);
}

fn main() {
