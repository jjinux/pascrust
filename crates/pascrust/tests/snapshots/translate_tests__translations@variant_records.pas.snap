//! Generated by PascRust from `variant_records.pas`. Do not edit by hand.
//! Pascal: `program VariantRecords;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Tagged variant records: fields of the variant in use, set and read,
// through `with` and as `var` arguments; a typed constant; a `Boolean` tag;
// and a `file of` round trip, which keeps only the variant the tag selects.
// Output from fpc -Mtp, except SizeOf(Fig): Free Pascal pads the field
// after the 1-byte tag, so it says 10 where TP says 9.
/// Pascal: `(Circle, Rect, Dot)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Shape {
    #[default]
    Circle,
    Rect,
    Dot,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Shape {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Shape {
    const VALUES: &'static [Self] = &[Shape::Circle, Shape::Rect, Shape::Dot];
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(enum Shape);

/// Pascal: `Fig = record ... end`
///
/// The `case Kind: ... of` part is a tagged union: the program sets `kind`
/// to say which variant's fields are in use. Rust would use an `enum`, but
/// Pascal lets a program set the fields before the tag, so every variant's
/// fields are plain fields here; only `file of` looks at the tag.
#[derive(Clone, Copy, Debug, Default)]
struct Fig {
    x: i16,
    y: i16,
    kind: Shape,
    r: i16,
    w_: i16,
    h: i16,
}

// A variant record keeps one variant in a file: the one `kind` selects,
// padded with zeros to the 4 bytes the variants share in TP.
file_record!(Fig { x, y, kind; case kind: 4 { Shape::Circle => [r], Shape::Rect => [w_, h], Shape::Dot => [] } });

/// Pascal: `Account = record ... end`
///
/// The `case Open: ... of` part is a tagged union: the program sets `open`
/// to say which variant's fields are in use. Rust would use an `enum`, but
/// Pascal lets a program set the fields before the tag, so every variant's
/// fields are plain fields here; only `file of` looks at the tag.
#[derive(Clone, Copy, Debug, Default)]
struct Account {
    name: PString,
    open: bool,
    balance: i32,
    closed: u16,
}

/// Pascal: `procedure Grow(var n: Integer);`
fn grow(n: &mut i16) {
    *n *= 2;
}

/// Pascal: `function Area(const Fig: Fig): Integer;`
fn area(fig: Fig) -> i16 {
    let mut result: i16 = 0;
    match fig.kind {
        Shape::Circle => {
            result = 3 * fig.r * fig.r;
        }
        Shape::Rect => {
            result = fig.w_ * fig.h;
        }
        _ => {
            result = 0;
        }
    }
    result
}

/// The main program: the `begin ... end.` block of `VariantRecords`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let unit_circle: Fig = Fig { x: 0, y: 0, kind: Shape::Circle, r: 1, ..Default::default() };
    let mut f: Fig = Fig::default();
    let mut g: Fig = Fig::default();
    let mut a: Account = Account::default();
    let mut fl: PFile<Fig> = PFile::default();
    f.x = 1;
    f.y = 2;
    f.kind = Shape::Rect;
    f.w_ = 3;
    f.h = 4;
    pwriteln!(area(f), " ", 9);
    // Pascal `with`: Rust has no equivalent, so each field is written out in full.
    pwriteln!(f.x + f.y + f.w_);
    grow(&mut f.h);
    pwriteln!(area(f));
    pwriteln!(area(unit_circle), " ", unit_circle.kind as i16);
    a.name = pstr("savings");
    a.open = true;
    a.balance = 100000;
    pwriteln!(a.name, " ", a.balance, " ", 16);
    fl.assign("variant_records.dat");
    fl.rewrite();
    fl.write(&f);
    f.kind = Shape::Circle;
    f.r = 7;
    fl.write(&f);
    f.kind = Shape::Dot;
    fl.write(&f);
    fl.close();
    fl.reset();
    fl.read(&mut g);
    pwriteln!(g.kind as i16, " ", g.w_, " ", g.h);
    fl.read(&mut g);
    pwriteln!(g.kind as i16, " ", g.r, " ", area(g));
    fl.read(&mut g);
    pwriteln!(g.kind as i16, " ", area(g), " ", fl.file_size());
    fl.close();
    fl.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
