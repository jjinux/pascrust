        self.variants.field(0)
    }
    // `S` is bytes 0 to 3
    fn s(&self) -> PString {
        self.variants.get_string(0, 3)
    }
    fn set_s(&mut self, s: PString) {
        self.variants.set_string(0, 3, s)
