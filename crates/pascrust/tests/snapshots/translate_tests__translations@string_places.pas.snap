/// The main program: the `begin ... end.` block of `StringPlaces`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut p: Pun = Pun::default();
    let mut ps: PStr = Ptr::nil();
    let mut t: PString = PString::new();
    let mut nm: Named = Named::default();
    p.set_s(pstr("abc"));
