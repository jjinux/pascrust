//! Generated by PascRust from `proc_types.pas`. Do not edit by hand.
//! Pascal: `program ProcTypes;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Procedural types: variables, parameters and a typed constant of them;
// calls through them, also with var parameters, through a record field
// and an array element; a parameterless function value called in an
// expression; nil, Assigned and `@` comparisons. Output from fpc -Mtp,
// except SizeOf(Op): a procedural value is TP's 4-byte far address, where
// Free Pascal's is 8.
/// Pascal: `procedure(var X, Y: Integer)`
///
/// A procedural type is a function pointer that may be nil. Every routine
/// kept in one has this Rust signature, so the globals any of them uses are
/// parameters of them all (and of every call through one).
type SwapProc = ProcVar<fn(&mut i16, &mut i16)>;

/// Pascal: `function: Integer`
type IntFunc = ProcVar<fn(&mut i16) -> i16>;

/// Pascal: `function(A, B: Integer): Integer`
type Op = ProcVar<fn(i16, i16) -> i16>;

/// Pascal: `record Name: string[5]; Apply: Op; end`
#[derive(Clone, Copy, Debug, Default)]
struct Entry {
    name: PString,
    apply: Op,
}

/// Pascal: `procedure Swap(var X, Y: Integer);`
fn swap(x: &mut i16, y: &mut i16) {
    let mut t: i16 = 0;
    t = *x;
    *x = *y;
    *y = t;
}

/// Pascal: `function Tick: Integer;`
///
/// Kept in a `IntFunc`, so it takes the globals any `IntFunc` routine uses.
fn tick(counter: &mut i16) -> i16 {
    let mut result: i16 = 0;
    *counter += 1;
    result = *counter;
    result
}

/// Pascal: `function Add(A, B: Integer): Integer;`
fn add(a: i16, b: i16) -> i16 {
    let mut result: i16 = 0;
    result = a + b;
    result
}

/// Pascal: `function Mul(A, B: Integer): Integer;`
fn mul(a: i16, b: i16) -> i16 {
    let mut result: i16 = 0;
    result = a * b;
    result
}

/// Pascal: `function Sub(A, B: Integer): Integer;`
fn sub(a: i16, b: i16) -> i16 {
    let mut result: i16 = 0;
    result = a - b;
    result
}

/// Pascal: `function Fold(F: Op; X, Y: Integer): Integer;`
fn fold(f: Op, x: i16, y: i16) -> i16 {
    let mut result: i16 = 0;
    result = f.get()(f.get()(x, y), y);
    result
}

/// The main program: the `begin ... end.` block of `ProcTypes`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut s: SwapProc = ProcVar::nil();
    let mut next: IntFunc = ProcVar::nil();
    let mut counter: i16 = 0;
    let mut a: i16 = 0;
    let mut b: i16 = 0;
    let mut ops: PArray<Op, 1, 3> = PArray::default();
    let mut e: Entry = Entry::default();
    let mut n: i16 = 0;
    let default: Op = ProcVar::of(add, "Add");
    a = 1;
    b = 2;
    s = ProcVar::of(swap, "Swap");
    s.get()(&mut a, &mut b);
    pwriteln!(a, " ", b);
    counter = 0;
    next = ProcVar::of(tick, "Tick");
    n = next.get()(&mut counter);
    n += next.get()(&mut counter);
    pwriteln!(n, " ", counter);
    ops[1] = ProcVar::of(add, "Add");
    ops[2] = ProcVar::of(mul, "Mul");
    ops[3] = ProcVar::of(sub, "Sub");
    for i in 1_i16..=3 {
        pwrite!(ops[i].get()(7, 3), " ");
    }
    pwriteln!();
    e.name = pstr("mul");
    e.apply = ProcVar::of(mul, "Mul");
    pwriteln!(e.name, " ", e.apply.get()(6, 7), " ", fold(e.apply, 2, 3), " ", fold(default, 2, 3));
    ops[2] = ProcVar::nil();
    pwriteln!(!ops[1].is_nil(), " ", !ops[2].is_nil());
    pwriteln!(
        e.apply.address() == AnyPtr::code("Mul"),
        " ",
        e.apply.address() == AnyPtr::code("Add"),
        " ",
        ops[2].is_nil(),
        " ",
        !ops[1].is_nil(),
        " ",
        4
    );
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
