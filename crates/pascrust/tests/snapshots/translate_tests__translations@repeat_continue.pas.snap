//! Generated by pascrust from `repeat_continue.pas`. Do not edit by hand.
//! Pascal: `program RepeatContinue;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

/// The main program: the `begin ... end.` block of `RepeatContinue`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut i: i16 = 0;
    let mut j: i16 = 0;
    i = 0;
    // Pascal `repeat ... until`: the body always runs at least once.
    // `Continue` must still test the `until` condition, so it jumps out of
    // the labeled block below rather than back to the top of the loop.
    'repeat_loop: loop {
        'repeat_body: {
            i += 1;
            if i % 2 == 0 {
                break 'repeat_body;
            }
            if i == 9 {
                break 'repeat_loop;
            }
            j = 0;
            // Pascal `repeat ... until`: the body always runs at least once.
            loop {
                'repeat_body2: {
                    j += 1;
                    if j == 2 {
                        break 'repeat_body2;
                    }
                    pwrite!(i, ":", j, " ");
                }
                if j >= 3 {
                    break;
                }
            }
            pwriteln!();
        }
        if i >= 6 {
            break;
        }
    }
    pwriteln!("i = ", i);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
