//! Generated by pascrust from `sets.pas`. Do not edit by hand.
//! Pascal: `program Sets;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

const VOWELS: PSet<u8> = PSet::of(&[b'a', b'e', b'i', b'o', b'u']);
const PRIMARY: PSet<Color> = PSet::of(&[Color::Red as u8, Color::Green as u8, Color::Blue as u8]);

/// Pascal: `(Red, Green, Blue, Yellow)`
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
enum Color {
    #[default]
    Red,
    Green,
    Blue,
    Yellow,
}

// Pascal enumerations are ordinal types: they can index arrays, drive
// `for` loops and go through `Succ`/`Pred`. These impls connect the enum
// to the runtime's support for that.
impl Ordinal for Color {
    fn ord(self) -> i64 {
        self as i64
    }
}

impl Enumerated for Color {
    const VALUES: &'static [Self] = &[Color::Red, Color::Green, Color::Blue, Color::Yellow];
}

/// Pascal: `record name: string[10]; colors: Colors; end`
#[derive(Clone, Copy, Debug, Default)]
struct Palette {
    name: PString,
    colors: PSet<Color>,
}

/// Pascal: `procedure Show(s: CharSet);`
fn show(s: PSet<u8>) {
    pwrite!("[");
    for ch in b'a'..=b'z' {
        if s.contains(ch) {
            pwrite!(ch);
        }
    }
    pwriteln!("]");
}

/// Pascal: `procedure AddDigit(var s: Digits; n: Integer);`
fn add_digit(s: &mut PSet<i16>, n: i16) {
    if matches!(n, 0..=9) {
        s.include(n);
    }
}

/// Pascal: `function Count(s: Digits): Integer;`
fn count(s: PSet<i16>) -> i16 {
    let mut result: i16 = 0;
    let mut k: i16 = 0;
    k = 0;
    for n in 0_i16..=9 {
        if s.contains(n) {
            k += 1;
        }
    }
    result = k;
    result
}

/// The main program: the `begin ... end.` block of `Sets`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let typed: PSet<u8> = pset![b'x'..=b'z'];
    let mut letters: PSet<u8> = PSet::new();
    let mut found: PSet<u8> = PSet::new();
    let mut c: u8 = 0;
    let mut d: PSet<i16> = PSet::new();
    let mut i: i16 = 0;
    let mut p: Palette = Palette::default();
    let mut warm: PSet<Color> = PSet::new();
    letters = pset![b'a'..=b'f', b'x', b'q'];
    show(letters);
    show(letters & VOWELS);
    show(letters - VOWELS);
    show(letters | pset![b'm'..=b'o']);
    show(typed);
    found = PSet::new();
    // `c` is also used outside this loop (Pascal leaves it holding the
    // last value), so the loop updates it on every pass instead of declaring
    // a fresh loop variable.
    for c_value in b'a'..=b'z' {
        c = c_value;
        if VOWELS.contains(c) && !matches!(c, b'i' | b'o') {
            found.include(c);
        }
    }
    show(found);
    found.exclude(b'a');
    show(found);
    pwriteln!(
        found.is_subset(&VOWELS),
        " ",
        VOWELS.is_subset(&found),
        " ",
        VOWELS.is_superset(&found),
        " ",
        found == pset![b'e', b'u'],
        " ",
        found != PSet::new()
    );
    c = b'k';
    pwriteln!(matches!(c, b'a'..=b'm'), " ", letters.contains(c), " ", letters.contains(b'e'));
    d = PSet::new();
    for i_value in 1..=12 {
        i = i_value;
        if i % 3 == 0 {
            add_digit(&mut d, i);
        }
    }
    pwriteln!(count(d), " ", d.contains(3), " ", d.contains(12), " ", d.contains(4));
    p.name = pstr("flag");
    p.colors = PRIMARY - pset![Color::Green];
    warm = pset![Color::Red, Color::Yellow];
    pwriteln!(
        p.colors.contains(Color::Red),
        " ",
        p.colors.contains(Color::Green),
        " ",
        p.colors & warm == pset![Color::Red],
        " ",
        PRIMARY.contains(Color::Yellow)
    );
    i = 0;
    for c_value in b'a'..=b'z' {
        c = c_value;
        if (VOWELS | pset![b'y']).contains(c) {
            i += 1;
        }
    }
    pwriteln!(i);
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
