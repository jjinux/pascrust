//! Generated by PascRust from `files.pas`. Do not edit by hand.
//! Pascal: `program Files;`

// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// Text files and typed files (file of record) with random access.
/// Pascal: `record name: string[20]; age: integer; end`
#[derive(Clone, Copy, Debug, Default)]
struct Person {
    name: PString,
    age: i16,
}

// `file of` needs to turn records into bytes and back. This runtime macro
// implements that (the `FileRecord` trait) field by field.
file_record!(Person { name, age });

/// The main program: the `begin ... end.` block of `Files`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut f: PFile<Person> = PFile::default();
    let mut t: PText = PText::default();
    let mut p: Person = Person::default();
    let mut i: i16 = 0;
    let mut line: PString = PString::new();
    let mut n: i16 = 0;
    f.assign("people.dat");
    f.rewrite();
    p.name = pstr("Ann");
    p.age = 31;
    f.write(&p);
    p.name = pstr("Bob");
    p.age = 42;
    f.write(&p);
    p.name = pstr("Carol");
    p.age = 27;
    f.write(&p);
    pwriteln!("size ", f.file_size(), " pos ", f.file_pos());
    f.seek(1);
    f.read(&mut p);
    pwriteln!("record 1: ", p.name, " ", p.age, ", now at ", f.file_pos());
    f.seek(0);
    while !f.eof() {
        f.read(&mut p);
        pwrite!(p.name, " ");
    }
    pwriteln!();
    // Change a record in place.
    f.seek(2);
    p.name = pstr("Dave");
    p.age = 50;
    f.write(&p);
    f.seek(2);
    f.read(&mut p);
    pwriteln!("record 2 is now ", p.name);
    f.close();
    f.erase();
    t.assign("notes.txt");
    t.rewrite();
    fwriteln!(t, "first line");
    fwriteln!(t, 42, " ", wd(3.5, 0, 1));
    t.close();
    t.append();
    fwriteln!(t, "appended");
    t.close();
    t.reset();
    i = 0;
    while !t.eof() {
        freadln!(t, &mut line);
        i += 1;
        pwriteln!(i, ": ", line);
    }
    t.close();
    t.reset();
    freadln!(t);
    fread!(t, &mut n);
    pwriteln!("number on line 2: ", n);
    t.close();
    t.erase();
}

fn main() {
    // `run` turns Pascal runtime errors into Turbo Pascal style messages and
    // exit codes.
    pascrust_runtime::run(pascal_main);
}
