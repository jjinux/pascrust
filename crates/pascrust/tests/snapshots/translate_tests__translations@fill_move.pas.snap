    chars.fill(b'*');
    check(&mut checks, &mut failures, chars[0] == b'*' && chars[4] == b'*', pstr("fill a char array"));
    flags.fill(true);
    check(&mut checks, &mut failures, flags[1] && flags[3], pstr("fill a boolean array"));
    grid[2][2] = 5;
    grid = PArray::default();
    check(&mut checks, &mut failures, grid[2][2] == 0, pstr("zero a 2D array"));
    p.x = 1;
    p.y = 2;
    p.name = pstr("abc");
    p = Point::default();
    check(&mut checks, &mut failures, p.x == 0 && p.y == 0 && p.name == "", pstr("zero a record"));
    s = pstr("hello");
    s.fill(0, 21, 0);
    check(&mut checks, &mut failures, s.length() == 0, pstr("zero a string"));
    s.fill(1, 5, b'-');
    s[0] = b'\x05';
    check(&mut checks, &mut failures, s == "-----", pstr("fill part of a string"));
    p.x = 3;
    p.y = 4;
    p.name = pstr("pt");
    q = p;
    check(&mut checks, &mut failures, q.x == 3 && q.y == 4 && q.name == "pt", pstr("move a record"));
