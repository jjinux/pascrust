    let mut p: Point = Point::default();
    let mut q: Point = Point::default();
    let mut s: PString = PString::new();
    let mut total: i16 = 0;
    checks = 0;
    failures = 0;
    for i in 1_i16..=10 {
        bytes[i] = i as u8;
    }
    bytes = PArray::default();
    total = 0;
    for i in 1_i16..=10 {
        total += i16::from(bytes[i]);
    }
    check(&mut checks, &mut failures, total == 0, pstr("zero a byte array"));
    bytes.fill(7);
    check(&mut checks, &mut failures, i16::from(bytes[1]) == 7 && i16::from(bytes[10]) == 7, pstr("fill a byte array"));
    bytes.fill_from(3, 4, 1);
    check(
        &mut checks,
        &mut failures,
        i16::from(bytes[2]) == 7 && i16::from(bytes[3]) == 1 && i16::from(bytes[6]) == 1 && i16::from(bytes[7]) == 7,
        pstr("fill part of a byte array"),
