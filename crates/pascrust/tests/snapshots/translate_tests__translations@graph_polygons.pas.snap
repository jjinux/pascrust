// Pascal programs often declare things they never use, or assign a
// variable before reading it; that's fine, so don't warn about it.
#![allow(unused_variables, unused_assignments, dead_code)]

use pascrust_runtime::prelude::*;

// DrawPoly and FillPoly with arrays of PointType, GetArcCoords, and the
// Get*Settings records, checked with GetPixel (the tests run with
// PASCRUST_GRAPH=headless). Self-checking: Free Pascal's Graph unit needs
// a real screen, so this .out is built from the checks, by hand.

/// Pascal: `array[1..3] of PointType`
type Triangle = PArray<PointType, 1, 3>;

/// Pascal: `procedure Check(ok: Boolean; what: string);`
///
/// The global variables this procedure uses are passed in as parameters,
/// because the globals are local variables of `pascal_main`.
fn check(checks: &mut i16, failures: &mut i16, ok: bool, what: PString) {
    *checks += 1;
    if ok {
        pwriteln!("ok: ", what);
    } else {
        *failures += 1;
        pwriteln!("FAILED: ", what);
    }
}

/// Pascal: `procedure SetPoint(var p: PointType; x, y: Integer);`
fn set_point(p: &mut PointType, x: i16, y: i16) {
    p.x = x;
    p.y = y;
}

// The points arrive as a value parameter: only read.
/// Pascal: `procedure Copied(points: Triangle);`
fn copied(points: Triangle) {
    draw_poly(3, points.as_slice());
}

// The points arrive as a var parameter.
/// Pascal: `procedure Outline(var points: Triangle; count: Integer);`
fn outline(points: &mut Triangle, count: i16) {
    draw_poly(count, points.as_slice());
}

/// The main program: the `begin ... end.` block of `GraphPolygons`.
/// Its local variables are the Pascal program's global variables.
fn pascal_main() {
    let mut checks: i16 = 0;
    let mut failures: i16 = 0;
    let mut driver: i16 = 0;
    let mut mode: i16 = 0;
    let mut tri: Triangle = Triangle::default();
    let mut path: Triangle = Triangle::default();
    let mut arcs: ArcCoordsType = ArcCoordsType::default();
    let mut lines: LineSettingsType = LineSettingsType::default();
    let mut fills: FillSettingsType = FillSettingsType::default();
    let mut texts: TextSettingsType = TextSettingsType::default();
    let mut view: ViewPortType = ViewPortType::default();
    let mut pattern: FillPatternType = FillPatternType::default();
    let corner: Triangle =
        PArray::new([PointType { x: 200, y: 300 }, PointType { x: 220, y: 300 }, PointType { x: 220, y: 320 }]);
    checks = 0;
    failures = 0;
    driver = i16::from(DETECT);
    init_graph(&mut driver, &mut mode, "");
    set_point(&mut tri[1], 10, 10);
    set_point(&mut tri[2], 50, 10);
    set_point(&mut tri[3], 30, 40);
    set_color(WHITE);
    set_fill_style(SOLID_FILL, BLUE);
    fill_poly(3, tri.as_slice());
    check(&mut checks, &mut failures, get_pixel(30, 20) == u16::from(BLUE), pstr("FillPoly fills the inside"));
    check(
        &mut checks,
        &mut failures,
        get_pixel(10, 10) == u16::from(WHITE) && get_pixel(30, 40) == u16::from(WHITE),
        pstr("and outlines the corners"),
    );
    check(&mut checks, &mut failures, get_pixel(60, 20) == u16::from(BLACK), pstr("and nothing outside"));
    set_point(&mut path[1], 100, 100);
    set_point(&mut path[2], 140, 100);
    set_point(&mut path[3], 140, 140);
    set_color(RED);
    draw_poly(3, path.as_slice());
    check(
        &mut checks,
        &mut failures,
        get_pixel(120, 100) == u16::from(RED) && get_pixel(140, 120) == u16::from(RED),
        pstr("DrawPoly joins the points"),
    );
    check(&mut checks, &mut failures, get_pixel(120, 120) == u16::from(BLACK), pstr("without closing the shape"));
    set_color(GREEN);
    outline(&mut path, 2);
    check(
        &mut checks,
        &mut failures,
        get_pixel(120, 100) == u16::from(GREEN) && get_pixel(140, 120) == u16::from(RED),
        pstr("only NumPoints points, through a var parameter"),
    );
    set_color(YELLOW);
    copied(corner);
    check(
        &mut checks,
        &mut failures,
        get_pixel(210, 300) == u16::from(YELLOW) && get_pixel(220, 310) == u16::from(YELLOW),
        pstr("a typed constant, as a value parameter"),
    );
    arc(200, 200, 0, 90, 50);
    get_arc_coords(&mut arcs);
    check(&mut checks, &mut failures, arcs.x == 200 && arcs.y == 200, pstr("GetArcCoords: the centre"));
    check(
        &mut checks,
        &mut failures,
        arcs.x_start == 250 && arcs.y_start == 200 && arcs.x_end == 200 && arcs.y_end == 150,
        pstr("and the ends"),
    );
    set_line_style(USER_BIT_LN, 61680, THICK_WIDTH);
    get_line_settings(&mut lines);
    check(
        &mut checks,
        &mut failures,
        lines.line_style == u16::from(USER_BIT_LN)
            && lines.pattern == 61680
            && lines.thickness == u16::from(THICK_WIDTH),
        pstr("GetLineSettings"),
    );
    set_fill_style(HATCH_FILL, RED);
    get_fill_settings(&mut fills);
    check(
        &mut checks,
        &mut failures,
        fills.pattern == u16::from(HATCH_FILL) && fills.color == u16::from(RED),
        pstr("GetFillSettings"),
    );
    get_fill_pattern(&mut pattern);
    set_fill_pattern(pattern, CYAN);
    get_fill_settings(&mut fills);
    check(
        &mut checks,
        &mut failures,
        fills.pattern == u16::from(USER_FILL) && fills.color == u16::from(CYAN),
        pstr("GetFillSettings after SetFillPattern"),
    );
    set_text_style(SANS_SERIF_FONT, VERT_DIR, 4);
    set_text_justify(CENTER_TEXT, TOP_TEXT);
    get_text_settings(&mut texts);
    check(
        &mut checks,
        &mut failures,
        texts.font == u16::from(SANS_SERIF_FONT) && texts.direction == u16::from(VERT_DIR) && texts.char_size == 4,
        pstr("GetTextSettings: font"),
    );
    check(
        &mut checks,
        &mut failures,
        texts.horiz == u16::from(CENTER_TEXT) && texts.vert == u16::from(TOP_TEXT),
        pstr("and justification"),
    );
    set_view_port(10, 20, 300, 200, CLIP_ON);
    get_view_settings(&mut view);
    check(
        &mut checks,
        &mut failures,
        view.x1 == 10 && view.y1 == 20 && view.x2 == 300 && view.y2 == 200 && view.clip,
        pstr("GetViewSettings"),
    );
    close_graph();
    pwriteln!(checks - failures, " of ", checks, " checks passed");
    if failures > 0 {
