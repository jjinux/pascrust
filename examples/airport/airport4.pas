{t                              Mang Tran and Shannon Behrens
                                Computer Programming
                                3/11/97

Airport

This program simulates a fully automated airport.  Airplanes arrive for
landing and become ready for departure randomely, a relatively constructive
assumption.  These airplanes are immediately added to their respective queues.
When the runway, there is only one, becomes free, the "landing queue" is
given priority and a plane may land.  If the "landing queue" is empty then a
plane from the "leaving queue" is allowed to take off.  This program uses
three user defined units:  Airport1, Airport2, and Airport3.}

Program Airport4;

uses Airport1, Airport2, Airport3, Crt;

const
   maxplanes = 13;               {the most planes a queue will hold,
                                  different from maxsize, cause I changed my
                                  mind}
   TimeToClearRunway = 50;       {Overload:  No new planes until after
                                  Runway Clear is clear}
var
   Arriving, leaving : Queue;   {array of records containing information
                                 about each plane.  The record is constructed
                                 thus record
                                         FlightNum : string(10);
                                         JoinQ     : timeType; 0..1440
                                         LeaveQ    : timeType;
                                 The following methods are available:
                                    Procedure createQ;
                                    Procedure addQ(item : QRec);
                                    Procedure removeQ(var item : QRec);
                                    Function fullQ : boolean;
                                    Function QSize(Q : Queue) : QInteger;
                                        Returns the size of the Queue
                                    Procedure DumpQ(Q : Queue);
                                        Displays contents of the Queue from front to rear
                                    Procedure FrontOfQ(Q : Queue ; var FrontRec : QRec);
                                        Returns first record in queue without changing Queue
                                    Procedure RearOfQ(Q : Queue ; var RearRec : QRec);
                                        Returns the last record in queue WITHOUT changing Queue}
   clock             : timeType; {0..1440 : minute in a day - generated by
                                  Procedure ClockUpdate}
   scrollrate        : timeType; {Amount of seconds loop hesitates}
   LandingTime,
   TakeOffTime       : timeType; {Amount of minutes planes take to takeOff
                                  or land}
   LandingRate,
   TakeOffRate       : real;     {ratio planes takingoff or landing / minute}
                                 {a very small number}
   LastPlaneLand,
   LastPlaneTake     : QRec;     {Last plane to land or takeoff}
   RunwayFree        : timeType; {When will runway be free next?}
   RoomForPlanes     : timeType; {Too many people in line until clock > RFP}
   Quit              : boolean;  {Only way to exit main repeat loop}

Procedure Setup(var arriving,leaving:queue ;  var clock:TimeType ;
                var Landingtime,TakeOffTime:TimeType ;
                var LandingRate,TakeOffRate:real ;
                var RunwayFree:TimeType ; var quit:boolean ;
                var ScrollRate:TimeType ;
                var LastPlaneLand,LastPlaneTake:QRec ;
                var RoomForPlanes:TimeType);
               {Does all initializations, including screen intializations}
   begin
      textbackground(blue);
      textcolor(yellow);
      arriving.createQ;
      leaving.createQ;
      clock:= 7*60;                     {7:00 in the morning}
      LandingTime:= 5;                  {5 minute Landings/TakeOffs}
      TakeOffTime:= 5;
      LandingRate:= (6/60);             {6 planes an hour}
      TakeOffRate:= (6/60);
      RunwayFree:= 0;
      Quit:= false;
      ScrollRate:= 7;
      LastPlaneLand.FlightNum:= 'RunwayFree';
      LastPlaneLand.JoinQ:= 0;
      LastPlaneLand.LeaveQ:= 0;
      LastPlaneTake.FlightNum:= 'RunwayFree';
      LastPlaneTake.JoinQ:= 0;
      LastPlaneTake.LeaveQ:= 0;
      RoomForPlanes:= 0;
   end; {Setup}

Procedure Options(var Landingtime,TakeOffTime:TimeType ;
                  var LandingRate,TakeOffRate:real ;
                  var ScrollRate,clock:TimeType);
                 {Gives user opportunity to change all options listed above}
   var
      choice : char;                    {player's choice during options}
      capacity : integer;               {used during a writely in options}

   procedure changeRate(var Landingtime,TakingOffTime:TimeType ;
                        var LandingRate,TakingOffRate:real);
                       {gives user opportunity to change all options listed}
      Var
        ChosenNum,     { landing Time chosen }
        ChosenTakeOffTime : Real;
        ChosenLandRate,
        ChosenTakeOffRate : Real;
      begin
         repeat
            clrscr;
            gotoXY(7,7);
            writeln('          What would you like for Landing Time: ');
            write('            choose from  1 ------> 15:  ');
            readln(chosenNum);
            if  (ChosenNum < 1) or (ChosenNum > 15) then
               writeln('  It is a bad choice! Try again! ')
         until (ChosenNum >= 1) and (ChosenNum <= 15);
         LandingTime := trunc(ChosenNum);
         writeln;
         repeat
            writeln('          What would you like for Taking off time: ');
            write('            Choose from 1------> 15:  ');
            readln(ChosenTakeOffTime);
            if (ChosenTakeOffTime < 1) or (ChosenTakeOffTime > 15) then
               writeln('  It is a bad choice.  Please Try again!')
         until (ChosenTakeOffTime >= 1) and (ChosenTakeOffTime <= 15);
         TakingOffTime := trunc(ChosenTakeOffTime);
         writeln;
         repeat
            writeln('          What would you like for Landing Rate (planes per hour)?');
            write('            Choose from 0 ------> 15:  ');
            readln(chosenLandRate);
            if (chosenlandrate < 0 ) or ( chosenlandrate > 15) then
               writeln('It is a bad choice!  Please try it again.')
         until (chosenLandRate >= 0) and (chosenLandRate <= 15);
         LandingRate := (ChosenLandRate/60);          {switch to planes per minute}
         writeln;
         repeat
         writeln('          What would you like for Taking Off Rate (planes per hour)?');
         write('            Choose from 0 ------> 15:  ');
         readln(ChosenTakeOffRate);
         if (ChosenTakeOffRate < 0) or ( chosenTakeOffRate > 15) then
            writeln('It is a bad choice!  Please try it again');
         until (chosenTakeOffRate >= 0) and (chosenTakeOffRate <= 15);
         TakingOffRate := (ChosenTakeOffRate/60);
      end; {changerate}

   procedure ChangeScroll(var ScrollRate:TimeType);
      var
         ChosenScrlRate : TimeType;
      begin
         repeat
            clrscr;
            gotoXY(1,7);
            writeln('          How many seconds would you like a minute to represent?');
            writeln('          Chose from 1 ----------> 100:   ');
            write('                (Superman)   (Screen Saver)      ');
            readln(ChosenScrlRate);
            if (chosenScrlRate < 1) or (ChosenScrlRate >100) then
               writeln('          It is a bad choice.  Please try again.');
         until (chosenScrlRate >= 1) and (ChosenScrlRate <= 100);
         ScrollRate := ChosenScrlRate;
         end; {ChangeScroll}

   procedure RushHour(var landingTime,TakingOffTime:TimeType ;
                      var LandingRate,TakingOffRate:real);
                     {Changes settings to represent rush hours}
         var
            a : integer;
         Begin
            clrscr;
            LandingTime:= 5;            {5 minute landings/Takeoffs}
            TakingOffTime:=5;
            LandingRate:=10/60;         {Total of twenty planes an hour}
            TakingOffRate:=10/60;
            gotoxy(40,15);
            for a:= 1 to 3 do           {simulate horns}
               begin
               sound(220);
               write('...Beep! ');
               delay(5000);
               nosound;
               end; {for}
         end; {RushHour}

   Procedure SetupR(var LandingTime,TakeOffTime:TimeType ;
                    var LandingRate,TakeOffRate:Real ;
                    var ScrollRate,clock:TimeType);
      begin        {returns everything to defaults, except clock}
         LandingTime:= 5;              {see setup}
         TakeOffTime:= 5;
         LandingRate:= 6/60;
         TakeOffRate:= 6/60;
         ScrollRate:= 7;
         clrscr;
         gotoxy(40,15);
         writeln('Defaults reset.');
         delay(30000);
         clock:=(7*60);
      end; {setup}

   begin {OPTIONS}
      repeat
         clrscr;
         gotoXY(1,7);
         writeln('          You are free to choose some conditions for the airport!');
         writeln;
         writeln('          1.  Change rates.');
         writeln('          2.  Rush Hour Simulation.');
         writeln('          3.  Simulation Speed.');
         writeln('          4.  Default Settings.');
         writeln('          5.  Exit.');
         gotoxy(1,hi(windmax));
         capacity:= trunc(100*(LandingRate+TakeOffRate)*60*
            (LandingTime+TakeOffTime)/(2*60));
                                {planes per hour * their average time * 100 %}
         writeln(' * Currently Operation at ', capacity,
            '% of average maximum capacity.');
         choice:= upcase(readkey);
         case choice of
            'C', '1':  changeRate(landingTime,TakeOffTime,LandingRate,
                                  TakeOffRate);
            'R', '2':  RushHour(landingTime,TakeOffTime,LandingRate,
                                TakeOffRate);
            'S', '3':  ChangeScroll(ScrollRate);
            'D', '4':  SetupR(landingTime,TakeOffTime,LandingRate,
                              takeOffRate,ScrollRate,clock)
                             {return all to normal except clock}
         end; {case}
      until ( choice = '5' ) or ( choice = 'E' )
   end; {Options}

Procedure Info;
   begin
   clrscr;
   writeln('t');
   writeln;
   writeln('Welcome to Shannon and Mang''s Airport simulation!');
   writeln;
   writeln('This program simulates a fully automated airport.  Airplanes arrive');
   writeln('for landing and become ready for departure randomely, a relatively');
   writeln('constructive assumption.  These airplanes are immediately added to');
   writeln('their respective queues, a waiting list.  When the runway, there is');
   writeln('only one, becomes free, the "landing queue" is given priority and a');
   writeln('plane may land.  If the "landing queue" is empty then aplane from the');
   writeln('"leaving queue" is allowed to take off.');
   writeln;
   writeln('Our Airport simulation allows you to change various aspects of the');
   writeln('simulation including LandingTime and TakeOffTime.  These are a measure');
   writeln('of how long planes take to land or takeoff.  Also available are');
   writeln('LandingRate and TakeOffRate.  By increasing these, one may simulate');
   writeln('rush hour traffic -- that is a great number of planes per hour that');
   writeln('are ready for landing or takeoff.');
   writeln;
   writeln('We hope you enjoy our simulation.');
   repeat until keypressed;
   end; {info}

Procedure Welcome(var Landingtime,TakeOffTime:TimeType ;
                  var LandingRate,TakeOffRate:Real ;
                  var Scrollrate,clock:TimeType);
                 {welcome may lead to settings, in which the above may be
                  changed}
   var
      choice : char;            {player's choice on menu}
   begin
      repeat
         clrscr;
         gotoXY(7,7) ;
         writeln('               WELCOME TO CS22 AIRPORT !!! ');
         writeln;
         writeln('               1.   Operation.       ');
         writeln('               2.   Change Settings.');   {options}
         writeln('               3.   Information.');       {info}
      choice:= readkey;
      case upcase(choice) of
        'C', '2'  : options(Landingtime,TakeOffTime,LandingRate,
                            TakeOffRate,ScrollRate,clock);
        'I', '3'  : info;
      end;  {case}
      until (upcase(choice)='O') or (upcase(choice)='1');
   end; {welcome}

Procedure ClockUpdate(var clock:TimeType);
   begin
     if clock<1440 then
        clock:= succ(clock)
     else
        clock:= 0;                      {Clock Resets at midnight}
     {delay takes place in showscreen}
   end; {ClockUpdate}

Procedure NewPlanes(var arriving,leaving:queue ; clock:TimeType ;
                    var RoomForPlanes:TimeType);
                   {New planes added to Q's.  Planes arrive randomly}
   var
      item   : QRec;
   Procedure GetNewPlane(var Item:QRec);
                        {Make New Plane to be added to a Queue}
      var
         a,b : integer;
      begin
         Item.JoinQ:= clock;            {time plane gets into Queue}
         Item.LeaveQ:= clock;           {just initializing, not important}
         a:= Random(10);                {Get first part of flightNum}
         Case a of                      {7 character name}
            0   :  item.flightNum:='SWestrn';
            1   :  item.flightNum:='Luftnsa';
            2   :  item.flightNum:='UnAirLn';
            3   :  item.flightNum:='Alaskan';
            4   :  item.flightNum:='Americn';
            5   :  item.flightNum:='PhiliAr';
            6   :  item.flightNum:='KoreaAr';
            7   :  item.flightNum:='Indiana';
            8   :  item.flightNum:='JJ''sAir';
            9   :  item.flightNum:='MangInt';
         end; {case}
         for b:= 0 to 3 do              {3 character number assignment}
            item.flightNum:= item.flightNum + chr(ord('0')+random(9))
      end; {GetNewPlane}
   begin {NewPlane}
      if (random<=LandingRate) and (Qsize(Arriving)<maxplanes) then
         begin
            RoomForPlanes:= 0;          {Reset it, in case it is tripped}
            GetNewPlane(item);          {Add new plane to arriving queue}
            Arriving.AddQ(item);
         end {if}
      else if Qsize(Arriving)=maxplanes then
         begin
            clrscr; gotoxy(5,7);
            writeln('Airport overload:  Incoming Planes Rerouted');
            RoomForPlanes:= clock + TimeType(TimeToClearRunway);
            repeat until keypressed;
         end; {else}
      if (random<=TakeOffRate) and (Qsize(Leaving)<maxplanes) then
         begin
            GetNewPlane(item);          {Add new plane to take off queue}
            Leaving.AddQ(item);
         end {if}
      else if Qsize(Leaving)=maxplanes then
         begin
            clrscr; gotoxy(5,7);
            writeln('Airport overloaded:  All Leaving Planes Delayed');
            RoomForPlanes:= clock + TimeType(TimeToClearRunway);
            repeat until keypressed;
         end; {else}
   end; {NewPlanes}

Procedure Runway(var arriving,leaving:queue ; clock:timeType ;
                 var RunwayFree:timeType ; LandingTime,TakeOffTime:timetype ;
                 var LastPlaneLand,LastPlaneTake:QRec);
   begin
      if clock<RunwayFree then
         write('')                            {i.e. do nothing:  runway busy}
      else
         if (Qsize(arriving)=0) and (Qsize(leaving)<>0) then
            begin                             {takeoff}
               leaving.RemoveQ(LastPlaneTake);
               RunwayFree:= (clock + TakeOffTime) mod 1440;
               LastPlaneTake.LeaveQ:= RunwayFree; {when did plane get into air?}
            end {takeoff}
         else if Qsize(arriving)>0 then
            begin                             {landing}
               arriving.RemoveQ(LastPlaneLand);
               RunwayFree:= (clock + LandingTime) mod 1440;
               LastPlaneLand.LeaveQ:= clock;      {when did plane actually land?}
            end {landing};
         {Please be aware that RunwayFree is a victim of the year 2000
          syndrome.  Consequently, during the time immediately before
          midnight (clock=1440) everyone will be able to land or takeoff
          without the restriction of RunwayFree - a minor gliche}
   end; {Runway}

Procedure Showscreen(arriving,leaving:queue ; clock:TimeType ; LastPlaneTake,
                     LastPlaneLand:QRec ; scrollrate:TimeType);
                    {shows a listing of the queues as well as the last planes
                     to land and take off as if it were an airport terminal
                     The delay occurs in this procedure}

   Procedure Showtime(clock:TimeType);
      begin          {shows a time in military style}
         write(clock div 60, ':');
         if (clock mod 60)<10 then       {just making it look good}
            write('0', clock mod 60)
         else write(clock mod 60);
      end; {Showtime}

   Procedure ShowQ(Q:Queue ; LastPlane:QRec ; currx:integer);
                  {LastPlane used to compute predicted arrival/takeoff times}
      var         {shows full contents of a Q, but in an aesthetic manner}
         item : QRec;                    {storage place for QRec popped}
         a    : integer;
      begin
         gotoxy(1,5);
         While Qsize(Q) > 0 do           {write details of one flight}
            begin
            Q.RemoveQ(item);
            gotoxy(currx,wherey+1);
            write('  ');
            for a:= 1 to 7 do
               write(item.flightnum[a]);
            write('  ');                {insert space between name and num}
            for a:= 8 to 10 do
               write(item.flightnum[a]);
            write('  ');
            showtime(item.joinQ);
            write('  ');
            showtime(item.joinQ + (LastPlane.leaveQ-LastPlane.joinQ));
                           {prediction as to when flight will be able to land}
                           {--> joinQ + last plane's wait}
            end; {for loop}
      end; {ShowQ}

   procedure ShowOnePlane(Plane:QRec);
      var
          a : integer;
      begin
         write('  ');
         if Plane.FlightNum <> 'RunwayFree' then
            begin
            for a:= 1 to 7 do
               write(Plane.FlightNum[a]);
            write('  ');
            for a:= 8 to 10 do
               write(Plane.FlightNum[a]);
            write('  ');
            end
         else write('Runway Free ');
         showtime(Plane.joinQ);
         write('  ');
         showtime(Plane.leaveQ);
      end; {showOnePlane}

   procedure ShowLastPlanes(LastPlaneTake,LastPlaneLand:QRec);
      begin
         gotoxy(1, hi(windmax)-3);
         writeln('* LAST PLANE TO TAKEOFF                * LAST PLANE TO LAND');
         write(' ');
         ShowOnePlane(LastPlaneTake);
         gotoxy(41,wherey);
         ShowOnePlane(LastPlaneLand);
      end; {ShowLastPlanes}

   procedure ShowBottomLine(clock:TimeType);
      begin
         gotoxy(1,hi(windmax));                      {bottom right corner}
         write('* (Airline  Flight#  Ready  Expected Arrival/Departure)');
         write('    ');
         write('Current Time:  ');
         textbackground(red);
         textcolor(white);
         showtime(clock);
         textbackground(blue);
         textcolor(yellow);
         writeln;
         write('*  Press ''P'' to Pause');
      end; {ShowBottomLine}

   begin {Showscreen}
      clrscr;
      writeln;
      writeln('             WELCOME TO SHANNON AND MANG''S INTERNATIONAL AIRPORT');
      write(chr(10),'* WAITING FOR DEPARTURE');
         ShowQ(leaving, LastPlaneTake,1);         {the 1 and 40 represent x values}
      gotoxy(40,4);                               {used to make columns}
      write('* PREPARING FOR LANDING');
         ShowQ(arriving, LastPlaneLand,40);
      writeln;
      ShowLastPlanes(LastPlaneTake,LastPlaneLand);
      ShowBottomLine(clock);
      delay(scrollrate*1000);                     {1/7 seconds times scrollrate}
   end; {Showscreen}

procedure Pause(var arriving,leaving:queue ; var clock:TimeType ;
                var Landingtime,TakeOffTime:TimeType ;
                var LandingRate,TakeOffRate:real;
                var RunwayFree:TimeType ; var quit:boolean ;
                var ScrollRate:TimeType ;
                var LastPlaneLand,LastPlaneTake:QRec);
 {This procedure keeps cooperating the operations of the option menu, going
  to the main airport operation, changing the clock or leading to the exit
  of the....airport}
   var
      opt: char;

   begin
      repeat
         clrscr;
         gotoXY(1,7);
         writeln('               This is the PAUSE MENU:');
         writeln('             Please choose the following:');
         writeln;
         writeln('                 1. Return to Simulation.');
         writeln('                 2. Change Settings');
         writeln('                 3. Start Over.');
         writeln('                 4. Quit.');
         opt:= upcase(readkey);
         case opt of
            '2', 'C':  options(Landingtime,TakeOffTime,LandingRate,
                               TakeOffRate,ScrollRate,clock);
            '3', 'S':  begin
                          {Start Over, basically}
                          setup(Arriving,leaving,clock,LandingTime,
                             TakeOffTime,landingRate,TakeOffRate,
                             runwayFree,quit,scrollRate,LastPlaneland,
                             LastPlanetake,RoomForPlanes);
                          Welcome(Landingtime,TakeOffTime,LandingRate,
                                  TakeOffRate,Scrollrate,clock);
                       end; {'3', 'S'}
            '4', 'Q':  Quit:=true;
         end; {case}
      until (opt='1') or (opt='R') or (quit) or
            (opt='3') or (opt='S');           { going to quit }
   end; {pause}

procedure Goodbye;
   begin
      clrscr;
      gotoxy(1,10);
      writeln('                   Thank you for flying with us...');
      writeln(chr(10),'                                    Goodbye.');
      delay(10000);
   end; {Goodbye}

begin {mainframe}
   Randomize;
   Setup(arriving, leaving, clock, Landingtime, TakeOffTime,
         LandingRate, TakeOffRate, RunwayFree, Quit, Scrollrate,
         LastPlaneLand, LastPlaneTake,
         RoomForPlanes);                            {initializations}
   Welcome(Landingtime,TakeOffTime,LandingRate
           ,TakeOffRate,Scrollrate,clock);          {may lead to info or options}
   repeat {pause loop}
      repeat {main loop}
        ClockUpdate(clock);
        if RoomForPlanes<clock then                 {no planes until free}
           Newplanes(arriving,leaving,clock,
                     RoomForPlanes);                {new planes added to Q's}
        Runway(arriving,leaving,clock,RunwayFree,   {Handles and prioritizes}
               LandingTime,TakeOffTime,             {takeoffs and landings}
               LastPlaneLand,LastPlaneTake);        
        Showscreen(arriving,leaving,clock,          {simulates an airport }
                   LastPlaneTake,LastPlaneLand,     {terminal screen, showes}
                   ScrollRate);                     {queue, delay occurs here}
      until keypressed; {main loop}
      if upcase(readkey) = 'P' then Pause(          {may lead to options}
        arriving,leaving,clock,Landingtime,TakeOffTime,
        LandingRate,TakeOffRate,RunwayFree,quit,ScrollRate,
        LastPlaneLand,LastPlaneTake);
   until Quit; {pause loop}
   Goodbye;
end. {mainframe}

